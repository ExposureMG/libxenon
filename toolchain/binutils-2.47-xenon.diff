+++ binutils/opcodes/ppc-xenon-insert.inc
@@ -0,0 +1,213 @@
+/* Generated by tools/gen_xenon_opc.py from isa/findings_instructions.csv
+   and isa/xenon_isa.json.  Do not edit by hand; rerun the generator.  */
+
+/* Operand insert/extract functions for the Xenon VMX128 operands.
+   Included by ppc-opc.c before powerpc_operands[].  */
+
+/* VD128: VMX128 VR destination/source (vr0-127): VD128l | VD128h<<5.
+   Parts (shift_from_lsb, width, dest_shift): (21, 5, 0), (2, 2, 5).  */
+
+static uint64_t
+insert_vd128 (uint64_t insn,
+		int64_t value,
+		ppc_cpu_t dialect ATTRIBUTE_UNUSED,
+		const char **errmsg ATTRIBUTE_UNUSED)
+{
+  return insn | ((((uint64_t) value >> 0) & 0x1f) << 21)
+	      | ((((uint64_t) value >> 5) & 0x3) << 2);
+}
+
+static int64_t
+extract_vd128 (uint64_t insn,
+		 ppc_cpu_t dialect ATTRIBUTE_UNUSED,
+		 int *invalid ATTRIBUTE_UNUSED)
+{
+  return (((insn >> 21) & 0x1f) << 0)
+	 | (((insn >> 2) & 0x3) << 5);
+}
+
+/* VA128: VMX128 VR a (vr0-127): VA128l | a<<5 | A<<6.
+   Parts (shift_from_lsb, width, dest_shift): (16, 5, 0), (5, 1, 5), (10, 1, 6).  */
+
+static uint64_t
+insert_va128 (uint64_t insn,
+		int64_t value,
+		ppc_cpu_t dialect ATTRIBUTE_UNUSED,
+		const char **errmsg ATTRIBUTE_UNUSED)
+{
+  return insn | ((((uint64_t) value >> 0) & 0x1f) << 16)
+	      | ((((uint64_t) value >> 5) & 0x1) << 5)
+	      | ((((uint64_t) value >> 6) & 0x1) << 10);
+}
+
+static int64_t
+extract_va128 (uint64_t insn,
+		 ppc_cpu_t dialect ATTRIBUTE_UNUSED,
+		 int *invalid ATTRIBUTE_UNUSED)
+{
+  return (((insn >> 16) & 0x1f) << 0)
+	 | (((insn >> 5) & 0x1) << 5)
+	 | (((insn >> 10) & 0x1) << 6);
+}
+
+/* VB128: VMX128 VR b (vr0-127): VB128l | VBh<<5.
+   Parts (shift_from_lsb, width, dest_shift): (11, 5, 0), (0, 2, 5).  */
+
+static uint64_t
+insert_vb128 (uint64_t insn,
+		int64_t value,
+		ppc_cpu_t dialect ATTRIBUTE_UNUSED,
+		const char **errmsg ATTRIBUTE_UNUSED)
+{
+  return insn | ((((uint64_t) value >> 0) & 0x1f) << 11)
+	      | ((((uint64_t) value >> 5) & 0x3) << 0);
+}
+
+static int64_t
+extract_vb128 (uint64_t insn,
+		 ppc_cpu_t dialect ATTRIBUTE_UNUSED,
+		 int *invalid ATTRIBUTE_UNUSED)
+{
+  return (((insn >> 11) & 0x1f) << 0)
+	 | (((insn >> 0) & 0x3) << 5);
+}
+
+/* VC128: VMX128 VR c (vr0-7 only).
+   Parts (shift_from_lsb, width, dest_shift): (6, 3, 0).  */
+
+static uint64_t
+insert_vc128 (uint64_t insn,
+		int64_t value,
+		ppc_cpu_t dialect ATTRIBUTE_UNUSED,
+		const char **errmsg ATTRIBUTE_UNUSED)
+{
+  if (value < 0 || value > 7)
+    *errmsg = _("the vperm128 control operand must be one of v0-v7");
+  return insn | ((((uint64_t) value >> 0) & 0x7) << 6);
+}
+
+static int64_t
+extract_vc128 (uint64_t insn,
+		 ppc_cpu_t dialect ATTRIBUTE_UNUSED,
+		 int *invalid ATTRIBUTE_UNUSED)
+{
+  return (((insn >> 6) & 0x7) << 0);
+}
+
+/* VS128T: the tied third source of vmaddfp128, vmaddcfp128, vnmsubfp128 and
+   vsel128 (JSON tied_operands = [VD128]).  The instruction has no separate
+   field: the operand is written in the source for readability and must
+   name the same register as vD.  VD128 is always the first operand, so it
+   is already in INSN here.  */
+
+static uint64_t
+insert_vs128t (uint64_t insn,
+	       int64_t value,
+	       ppc_cpu_t dialect,
+	       const char **errmsg)
+{
+  if (value != extract_vd128 (insn, dialect, NULL))
+    *errmsg = _("vS must be the same register as vD: this instruction "
+		"uses its destination as the third source");
+  return insn;
+}
+
+static int64_t
+extract_vs128t (uint64_t insn,
+		ppc_cpu_t dialect,
+		int *invalid ATTRIBUTE_UNUSED)
+{
+  return extract_vd128 (insn, dialect, NULL);
+}
+
+/* VPERM128: VMX128 vpermwi 8-bit permute: PERMl | PERMh<<5.
+   Parts (shift_from_lsb, width, dest_shift): (16, 5, 0), (6, 3, 5).  */
+
+static uint64_t
+insert_vperm128 (uint64_t insn,
+		int64_t value,
+		ppc_cpu_t dialect ATTRIBUTE_UNUSED,
+		const char **errmsg ATTRIBUTE_UNUSED)
+{
+  return insn | ((((uint64_t) value >> 0) & 0x1f) << 16)
+	      | ((((uint64_t) value >> 5) & 0x7) << 6);
+}
+
+static int64_t
+extract_vperm128 (uint64_t insn,
+		 ppc_cpu_t dialect ATTRIBUTE_UNUSED,
+		 int *invalid ATTRIBUTE_UNUSED)
+{
+  return (((insn >> 16) & 0x1f) << 0)
+	 | (((insn >> 6) & 0x7) << 5);
+}
+
+/* VD3D0: vpkd3d128 D3D data type: 0 D3DCOLOR, 1 NORMSHORT2, 2 NORMPACKED32 (2_10_10_10), 3 FLOAT16_2, 4 NORMSHORT4, 5 FLOAT16_4, 6 NORMPACKED64 (4_20_20_20). Meaning from xenia's emitter; every value seen in real code is in 0-5.
+   Parts (shift_from_lsb, width, dest_shift): (18, 3, 0).  */
+
+static uint64_t
+insert_vd3d0 (uint64_t insn,
+		int64_t value,
+		ppc_cpu_t dialect ATTRIBUTE_UNUSED,
+		const char **errmsg ATTRIBUTE_UNUSED)
+{
+  return insn | ((((uint64_t) value >> 0) & 0x7) << 18);
+}
+
+static int64_t
+extract_vd3d0 (uint64_t insn,
+		 ppc_cpu_t dialect ATTRIBUTE_UNUSED,
+		 int *invalid ATTRIBUTE_UNUSED)
+{
+  return (((insn >> 18) & 0x7) << 0);
+}
+
+/* VD3D1: vpkd3d128 pack size: 1 = 32-bit result, 2/3 = 64-bit result (xenia). With VD3D0 it forms the 5-bit immediate (VD3D0<<2 | VD3D1).
+   Parts (shift_from_lsb, width, dest_shift): (16, 2, 0).  */
+
+static uint64_t
+insert_vd3d1 (uint64_t insn,
+		int64_t value,
+		ppc_cpu_t dialect ATTRIBUTE_UNUSED,
+		const char **errmsg ATTRIBUTE_UNUSED)
+{
+  return insn | ((((uint64_t) value >> 0) & 0x3) << 16);
+}
+
+static int64_t
+extract_vd3d1 (uint64_t insn,
+		 ppc_cpu_t dialect ATTRIBUTE_UNUSED,
+		 int *invalid ATTRIBUTE_UNUSED)
+{
+  return (((insn >> 16) & 0x3) << 0);
+}
+
+/* VD3D2: vpkd3d128: which word slot of VD receives the packed result (xenia: "shift"); vrlimi128: rotate-left amount in words, 0-3.
+   Parts (shift_from_lsb, width, dest_shift): (6, 2, 0).  */
+
+static uint64_t
+insert_vd3d2 (uint64_t insn,
+		int64_t value,
+		ppc_cpu_t dialect ATTRIBUTE_UNUSED,
+		const char **errmsg ATTRIBUTE_UNUSED)
+{
+  return insn | ((((uint64_t) value >> 0) & 0x3) << 6);
+}
+
+static int64_t
+extract_vd3d2 (uint64_t insn,
+		 ppc_cpu_t dialect ATTRIBUTE_UNUSED,
+		 int *invalid ATTRIBUTE_UNUSED)
+{
+  return (((insn >> 6) & 0x3) << 0);
+}
+
+/* Xenon rows in major opcode 31, placed by hand in powerpc_opcodes[]
+   in front of the rows that share their encoding (dcbtt/dcbt, dcbzl)
+   so that the disassembler prefers the Xenon name.  */
+
+#define XENON_OPCODE_DCBZ128 \
+  {"dcbz128", 0x7c2007ec, 0xffe007ff, PPCXENON, 0, {RA0, RB}}
+
+#define XENON_OPCODE_XDCBT \
+  {"xdcbt", 0x7e00022c, 0xffe007ff, PPCXENON, 0, {RA0, RB}}
