+  if (insn > 0xffffffff)
+    return NULL;
+  for (i = 0; i < ppc_xenon_num_illegal; i++)
+    if ((insn & ppc_xenon_illegal[i].mask) == ppc_xenon_illegal[i].match)
+      return &ppc_xenon_illegal[i];
+  return NULL;
+}
