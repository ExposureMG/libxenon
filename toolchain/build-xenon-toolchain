freetype_install()
{
    check_priv "$@"

    if [ ! -f "$FREETYPE.tar.gz" ]; then
        echo -e "Downloading $FREETYPE..."
        wget -c $FREETYPE_DL || fail_with_info
    fi

    echo -e "Extracting $FREETYPE..."
    rm -rf $FREETYPE
    tar xzf $FREETYPE.tar.gz >> $LOGFILE 2>&1 || fail_with_info
    cd $FREETYPE

    export CC=$TARGET-gcc
    export CFLAGS="$LIB_CFLAGS $DEVKITXENON/usr/lib/libxenon.a -L$DEVKITXENON/xenon/lib/32/ -T$DEVKITXENON/app.lds -u read -u _start -u exc_base -L$DEVKITXENON/usr/lib -I$DEVKITXENON/usr/include"
    export LDFLAGS="${CFLAGS//-T$DEVKITXENON\/app.lds/}"

    echo -e "Configuring $FREETYPE..."
    PKG_CONFIG_LIBDIR=$DEVKITXENON/usr/lib/pkgconfig PKG_CONFIG_PATH= ./configure --prefix=$DEVKITXENON/usr --host=ppc-elf --disable-shared --without-brotli --without-harfbuzz >> $LOGFILE 2>&1 || fail_with_info

    echo -e "Building $FREETYPE..."
    make $PARALLEL CROSS_COMPILE=$TARGET- LDFLAGS="${LDFLAGS//$DEVKITXENON\/usr\/lib\/libxenon.a/}" >> $LOGFILE 2>&1 || fail_with_info
    echo -e "Installing $FREETYPE..."
    make CROSS_COMPILE=$TARGET- LDFLAGS="${LDFLAGS//$DEVKITXENON\/usr\/lib\/libxenon.a/}" install >> $LOGFILE 2>&1 || fail_with_info
    cd ..
    rm -rf $FREETYPE

    export CC=""
    export CFLAGS=""
    export LDFLAGS=""

    echo -e "Done"
}

filesystems_install()
{
    check_priv "$@"
    echo -e "Building Filesystems..."

    filesystems="libfat libext2fs libxtaf" # ntfs-xenon ext2fs-xenon xtaflib

    for i in $filesystems
    do
        echo -e -n "$i: "
        if [ ! -d $i ]; then
            echo -e -n "Cloning... "
            git clone https://github.com/Free60Project/$i.git  >> $LOGFILE 2>&1 || fail_with_info
            if [ "" != "$FSBRANCH" ]; then
                cd $i
                git checkout $FSBRANCH >> $LOGFILE 2>&1
                cd ..
            fi
        else
            cd $i
            if [ "" != "$FSBRANCH" ]; then
                git checkout $FSBRANCH >> $LOGFILE 2>&1
            fi
            git remote update >> $LOGFILE 2>&1
            git status -uno | grep -q behind
            if [ 0 -eq $? ]; then
                echo -e -n "Updating... "
                git pull >> $LOGFILE 2>&1
                make clean >> $LOGFILE 2>&1
            fi
            cd ..
        fi
        echo -e -n "Building... "
        make -C $i "${FS_MAKE[@]}" >> $LOGFILE 2>&1 || fail_with_info
        echo -e -n "Installing... "
        make -C $i install >> $LOGFILE 2>&1 || fail_with_info
        echo -e "Done"
    done
}

bin2s_install()
{
    pushd ../libxenon/ports/xenon/
    echo -e "Building bin2s..."
    gcc bin2s.c -o bin2s || fail_with_info
    echo -e "Installing bin2s..."
    mv bin2s $DEVKITXENON/bin
    chmod a+x $DEVKITXENON/bin/bin2s
    echo -e "Done"
    popd
}

cube()
{
    rm -rf free60 &>/dev/null
    rm cube.elf32 &>/dev/null

    #check if git is present to download and install libxenon
    git &>/dev/null
    RETVAL=$?

    if [ $RETVAL -eq 1 ]; then
        echo -e "Building Cube Sample..."
        make -C ../devkitxenon/examples/xenon/graphics/cube "${FS_MAKE[@]}" >> $LOGFILE 2>&1
        cp ../devkitxenon/examples/xenon/graphics/cube/cube.elf32 .
        echo
        echo -e "cube.elf32 compiled, run it via xell"
        echo

    else
        echo
        echo -e "git is needed to download libxenon, install it and run this script again with \"libxenon\" as argument"
        echo -e "If you are running debian/ubuntu : apt install git"
        echo
    fi
    exit 0
}

all_done()
{
    RED='\e[0;31m'
    NC='\e[0m'

    echo
    echo -e "All done, your xenon toolchain is located here : \"$PREFIX"\"
    if [ -x "$PREFIX/bin/$MUSL_TARGET-gcc" ]; then
        echo -e "The Linux (musl) toolchain is $MUSL_TARGET-gcc, its sysroot is \"$MUSL_SYSROOT\""
    fi
    echo
    echo -e "${RED}Please add the following path to your login script (~/.bashrc) if you'd like every shell to have access by default:"
    echo
    echo -e "export DEVKITXENON=\"$PREFIX"\"
    echo     -e 'export PATH="${PATH:+${PATH}:}"$DEVKITXENON"/bin:"$DEVKITXENON"/usr/bin"'
    echo 
    echo -e "Alternatively, run "$0" env-cmd to install a command named xenon-env to /usr/local/bin/xenon-env to set those in the current shell for you"
    echo -e "${NC}"
}

# start
rm -f $LOGFILE

# After the subcommand: an optional version and an optional variant, in any
# order, e.g. "all 16.2.0 xenon", "toolchain 6.3.0 vmx128" or "libs xenon".
VERSION=""
[ "$1" == "musl" ] && VARIANT="xenon"
for arg in "${@:2}"; do
    case "$arg" in
        xenon | vmx128)
            VARIANT=$arg
            ;;
        [0-9]*-xenon | [0-9]*-vmx128) # old "16.2.0-xenon" spelling
            VERSION=${arg%-*}
            VARIANT=${arg##*-}
            ;;
        [0-9]*)
            VERSION=$arg
            ;;
        *)
            echo -e "Unknown argument \"$arg\", run $0 without arguments for usage."
            exit 1
            ;;
    esac
done

# available [version] packs
case "$VERSION" in
    16.2.0 | "") # default
        BINU_VER="2.47"
        GCC_VER="16.2.0"
        NEWL_VER="4.6.0.20260123"
        ;;
    9.2.0)
        BINU_VER="2.32"
        GCC_VER="9.2.0"
        NEWL_VER="3.1.0"
        ;;
    6.3.0)
        BINU_VER="2.28"
        GCC_VER="6.3.0"
        GCC_EXTRA_CFG="--without-isl" # gcc 6 graphite is incompatible with modern isl
        export CXXFLAGS="-O2 -g -std=gnu++14 -fpermissive" # gcc 6 sources vs modern host g++
        NEWL_VER="2.5.0"
        ;;
    #4.7.1) Disabled as libxenon does not build
    #    BINU_VER="2.22"
    #    GCC_VER="4.7.1"
    #    export CFLAGS="-O0 -g0 -std=gnu99 -fno-strict-aliasing -fno-delete-null-pointer-checks -fcommon -fgnu89-inline"
    #    export CFLAGS_FOR_BUILD="-O0 -g0 -std=gnu99 -fno-strict-aliasing -fno-delete-null-pointer-checks -fcommon -fgnu89-inline" # gcc 4.7 vs C23-default host gcc
    #    NEWL_VER="1.20.0"
    #    ;;
    *)
        echo -e "Unknown version \"$VERSION\", run $0 without arguments for usage."
        exit 1
        ;;
esac

# variants: patch sets on top of a version
case "$VARIANT" in
    xenon)
        # the powerpc64-xenon-elf target: -mcpu=xenon (VMX128) by default,
        # -m64 with an -m32 multilib, plus the powerpc64-xenon-linux-musl toolchain
        GCC_CPU="xenon"
        NEWLIB_EXTRA_CFG=(CFLAGS_FOR_TARGET="-O2 -g -mcpu=xenon" --disable-newlib-supplied-syscalls --enable-newlib-io-c99-formats)
        GCC_EXTRA_CFG="--with-sysroot=$PREFIX/xenon --with-native-system-header-dir=/include --disable-tls --disable-libstdcxx-pch --enable-lto"
        PATCHES="binutils-$BINU_VER-xenon.diff gcc-$GCC_VER-xenon.diff newlib-$NEWL_VER-xenon.diff"
        ;;
    vmx128)
        PATCHES="binutils-$BINU_VER-vmx128.diff gcc-$GCC_VER-vmx128.diff"
        ;;
esac

if [ "$1" == "all" ] || [ "$1" == "toolchain" ] || [ "$1" == "musl" ]; then
    for p in $PATCHES; do
        if [ ! -f "$p" ]; then
            echo -e "The $VARIANT variant is not available for ${VERSION:-16.2.0}: $p is missing."
            exit 1
        fi
    done
fi

case "$1" in
    libs | libxenon | zlib | libpng | bzip2 | freetype | filesystems | bin2s | cube)
        if [ "$VARIANT" == "xenon" ]; then
            if ! "$PREFIX/bin/$TARGET-gcc" -mcpu=xenon -E -x c /dev/null > /dev/null 2>&1; then
                echo -e "$PREFIX/bin/$TARGET-gcc does not support -mcpu=xenon, build it first with: $0 toolchain 16.2.0 xenon"
                exit 1
            fi
        elif [ -x "$PREFIX/bin/$TARGET-gcc" ]; then
            # target the CPU the installed compiler was configured for
            # (--with-cpu), so libxenon and the ports match the toolchain
            GCC_CPU=$("$PREFIX/bin/$TARGET-gcc" -v 2>&1 | grep -o -- '--with-cpu=[^ ]*' | cut -d= -f2)
            GCC_CPU=${GCC_CPU:-cell}
        fi
        ;;
esac

# flags for libxenon-linked code (-m32, the libxenon ABI)
LIB_CFLAGS="-mcpu=$GCC_CPU -mtune=$GCC_CPU -m32 -fno-pic -mpowerpc64 -O2"
BZIP2_MAKE=()
FS_MAKE=()
if [ "$GCC_CPU" == "xenon" ]; then
    # -mcpu=xenon brings AltiVec and the VMX128 registers; the makefiles of
    # bzip2, the filesystems and the samples take their CPU flags from MACHDEP
    LIB_CFLAGS="$LIB_CFLAGS -ffunction-sections -fdata-sections"
    BZIP2_MAKE=(MACHDEP="-DXENON -m32 -mno-altivec -fno-pic -mpowerpc64 -mhard-float -mcpu=xenon -mtune=xenon")
    FS_MAKE=(MACHDEP="-DXENON -m32 -maltivec -fno-pic -mpowerpc64 -mhard-float -mcpu=xenon -mtune=xenon -L$DEVKITXENON/xenon/lib/32")
fi

if [ "$1" == "all" ] || [ "$1" == "toolchain" ]; then
    if [ "$FREE60_DOCKER_BUILD" = "true" ]; then
        echo "Info: running in Docker, not installing dependencies."
    # Debian / Ubuntu etc
    elif command -v apt &> /dev/null; then
        echo "Info: apt has been detected. Root privileges are required to install dependencies."
        pkgs="build-essential flex bison libgmp-dev libmpfr-dev libmpc-dev texinfo git wget rsync xz-utils"
        if [ "$(uname -m)" = "x86_64" ]; then
            pkgs="$pkgs gcc-multilib"
        fi
        sudo apt install -y $pkgs || {
            echo "Failed to install required packages!"
            exit 1
        }
    # Fedora
    elif command -v dnf &> /dev/null; then
        echo "Info: dnf has been detected. Root privileges are required to install dependencies."
        sudo dnf -y install gcc g++ flex bison glibc-devel.i686 libstdc++-devel.i686 gmp-devel mpfr-devel libmpc-devel texinfo git wget rsync xz || {
            echo "Failed to install required packages!"
            exit 1
        }
    # Arch
    elif command -v pacman &> /dev/null; then
        # Forbid cygwin and allow arch
        case  "$(uname -s)" in
            CYGWIN*)
                echo "Info: a package manager was not detected. Ensure that the required dependencies have been installed."
                ;;
            Linux*)
                echo "Info: pacman has been detected. Please ensure multilib is enabled. Root privileges are required to install dependencies."
                # Would it work fine on arm?
                if [ "$(uname -m)" != "x86_64" ]; then
                    echo "Info: a package manager was not detected. Ensure that the required dependencies have been installed."
                fi
                sudo pacman -S --needed --noconfirm gcc gcc-multilib flex bison lib32-glibc gmp mpfr libmpc texinfo git wget rsync xz || {
                    echo "Failed to install required packages!"
                    exit 1
                }
                ;;
            *)
                echo "Info: a package manager was not detected. Ensure that the required dependencies have been installed."
                ;;
        esac
    else
        echo "Info: a package manager was not detected. Ensure that the required dependencies have been installed."
    fi

    toolchain_install "$0" "$@"

    if [ "$1" == "all" ]; then
        libxenon_install "$0" "$@"
        zlib_install "$0" "$@"
        bzip2_install "$0" "$@"
        libpng_install "$0" "$@"
        freetype_install "$0" "$@"
        bin2s_install "$0" "$@"
        filesystems_install "$0" "$@"
    fi

    if [ "$VARIANT" == "xenon" ] && $BUILD_MUSL; then
        musl_toolchain_install "$0" "$@"
    fi

    all_done
elif [ "$1" == "libs" ]; then
    # libxenon provides app.lds and libxenon.a, needed to link-test the libs below
    libxenon_install "$0" "$@"
    zlib_install "$0" "$@"
    bzip2_install "$0" "$@"
    libpng_install "$0" "$@"
    freetype_install "$0" "$@"
    bin2s_install "$0" "$@"
    filesystems_install "$0" "$@"
elif [ "$1" == "musl" ]; then
    musl_toolchain_install "$0" "$@"
    all_done
elif [ "$1" == "libxenon" ]; then
    libxenon_install "$0" "$@"
elif [ "$1" == "zlib" ]; then
    zlib_install "$0" "$@"
elif [ "$1" == "libpng" ]; then
    libpng_install "$0" "$@"
elif [ "$1" == "bzip2" ]; then
    bzip2_install "$0" "$@"
elif [ "$1" == "freetype" ]; then
    freetype_install "$0" "$@"
elif [ "$1" == "filesystems" ]; then
    filesystems_install "$0" "$@"
elif [ "$1" == "bin2s" ]; then
    bin2s_install "$0" "$@"
elif [ "$1" == "cube" ]; then
    cube
elif [ "$1" == "clean" ]; then
    check_priv "$0" "$@"
    rm -rf gcc-*.tar.gz gcc-!(*.diff|*.patch)
    rm -rf binutils-*.tar.gz binutils-!(*.diff|*.patch)
    rm -rf newlib-*.tar.gz newlib-!(*.diff|*.patch)
    rm -rf $ZLIB $ZLIB.tar.gz
    rm -rf $LIBPNG $LIBPNG.tar.xz
    rm -rf $BZIP2 $BZIP2.tar.gz
    rm -rf $FREETYPE $FREETYPE.tar.gz
    rm -rf musl-*.tar.gz linux-*.tar.xz $MUSL $LINUX
    rm -rf build build-gcc build-newlib build-musl-binutils build-musl-gcc
    rm -rf libext2fs
    rm -rf libfat
    rm -rf libxtaf
    rm -f cube_normal.elf
    make -C ../devkitxenon/examples/xenon/graphics/cube clean
elif [ "$1" == "env-cmd" ]; then
    check_priv "$0" "$@"
    echo -e '#!/bin/bash\n'export DEVKITXENON=\""$DEVKITXENON"\"'\nexport PATH="${PATH:+${PATH}:}"$DEVKITXENON"/bin:"$DEVKITXENON"/usr/bin"\necho $PATH\nbash\n' > /usr/local/bin/xenon-env
    chmod 755 /usr/local/bin/xenon-env
    echo "Run the xenon-env command to add libxenon to your curent shell PATH."
else
    echo -e "Usage:"
    echo -e "$0 <subcommand> [version] [variant]"
    echo
    echo -e "Subcommands:"
    echo -e "\"all\"       [version] [variant] - (toolchain, libs, and filesystems)"
    echo -e "\"toolchain\" [version] [variant] - (install toolchain)"
    echo -e "\"musl\"      [version]           - (install the $MUSL_TARGET toolchain)"
    echo -e "\"libs\"                [variant] - (install libxenon + bin2s + libraries seen below)"
    echo -e "\"libxenon\"            [variant] - (install or update libxenon)"
    echo -e "\"zlib\"                [variant] - (install or update zlib)"
    echo -e "\"libpng\"              [variant] - (install or update libpng)"
    echo -e "\"bzip2\"               [variant] - (install or update bzip2)"
    echo -e "\"freetype\"            [variant] - (install or update freetype)"
    echo -e "\"filesystems\"         [variant] - (install libxenon filesystems)"
    echo -e "\"cube\"                [variant] - (compile the cube sample)"
    echo -e "\"env-cmd\"             - (install a command to set env vars named xenon-env to /usr/local/bin)"
    echo -e "\"clean\"               - (delete all downloaded files)"
    echo
    echo -e "Versions:"
    echo -e "16.2.0 (Default)"
    echo -e "9.2.0"
    echo -e "6.3.0"
    # echo -e "4.7.1"
    echo
    echo -e "Variants:"
    echo -e "xenon  - powerpc64-xenon-elf target with -mcpu=xenon and VMX128, plus the"
    echo -e "         $MUSL_TARGET toolchain (skip it with BUILD_MUSL=false);"
    echo -e "         for libs, builds them for -mcpu=xenon (16.2.0)"
    echo -e "vmx128 - VMX128 assembler support (needs binutils-<ver>-vmx128.diff and gcc-<ver>-vmx128.diff)"
    echo
    echo -e "Example: $0 all 16.2.0 xenon"
    echo
    echo -e "Set install location with the PREFIX env"
    echo
    exit 0
fi
