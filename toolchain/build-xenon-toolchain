#!/bin/bash

# originally written by Uwe Hermann <uwe@hermann-uwe.de>, released as public domain.
# changed for xenon by Felix Domke <tmbinc@elitedvb.net>, still public domain

TARGET=xenon
GCC_CPU="cell"
PREFIX="${PREFIX:-/usr/local/xenon}" # Install location of your final toolchain.
PARALLEL=${PARALLEL:--j$(nproc --all)}

BINU_VER="2.47"
GCC_VER="16.2.0"
NEWL_VER="4.6.0.20260123"
GCC_EXTRA_CFG=""
NEWLIB_EXTRA_CFG=() # array, so values with spaces (CFLAGS_FOR_TARGET=...) stay one argument
VARIANT=""          # "", "xenon" or "vmx128", set from the command line

# Linux (musl) toolchain, built alongside the xenon variant
MUSL_TARGET=powerpc64-xenon-linux-musl
MUSL_SYSROOT="$PREFIX/$MUSL_TARGET"
MUSL_DL="https://musl.libc.org/releases/musl-1.2.5.tar.gz"
LINUX_DL="https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.6.tar.xz" # headers only
MUSL=$(basename $MUSL_DL .tar.gz)
LINUX=$(basename $LINUX_DL .tar.xz)

ZLIB_DL="https://zlib.net/fossils/zlib-1.3.2.tar.gz"
LIBPNG_DL="https://download.sourceforge.net/libpng/libpng-1.6.59.tar.xz"
BZIP2_DL="https://sourceware.org/pub/bzip2/bzip2-1.0.8.tar.gz"
# FREETYPE_DL="https://download.savannah.gnu.org/releases/freetype/freetype-2.15.0.tar.gz"
FREETYPE_DL="https://mirror.netcologne.de/savannah/freetype/freetype-2.15.0.tar.gz"

ZLIB=$(basename $ZLIB_DL .tar.gz)
LIBPNG=$(basename $LIBPNG_DL .tar.xz)
BZIP2=$(basename $BZIP2_DL .tar.gz)
FREETYPE=$(basename $FREETYPE_DL .tar.gz)

# build stages
BUILD_BINUTILS=true
BUILD_GCC=true
BUILD_NEWLIB=true
BUILD_GCC_SECOND=true
BUILD_MUSL="${BUILD_MUSL:-true}" # xenon variant only; BUILD_MUSL=false skips it

# fancy progress bar
EXTR=cat
if type "pv" &> /dev/null; then
  EXTR=pv
fi

cd "$(dirname "$0")"
#FSBRANCH=Swizzy

# path to the logfile
LOGFILE="$PWD/build.log"

shopt -s extglob

# temp variables export, same as xenon-env cmd does
export DEVKITXENON="$PREFIX"
export PATH="${PATH:+${PATH}:}"$DEVKITXENON"/bin:"$DEVKITXENON"/usr/bin"

check_priv()
{
    # test if we can install stuff to $PREFIX
    if [ "$EUID" -ne 0 ]; then
        mkdir -p "$PREFIX"
        touch "$PREFIX"/check_priv 2>/dev/null

        if [ ! -f "$PREFIX"/check_priv ]; then
            echo "For your selected prefix (\"$PREFIX\"), root privileges are required for this feature:"
            sudo PREFIX="$PREFIX" "$@"
            exit 0
        fi

        rm -f "$PREFIX"/check_priv
    fi
}

fail_with_info()
{
    echo "[-] Script failed, check build.log!" >> /dev/stderr
    exit 1
}

patch_newlib()
{
    if [ "$VARIANT" == "xenon" ]; then
        if [ -f $NEWLIB-xenon.diff ]; then
            echo -e "Applying newlib xenon target patches..."
            patch --batch -p1 -d $NEWLIB < $NEWLIB-xenon.diff >> $LOGFILE 2>&1 || fail_with_info
        else
            echo -e "No xenon target patch found for newlib version $NEWL_VER."
            exit 1
        fi
    else
        cat $NEWLIB.diff | patch -p0 >> $LOGFILE 2>&1 || fail_with_info
    fi
}

# to compile and install libxenon
libxenon_install()
{
    check_priv "$@"
    echo -e "Building libxenon..."
    make -C ../libxenon/ports/xenon clean >> $LOGFILE 2>&1 || fail_with_info
    make $PARALLEL -C ../libxenon/ports/xenon TARGET_CPU=$GCC_CPU libxenon.a >> $LOGFILE 2>&1 || fail_with_info
    make -C ../libxenon/ports/xenon install >> $LOGFILE 2>&1 || fail_with_info
    echo
    echo -e "libxenon installed successfully"
    echo
}

toolchain_sources()
{
    # TEMPORARY: Use mirrors for GNU/Savannah projects due to upstream technical issues
    # TODO: sig/sha256 verify when downloading from mirrors

    # BINUTILS_DL="https://ftp.gnu.org/gnu/binutils/binutils-${BINU_VER}.tar.gz"
    BINUTILS_DL="https://mirror.netcologne.de/gnu/binutils/binutils-${BINU_VER}.tar.gz"
    # GCC_DL="https://ftp.gnu.org/gnu/gcc/gcc-${GCC_VER}/gcc-${GCC_VER}.tar.gz"
    GCC_DL="https://mirror.netcologne.de/gnu/gcc/gcc-${GCC_VER}/gcc-${GCC_VER}.tar.gz"
    NEWLIB_DL="https://sourceware.org/pub/newlib/newlib-${NEWL_VER}.tar.gz"

    BINUTILS=$(basename $BINUTILS_DL .tar.gz)
    GCC=$(basename $GCC_DL .tar.gz)
    NEWLIB=$(basename $NEWLIB_DL .tar.gz)
}

# download $1 unless the file $2 is already here
fetch()
{
    if [ ! -f "$2" ]; then
        echo -e "Downloading $2"
        wget -c "$1" || fail_with_info
    fi
}

prepare_binutils_src()
{
        rm -rf $BINUTILS
        mkdir $BINUTILS
        echo -e "Extracting $BINUTILS..."
        $EXTR $BINUTILS.tar.gz | tar xfz - >> $LOGFILE 2>&1 || fail_with_info

        if [ "$VARIANT" == "vmx128" ]; then
            if [ -f $BINUTILS-vmx128.diff ]; then
                cat $BINUTILS.diff | patch -p0 >> $LOGFILE 2>&1 || fail_with_info
                echo -e "Applying vmx128 support..."
                cat $BINUTILS-vmx128.diff | patch -p0 >> $LOGFILE 2>&1 || fail_with_info
            else
                cat $BINUTILS.diff | patch -p0 >> $LOGFILE 2>&1 || fail_with_info
                echo -e "No vmx128 diff found for binutils version $BINU_VER."
                exit 1
            fi
        elif [ "$VARIANT" == "xenon" ]; then
            if [ -f $BINUTILS-xenon.diff ]; then
                echo -e "Applying xenon target patches..."
                patch --batch -p1 -d $BINUTILS < $BINUTILS-xenon.diff >> $LOGFILE 2>&1 || fail_with_info
            else
                echo -e "No xenon target patch found for binutils version $BINU_VER."
                exit 1
            fi
        else
            cat $BINUTILS.diff | patch -p0 >> $LOGFILE 2>&1 || fail_with_info
        fi
}

prepare_gcc_src()
{
        rm -rf $GCC
        mkdir $GCC
        echo -e "Extracting $GCC..."
        $EXTR $GCC.tar.gz | tar xfz - >> $LOGFILE 2>&1 || fail_with_info

        if [ "$VARIANT" == "vmx128" ]; then
            cat $GCC.diff | patch -p0 >> $LOGFILE 2>&1 || fail_with_info
            if [ -f $GCC-vmx128.diff ]; then
                echo -e "Applying vmx128 support..."
                cat $GCC-vmx128.diff | patch -p0 >> $LOGFILE 2>&1 || fail_with_info
            else
                echo -e "No vmx128 diff found for gcc version $GCC_VER."
                exit 1
            fi
        elif [ "$VARIANT" == "xenon" ]; then
            if [ -f $GCC-xenon.diff ]; then
                echo -e "Applying xenon target patches..."
                patch --batch -p1 -d $GCC < $GCC-xenon.diff >> $LOGFILE 2>&1 || fail_with_info
            else
                echo -e "No xenon target patch found for gcc version $GCC_VER."
                exit 1
            fi
        else
            cat $GCC.diff | patch -p0 >> $LOGFILE 2>&1 || fail_with_info
        fi
}

toolchain_install()
{
    toolchain_sources
    check_priv "$@"
    chown -R `whoami`:`whoami` "$PREFIX"

    # Check if sources are available, download if needed
    fetch $BINUTILS_DL $BINUTILS.tar.gz
    fetch $GCC_DL $GCC.tar.gz
    fetch $NEWLIB_DL $NEWLIB.tar.gz

    # gcc keeps its own build dir: all-gcc is built before newlib, the
    # target libraries are finished in the same dir after newlib
    rm -rf build build-newlib
    mkdir build build-newlib
    if $BUILD_GCC; then
        rm -rf build-gcc
        mkdir build-gcc
    fi

    if $BUILD_BINUTILS; then
        prepare_binutils_src

        cd build
        echo -e "Configuring $BINUTILS..."
        case "${BINU_VER}" in
            2.39 | 2.4*) # 2.39+
                ../$BINUTILS/configure --target=$TARGET --prefix="$PREFIX" \
                --disable-werror --enable-multilib --disable-nls  \
                --enable-default-execstack=no  --enable-warn-execstack=no \
                --enable-warn-rwx-segments=no >> $LOGFILE 2>&1 || fail_with_info
                ;;
            *)
                ../$BINUTILS/configure --target=$TARGET --prefix="$PREFIX" \
                --disable-werror --enable-multilib --disable-nls \
                >> $LOGFILE 2>&1 || fail_with_info
                ;;
        esac
        echo -e "Building $BINUTILS, this could take a while..."
        make $PARALLEL >> $LOGFILE 2>&1 || fail_with_info
        echo -e "Installing $BINUTILS..."
        make install >> $LOGFILE 2>&1 || fail_with_info
        cd ..
        rm -rf build/*
        echo -e "Done"
    fi

    if $BUILD_GCC; then
        prepare_gcc_src

        rm -rf $NEWLIB
        mkdir -p $NEWLIB
        echo -e "Extracting $NEWLIB..."
        $EXTR $NEWLIB.tar.gz | tar xfz - >> $LOGFILE 2>&1 || fail_with_info
        patch_newlib

        # the compiler is configured with its final options before newlib
        # exists, so give it newlib's headers up front
        mkdir -p "$PREFIX/$TARGET/include" "$PREFIX/$TARGET/sys-include" || fail_with_info
        cp -r $NEWLIB/newlib/libc/include/* "$PREFIX/$TARGET/include/" || fail_with_info

        local gcc_cfg=(--target=$TARGET --prefix="$PREFIX" --with-cpu=$GCC_CPU --with-newlib
            --enable-languages=c,c++ --disable-threads --disable-shared --disable-decimal-float
            --disable-libquadmath --disable-libssp --disable-libsanitizer --disable-nls
            --disable-linux-futex --disable-libatomic --disable-libgomp --disable-libitm
            --disable-libstdcxx-time --disable-initfini-array)
        if [ "$VARIANT" != "xenon" ]; then
            # options kept from the older patch sets (some are no-ops on newer gcc)
            gcc_cfg+=(--with-libiconv-prefix=/opt/local --with-gmp=/opt/local --with-mpfr=/opt/local
                --enable-cxx-flags="-G0" --enable-altivec --disable-libmudflap)
        fi

        cd build-gcc
        echo -e "Configuring $GCC..."
        unset LIBRARY_PATH
        ../$GCC/configure "${gcc_cfg[@]}" $GCC_EXTRA_CFG -v >> $LOGFILE 2>&1 || fail_with_info

        echo -e "Building $GCC (compiler only), this could take a while..."
        make $PARALLEL MAKEINFO=true all-gcc >> $LOGFILE 2>&1 || fail_with_info
        echo -e "Installing $GCC (compiler only)..."
        make MAKEINFO=true install-gcc >> $LOGFILE 2>&1 || fail_with_info
        cd ..
        echo -e "Done"
    fi

    if $BUILD_NEWLIB; then
        if [ ! -d $NEWLIB/newlib ]; then
            rm -rf $NEWLIB
            echo -e "Extracting $NEWLIB..."
            $EXTR $NEWLIB.tar.gz | tar xfz - >> $LOGFILE 2>&1 || fail_with_info
            patch_newlib
        fi

        cd build-newlib
        echo -e "Configuring $NEWLIB..."
        ../$NEWLIB/configure --target=$TARGET --prefix="$PREFIX"  --enable-multilib --disable-nls \
            CFLAGS="-DHAVE_BLKSIZE -O2" "${NEWLIB_EXTRA_CFG[@]}" \
            --enable-newlib-io-long-long --enable-newlib-io-long-double >> $LOGFILE 2>&1 || fail_with_info
        echo -e "Building $NEWLIB, this could take a while..."
        make $PARALLEL >> $LOGFILE 2>&1 || fail_with_info
        echo -e "Installing $NEWLIB..."
        make install >> $LOGFILE 2>&1 || fail_with_info
        cd ..
        echo -e "Done"
    fi

    if $BUILD_GCC_SECOND; then
        # finish the target libraries (libgcc, libstdc++) now that newlib is installed
        if [ ! -f build-gcc/Makefile ]; then
            echo -e "No configured gcc build in build-gcc, enable BUILD_GCC first."
            exit 1
        fi
        cd build-gcc
        unset LIBRARY_PATH
        echo -e "Building $GCC target libraries, this could take a while..."
        make $PARALLEL MAKEINFO=true all >> $LOGFILE 2>&1 || fail_with_info
        echo -e "Installing $GCC..."
        make MAKEINFO=true install >> $LOGFILE 2>&1 || fail_with_info
        cd ..
        echo -e "Done"
    fi

    rm -rf build build-gcc build-newlib
}

# Linux toolchain for the Xenon: powerpc64-xenon-linux-musl, ELFv2, -mcpu=xenon
# by default, shared libraries and POSIX threads.  Built from the same patched
# binutils and gcc trees as the bare-metal toolchain, into its own sysroot.
musl_toolchain_install()
{
    toolchain_sources
    check_priv "$@"

    if [ "$VARIANT" != "xenon" ]; then
        echo -e "The musl toolchain needs the xenon variant."
        exit 1
    fi

    fetch $BINUTILS_DL $BINUTILS.tar.gz
    fetch $GCC_DL $GCC.tar.gz
    fetch $MUSL_DL $MUSL.tar.gz
    fetch $LINUX_DL $LINUX.tar.xz

    # reuse the trees of the bare-metal build when they carry the xenon patches
    [ -f $BINUTILS/opcodes/ppc-xenon-op4.inc ] || prepare_binutils_src
    [ -f $GCC/gcc/config/rs6000/xenon64.h ] || prepare_gcc_src

    rm -rf build-musl-binutils build-musl-gcc $MUSL $LINUX
    mkdir build-musl-binutils build-musl-gcc
    mkdir -p "$MUSL_SYSROOT/usr" || fail_with_info

    cd build-musl-binutils
    echo -e "Configuring $BINUTILS for $MUSL_TARGET..."
    ../$BINUTILS/configure --target=$MUSL_TARGET --prefix="$PREFIX" --with-sysroot="$MUSL_SYSROOT" \
        --disable-werror --disable-multilib --disable-nls \
        --enable-default-execstack=no --enable-warn-execstack=no \
        --enable-warn-rwx-segments=no >> $LOGFILE 2>&1 || fail_with_info
    echo -e "Building $BINUTILS for $MUSL_TARGET, this could take a while..."
    make $PARALLEL >> $LOGFILE 2>&1 || fail_with_info
    echo -e "Installing $BINUTILS for $MUSL_TARGET..."
    make install >> $LOGFILE 2>&1 || fail_with_info
    cd ..

    echo -e "Installing $LINUX headers..."
    $EXTR $LINUX.tar.xz | tar xJf - >> $LOGFILE 2>&1 || fail_with_info
    make -C $LINUX ARCH=powerpc INSTALL_HDR_PATH="$MUSL_SYSROOT/usr" headers_install >> $LOGFILE 2>&1 || fail_with_info
    rm -rf $LINUX

    cd build-musl-gcc
    echo -e "Configuring $GCC for $MUSL_TARGET..."
    unset LIBRARY_PATH
    ../$GCC/configure --target=$MUSL_TARGET --prefix="$PREFIX" --with-sysroot="$MUSL_SYSROOT" \
        --with-cpu=xenon --enable-languages=c,c++ --disable-multilib --disable-nls --disable-werror \
        --enable-shared --enable-threads=posix --enable-tls --enable-lto \
        --disable-libsanitizer --disable-libssp --disable-libquadmath --disable-libstdcxx-pch \
        -v >> $LOGFILE 2>&1 || fail_with_info
    echo -e "Building $GCC for $MUSL_TARGET (compiler only), this could take a while..."
    make $PARALLEL MAKEINFO=true all-gcc >> $LOGFILE 2>&1 || fail_with_info
    make MAKEINFO=true install-gcc >> $LOGFILE 2>&1 || fail_with_info
    cd ..

    echo -e "Extracting $MUSL..."
    $EXTR $MUSL.tar.gz | tar xfz - >> $LOGFILE 2>&1 || fail_with_info
    cd $MUSL
    echo -e "Configuring $MUSL..."
    ./configure --target=$MUSL_TARGET --prefix=/usr --syslibdir=/lib \
        CROSS_COMPILE=$MUSL_TARGET- CC=$MUSL_TARGET-gcc LIBCC=" " >> $LOGFILE 2>&1 || fail_with_info
    make DESTDIR="$MUSL_SYSROOT" install-headers >> $LOGFILE 2>&1 || fail_with_info
    cd ..

    # static libgcc only, enough to build musl; the full build below adds libgcc_s
    cd build-musl-gcc
    echo -e "Building libgcc for $MUSL_TARGET..."
    make $PARALLEL MAKEINFO=true enable_shared=no all-target-libgcc >> $LOGFILE 2>&1 || fail_with_info
    make MAKEINFO=true enable_shared=no install-target-libgcc >> $LOGFILE 2>&1 || fail_with_info
    cd ..

    cd $MUSL
    echo -e "Building $MUSL..."
    ./configure --target=$MUSL_TARGET --prefix=/usr --syslibdir=/lib \
        CROSS_COMPILE=$MUSL_TARGET- CC=$MUSL_TARGET-gcc >> $LOGFILE 2>&1 || fail_with_info
    make $PARALLEL >> $LOGFILE 2>&1 || fail_with_info
    echo -e "Installing $MUSL..."
    make DESTDIR="$MUSL_SYSROOT" install >> $LOGFILE 2>&1 || fail_with_info
    cd ..
    rm -rf $MUSL

    cd build-musl-gcc
    echo -e "Building $GCC target libraries for $MUSL_TARGET, this could take a while..."
    make $PARALLEL MAKEINFO=true all >> $LOGFILE 2>&1 || fail_with_info
    echo -e "Installing $GCC for $MUSL_TARGET..."
    make MAKEINFO=true install >> $LOGFILE 2>&1 || fail_with_info
    cd ..
    rm -rf build-musl-binutils build-musl-gcc
    echo -e "Done"
}

zlib_install()
{
    check_priv "$@"

    if [ ! -f "$ZLIB.tar.gz" ]; then
        echo -e "Downloading $ZLIB..."
        wget -c $ZLIB_DL || fail_with_info
    fi

    echo -e "Extracting $ZLIB..."
    rm -rf $ZLIB
    tar xzf $ZLIB.tar.gz >> $LOGFILE 2>&1 || fail_with_info
    cd $ZLIB

    export TARGET_SAVE=$TARGET
    export CC=$TARGET-gcc
    export CFLAGS="$LIB_CFLAGS -Wno-error -L$DEVKITXENON/xenon/lib/32/ -T$DEVKITXENON/app.lds -u read -u _start -u exc_base -L$DEVKITXENON/usr/lib -I$DEVKITXENON/usr/include"
    export LDFLAGS="${CFLAGS//-T$DEVKITXENON\/app.lds/} -lxenon" # avoid duplicate -T
    export TARGET=`gcc -v 2>&1 | sed -n '2p' | awk '{print $2}'`

    echo -e "Configuring $ZLIB..."
    ./configure --static --prefix=$DEVKITXENON/usr >> $LOGFILE 2>&1 || fail_with_info

    sed '/cp $(SHAREDLIBV) $(DESTDIR)$(sharedlibdir)/d' Makefile > Makefile.xenon

    echo -e "Building $ZLIB..."
    make $PARALLEL -f Makefile.xenon CROSS_COMPILE=$TARGET- libz.a >> $LOGFILE 2>&1 || fail_with_info
    echo -e "Installing $ZLIB..."
    make -f Makefile.xenon CROSS_COMPILE=$TARGET- install >> $LOGFILE 2>&1 || fail_with_info
    cd ..
    rm -rf $ZLIB

    export CC=""
    export CFLAGS=""
    export LDFLAGS=""
    export TARGET=$TARGET_SAVE

    echo -e "Done"
}

libpng_install()
{
    check_priv "$@"

    if [ ! -f "$LIBPNG.tar.xz" ]; then
        echo -e "Downloading $LIBPNG..."
        wget -c $LIBPNG_DL || fail_with_info
    fi

    echo -e "Extracting $LIBPNG..."
    rm -rf $LIBPNG
    tar xJf $LIBPNG.tar.xz >> $LOGFILE 2>&1 && cat ../libxenon/ports/libpng/$LIBPNG.diff | patch -p0 >> $LOGFILE 2>&1 || fail_with_info
    cd $LIBPNG

    export CC=$TARGET-gcc
    export CFLAGS="$LIB_CFLAGS $DEVKITXENON/usr/lib/libxenon.a -L$DEVKITXENON/xenon/lib/32 -T$DEVKITXENON/app.lds -u read -u _start -u exc_base -L$DEVKITXENON/usr/lib -I$DEVKITXENON/usr/include"
    export LDFLAGS="${CFLAGS//-T$DEVKITXENON\/app.lds/}"
    export CPPFLAGS="-I$DEVKITXENON/usr/include" # pnglibconf generation only sees CPPFLAGS

    echo -e "Configuring $LIBPNG..."
    ./configure --disable-shared --enable-static --disable-tests --disable-tools --disable-hardware-optimizations --prefix=$DEVKITXENON/usr --host=ppc-elf >> $LOGFILE 2>&1 || fail_with_info

    echo -e "Building $LIBPNG..."
    make $PARALLEL CROSS_COMPILE=$TARGET- CFLAGS="${CFLAGS//$DEVKITXENON\/usr\/lib\/libxenon.a/}" LDFLAGS="${LDFLAGS//$DEVKITXENON\/usr\/lib\/libxenon.a/}" check_PROGRAMS= >> $LOGFILE 2>&1 || fail_with_info
    echo -e "Installing $LIBPNG..."
    make CROSS_COMPILE=$TARGET- CFLAGS="${CFLAGS//$DEVKITXENON\/usr\/lib\/libxenon.a/}" LDFLAGS="${LDFLAGS//$DEVKITXENON\/usr\/lib\/libxenon.a/}" check_PROGRAMS= install >> $LOGFILE 2>&1 || fail_with_info
    # libpng 1.5 names, for homebrew that links -lpng15 or includes <libpng15/png.h>
    rm -f $DEVKITXENON/usr/lib/libpng15.la
    ln -sfn libpng16.a $DEVKITXENON/usr/lib/libpng15.a
    ln -sfn libpng16.pc $DEVKITXENON/usr/lib/pkgconfig/libpng15.pc
    rm -rf $DEVKITXENON/usr/include/libpng15 # may be a real dir from a 1.5 install
    ln -sfn libpng16 $DEVKITXENON/usr/include/libpng15
    ln -sfn libpng16-config $DEVKITXENON/usr/bin/libpng15-config
    cd ..
    rm -rf $LIBPNG

    export CC=""
    export CFLAGS=""
    export LDFLAGS=""
    export CPPFLAGS=""

    echo -e "Done"
}

