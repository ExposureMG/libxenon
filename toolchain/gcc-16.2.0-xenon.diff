index 000000000..594a85dd6
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-5.c
@@ -0,0 +1,70 @@
+/* Xenon VMX128 ABI (plan 4.3): the default speed threshold is 16 saved
+   registers.  15 are saved inline (v113-v127); 16 (v112-v127) and all 64
+   (v64-v127) call _savevr128_N / _restvr128_N.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler-times {\mstvx128 (11[3-9]|12[0-7]),1,0\M} 15 } } */
+/* { dg-final { scan-assembler-times {\mlvx128 (11[3-9]|12[0-7]),1,0\M} 15 } } */
+/* { dg-final { scan-assembler-times {\mbl _savevr128_112\M} 1 } } */
+/* { dg-final { scan-assembler-times {\mbl _restvr128_112\M} 1 } } */
+/* { dg-final { scan-assembler-times {\mbl _savevr128_64\M} 1 } } */
+/* { dg-final { scan-assembler-times {\mbl _restvr128_64\M} 1 } } */
+/* { dg-final { scan-assembler-not {\mstvx\M} } } */
+
+typedef __attribute__ ((vector_size (16))) float v4sf;
+
+void g (void);
+
+void
+keep15 (v4sf *restrict o, const v4sf *restrict a)
+{
+  v4sf x0 = a[0], x1 = a[1], x2 = a[2], x3 = a[3], x4 = a[4], x5 = a[5], x6
+    = a[6], x7 = a[7], x8 = a[8], x9 = a[9], x10 = a[10], x11 = a[11], x12
+    = a[12], x13 = a[13], x14 = a[14];
+  g ();
+  o[0] = x14; o[1] = x13; o[2] = x12; o[3] = x11; o[4] = x10; o[5] = x9;
+    o[6] = x8; o[7] = x7; o[8] = x6; o[9] = x5; o[10] = x4; o[11] = x3;
+    o[12] = x2; o[13] = x1; o[14] = x0;
+}
+
+void
+keep16 (v4sf *restrict o, const v4sf *restrict a)
+{
+  v4sf x0 = a[0], x1 = a[1], x2 = a[2], x3 = a[3], x4 = a[4], x5 = a[5], x6
+    = a[6], x7 = a[7], x8 = a[8], x9 = a[9], x10 = a[10], x11 = a[11], x12
+    = a[12], x13 = a[13], x14 = a[14], x15 = a[15];
+  g ();
+  o[0] = x15; o[1] = x14; o[2] = x13; o[3] = x12; o[4] = x11; o[5] = x10;
+    o[6] = x9; o[7] = x8; o[8] = x7; o[9] = x6; o[10] = x5; o[11] = x4;
+    o[12] = x3; o[13] = x2; o[14] = x1; o[15] = x0;
+}
+
+void
+keep64 (v4sf *restrict o, const v4sf *restrict a)
+{
+  v4sf x0 = a[0], x1 = a[1], x2 = a[2], x3 = a[3], x4 = a[4], x5 = a[5], x6
+    = a[6], x7 = a[7], x8 = a[8], x9 = a[9], x10 = a[10], x11 = a[11], x12
+    = a[12], x13 = a[13], x14 = a[14], x15 = a[15], x16 = a[16], x17 =
+    a[17], x18 = a[18], x19 = a[19], x20 = a[20], x21 = a[21], x22 = a[22],
+    x23 = a[23], x24 = a[24], x25 = a[25], x26 = a[26], x27 = a[27], x28 =
+    a[28], x29 = a[29], x30 = a[30], x31 = a[31], x32 = a[32], x33 = a[33],
+    x34 = a[34], x35 = a[35], x36 = a[36], x37 = a[37], x38 = a[38], x39 =
+    a[39], x40 = a[40], x41 = a[41], x42 = a[42], x43 = a[43], x44 = a[44],
+    x45 = a[45], x46 = a[46], x47 = a[47], x48 = a[48], x49 = a[49], x50 =
+    a[50], x51 = a[51], x52 = a[52], x53 = a[53], x54 = a[54], x55 = a[55],
+    x56 = a[56], x57 = a[57], x58 = a[58], x59 = a[59], x60 = a[60], x61 =
+    a[61], x62 = a[62], x63 = a[63];
+  g ();
+  o[0] = x63; o[1] = x62; o[2] = x61; o[3] = x60; o[4] = x59; o[5] = x58;
+    o[6] = x57; o[7] = x56; o[8] = x55; o[9] = x54; o[10] = x53; o[11] =
+    x52; o[12] = x51; o[13] = x50; o[14] = x49; o[15] = x48; o[16] = x47;
+    o[17] = x46; o[18] = x45; o[19] = x44; o[20] = x43; o[21] = x42; o[22]
+    = x41; o[23] = x40; o[24] = x39; o[25] = x38; o[26] = x37; o[27] = x36;
+    o[28] = x35; o[29] = x34; o[30] = x33; o[31] = x32; o[32] = x31; o[33]
+    = x30; o[34] = x29; o[35] = x28; o[36] = x27; o[37] = x26; o[38] = x25;
+    o[39] = x24; o[40] = x23; o[41] = x22; o[42] = x21; o[43] = x20; o[44]
+    = x19; o[45] = x18; o[46] = x17; o[47] = x16; o[48] = x15; o[49] = x14;
+    o[50] = x13; o[51] = x12; o[52] = x11; o[53] = x10; o[54] = x9; o[55] =
+    x8; o[56] = x7; o[57] = x6; o[58] = x5; o[59] = x4; o[60] = x3; o[61] =
+    x2; o[62] = x1; o[63] = x0;
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-abi-6.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-6.c
new file mode 100644
index 000000000..807fe10a3
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-6.c
@@ -0,0 +1,25 @@
+/* Xenon VMX128 ABI (plan 4.3): the save area holds a slot for each saved
+   register only, in register order.  An asm that clobbers v70, v100 and
+   the volatile v40 saves v70 and v100 (and not v40) in two adjacent
+   16-byte slots; a leaf with only those fits in the red zone, so there is
+   no stack frame: v70 at -32, v100 at -16 from the stack pointer.  Sparse
+   save sets are always saved inline, also when optimizing for size.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-Os -maltivec -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler-times {\mli 0,-32\M} 2 } } */
+/* { dg-final { scan-assembler-times {\mli 0,-16\M} 2 } } */
+/* { dg-final { scan-assembler-times {\mstvx128 70,1,0\M} 1 } } */
+/* { dg-final { scan-assembler-times {\mstvx128 100,1,0\M} 1 } } */
+/* { dg-final { scan-assembler-times {\mlvx128 70,1,0\M} 1 } } */
+/* { dg-final { scan-assembler-times {\mlvx128 100,1,0\M} 1 } } */
+/* { dg-final { scan-assembler-not {\mstvx128 40,} } } */
+/* { dg-final { scan-assembler-not {\mstdu\M} } } */
+/* { dg-final { scan-assembler-not {\m_savevr128_} } } */
+/* { dg-final { scan-assembler {\.cfi_offset 158, -32} } } */
+/* { dg-final { scan-assembler {\.cfi_offset 188, -16} } } */
+
+void
+clobber_sparse (void)
+{
+  __asm__ volatile ("# clobbers" ::: "v40", "v70", "v100");
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-abi-7.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-7.c
new file mode 100644
index 000000000..0191f3c16
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-7.c
@@ -0,0 +1,24 @@
+/* Xenon VMX128 ABI (plan 4.3): a leaf that clobbers all of v64-v127 needs
+   1 KiB of save area, more than the 288-byte red zone, so it allocates a
+   16-byte aligned frame; optimizing for size it calls _savevr128_64 and
+   _restvr128_64.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-Os -maltivec -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler-times {\mbl _savevr128_64\M} 1 } } */
+/* { dg-final { scan-assembler-times {\mbl _restvr128_64\M} 1 } } */
+/* { dg-final { scan-assembler {\mstdu 1,-1(0[4-9][0-9]|1[0-9][0-9])\(1\)} } } */
+/* { dg-final { scan-assembler {\.cfi_offset 152, } } } */
+/* { dg-final { scan-assembler {\.cfi_offset 215, } } } */
+
+#define C8(B) "v" #B "0", "v" #B "1", "v" #B "2", "v" #B "3", \
+  "v" #B "4", "v" #B "5", "v" #B "6", "v" #B "7"
+
+void
+clobber_all (void)
+{
+  __asm__ volatile ("# clobbers v64-v127" ::: "v64", "v65", "v66", "v67",
+		    "v68", "v69", C8 (7), "v78", "v79", C8 (8), "v88", "v89",
+		    C8 (9), "v98", "v99", C8 (10), "v108", "v109", C8 (11),
+		    "v118", "v119", "v120", "v121", "v122", "v123", "v124",
+		    "v125", "v126", "v127");
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-abi-8.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-8.c
new file mode 100644
index 000000000..ab101ac07
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-8.c
@@ -0,0 +1,27 @@
+/* Xenon VMX128 ABI (plan 4.3): in a frame larger than 32 KiB the 16-bit
+   offsets in r0 cannot reach the save area from the new stack pointer.
+   As for the AltiVec saves, the prologue keeps a pointer to the top of the
+   vector save area in r12 (left by the stack allocation) and saves
+   relative to it.  The six slots are within the red zone, so the epilogue
+   pops the frame through the back chain first and restores from r1
+   (xenon-abi-19.c has a save area below the red zone).  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler-times {\mstvx128 (12[2-7]),12,0\M} 6 } } */
+/* { dg-final { scan-assembler-times {\mlvx128 (12[2-7]),1,0\M} 6 } } */
+/* { dg-final { scan-assembler {\mstdux 1,1,0\M} } } */
+/* { dg-final { scan-assembler {\mld 1,0\(1\)} } } */
+/* { dg-final { scan-assembler-not {\mstvx128 (12[2-7]),1,} } } */
+
+typedef __attribute__ ((vector_size (16))) float v4sf;
+
+void g (char *);
+
+void
+keep6_bigframe (v4sf *restrict o, const v4sf *restrict a)
+{
+  char buf[40000];
+  v4sf x0 = a[0], x1 = a[1], x2 = a[2], x3 = a[3], x4 = a[4], x5 = a[5];
+  g (buf);
+  o[0] = x5; o[1] = x4; o[2] = x3; o[3] = x2; o[4] = x1; o[5] = x0;
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-abi-9.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-9.c
new file mode 100644
index 000000000..e2c40f25e
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-9.c
@@ -0,0 +1,25 @@
+/* Xenon VMX128 ABI (plan 4.3): v64-v127 saved in a function with a dynamic
+   stack allocation (alloca): the saves are made right after the frame is
+   allocated, below the AltiVec area, and the epilogue resets the stack
+   pointer from the frame pointer r31 (not from the moved stack pointer)
+   before restoring them from the red zone.  tools/check_xenon_abi_frames.py
+   checks the slots.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler-times {\mstvx128 (12[2-7]),1,0\M} 6 } } */
+/* { dg-final { scan-assembler-times {\mlvx128 (12[2-7]),1,0\M} 6 } } */
+/* { dg-final { scan-assembler {\mstdux [0-9]+,1,} } } */
+/* { dg-final { scan-assembler {\maddi 1,31,} } } */
+
+typedef __attribute__ ((vector_size (16))) float v4sf;
+
+void g (char *);
+
+void
+keep6_alloca (v4sf *restrict o, const v4sf *restrict a, long n)
+{
+  char *p = __builtin_alloca (n);
+  v4sf x0 = a[0], x1 = a[1], x2 = a[2], x3 = a[3], x4 = a[4], x5 = a[5];
+  g (p);
+  o[0] = x5; o[1] = x4; o[2] = x3; o[3] = x2; o[4] = x1; o[5] = x0;
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-atomic-local.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-atomic-local.c
new file mode 100644
index 000000000..3acc8510c
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-atomic-local.c
@@ -0,0 +1,21 @@
+/* Xenon implements lwarx/ldarx only with EH = 0: the "local" exclusive
+   access hint of __builtin_ppc_atomic_cas_local is dropped.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler {\mlwarx\M} } } */
+/* { dg-final { scan-assembler {\mldarx\M} } } */
+/* { dg-final { scan-assembler-not {\ml[wd]arx [0-9]+,[0-9]+,[0-9]+,1} } } */
+
+int
+cas_si (int *ptr, int *expected, int *desired)
+{
+  return __builtin_ppc_atomic_cas_local (ptr, expected, desired, 0,
+					 __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);
+}
+
+long
+cas_di (long *ptr, long *expected, long *desired)
+{
+  return __builtin_ppc_atomic_cas_local (ptr, expected, desired, 1,
+					 __ATOMIC_ACQUIRE, __ATOMIC_RELAXED);
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-builtin-1.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtin-1.c
new file mode 100644
index 000000000..e36b88e8e
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtin-1.c
@@ -0,0 +1,61 @@
+/* Xenon (-mcpu=xenon): the AltiVec intrinsics for the integer multiply,
+   multiply-sum, multiply-high-add and sum-across instructions are rejected
+   with an error that names the instruction (the Xenon PPE raises an
+   illegal-instruction interrupt for all of them).  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon" } */
+/* { dg-prune-output "overloaded builtin" } */
+
+#include <altivec.h>
+
+typedef __vector signed char vsc;
+typedef __vector unsigned char vuc;
+typedef __vector signed short vss;
+typedef __vector unsigned short vus;
+typedef __vector signed int vsi;
+typedef __vector unsigned int vui;
+
+extern vsc sc1, sc2;
+extern vuc uc1, uc2;
+extern vss ss1, ss2, ss3;
+extern vus us1, us2, us3;
+extern vsi si1, si2;
+extern vui ui1, ui2;
+typedef long long v2di __attribute__ ((vector_size (16)));
+
+vus f00 (void) { return vec_mule (uc1, uc2); }	/* { dg-error "is not supported on Xenon: the .vmuleub. instruction is not implemented" } */
+vss f01 (void) { return vec_mule (sc1, sc2); }	/* { dg-error "is not supported on Xenon: the .vmulesb. instruction is not implemented" } */
+vui f02 (void) { return vec_mule (us1, us2); }	/* { dg-error "is not supported on Xenon: the .vmuleuh. instruction is not implemented" } */
+vsi f03 (void) { return vec_mule (ss1, ss2); }	/* { dg-error "is not supported on Xenon: the .vmulesh. instruction is not implemented" } */
+vus f04 (void) { return vec_mulo (uc1, uc2); }	/* { dg-error "is not supported on Xenon: the .vmuloub. instruction is not implemented" } */
+vss f05 (void) { return vec_mulo (sc1, sc2); }	/* { dg-error "is not supported on Xenon: the .vmulosb. instruction is not implemented" } */
+vui f06 (void) { return vec_mulo (us1, us2); }	/* { dg-error "is not supported on Xenon: the .vmulouh. instruction is not implemented" } */
+vsi f07 (void) { return vec_mulo (ss1, ss2); }	/* { dg-error "is not supported on Xenon: the .vmulosh. instruction is not implemented" } */
+vui f08 (void) { return vec_msum (uc1, uc2, ui1); }	/* { dg-error "is not supported on Xenon: the .vmsumubm. instruction is not implemented" } */
+vsi f09 (void) { return vec_msum (sc1, uc2, si1); }	/* { dg-error "is not supported on Xenon: the .vmsummbm. instruction is not implemented" } */
+vui f10 (void) { return vec_msum (us1, us2, ui1); }	/* { dg-error "is not supported on Xenon: the .vmsumuhm. instruction is not implemented" } */
+vsi f11 (void) { return vec_msum (ss1, ss2, si1); }	/* { dg-error "is not supported on Xenon: the .vmsumshm. instruction is not implemented" } */
+vui f12 (void) { return vec_msums (us1, us2, ui1); }	/* { dg-error "is not supported on Xenon: the .vmsumuhs. instruction is not implemented" } */
+vsi f13 (void) { return vec_msums (ss1, ss2, si1); }	/* { dg-error "is not supported on Xenon: the .vmsumshs. instruction is not implemented" } */
+vss f14 (void) { return vec_madds (ss1, ss2, ss3); }	/* { dg-error "is not supported on Xenon: the .vmhaddshs. instruction is not implemented" } */
+vss f15 (void) { return vec_mradds (ss1, ss2, ss3); }	/* { dg-error "is not supported on Xenon: the .vmhraddshs. instruction is not implemented" } */
+vss f16 (void) { return vec_mladd (ss1, ss2, ss3); }	/* { dg-error "is not supported on Xenon: the .vmladduhm. instruction is not implemented" } */
+vus f17 (void) { return vec_mladd (us1, us2, us3); }	/* { dg-error "is not supported on Xenon: the .vmladduhm. instruction is not implemented" } */
+vss f18 (void) { return vec_madd (ss1, ss2, ss3); }	/* { dg-error "is not supported on Xenon: the .vmladduhm. instruction is not implemented" } */
+vui f19 (void) { return vec_sum4s (uc1, ui1); }	/* { dg-error "is not supported on Xenon: the .vsum4ubs. instruction is not implemented" } */
+vsi f20 (void) { return vec_sum4s (sc1, si1); }	/* { dg-error "is not supported on Xenon: the .vsum4sbs. instruction is not implemented" } */
+vsi f21 (void) { return vec_sum4s (ss1, si1); }	/* { dg-error "is not supported on Xenon: the .vsum4shs. instruction is not implemented" } */
+vsi f22 (void) { return vec_sum2s (si1, si2); }	/* { dg-error "is not supported on Xenon: the .vsum2sws. instruction is not implemented" } */
+vsi f23 (void) { return vec_sums (si1, si2); }	/* { dg-error "is not supported on Xenon: the .vsumsws. instruction is not implemented" } */
+vus f24 (void) { return vec_vmuleub (uc1, uc2); }	/* { dg-error "is not supported on Xenon: the .vmuleub. instruction is not implemented" } */
+vsi f25 (void) { return vec_vmsumshm (ss1, ss2, si1); }	/* { dg-error "is not supported on Xenon: the .vmsumshm. instruction is not implemented" } */
+vui f26 (void) { return vec_vsum4ubs (uc1, ui1); }	/* { dg-error "is not supported on Xenon: the .vsum4ubs. instruction is not implemented" } */
+vsi f27 (void) { return vec_vsumsws (si1, si2); }	/* { dg-error "is not supported on Xenon: the .vsumsws. instruction is not implemented" } */
+vss f28 (void) { return vec_vmhaddshs (ss1, ss2, ss3); }	/* { dg-error "is not supported on Xenon: the .vmhaddshs. instruction is not implemented" } */
+vss f29 (void) { return vec_vmladduhm (ss1, ss2, ss3); }	/* { dg-error "is not supported on Xenon: the .vmladduhm. instruction is not implemented" } */
+/* The vector int forms are the ISA 2.07 vmulesw/vmuleuw/vmulosw/vmulouw;
+   they used to pass the builtin check and ICE at expansion.  */
+v2di f30 (void) { return (v2di) vec_mule (si1, si2); }	/* { dg-error "is not supported on Xenon: the .vmulesw. instruction is not implemented" } */
+v2di f31 (void) { return (v2di) vec_mule (ui1, ui2); }	/* { dg-error "is not supported on Xenon: the .vmuleuw. instruction is not implemented" } */
+v2di f32 (void) { return (v2di) vec_mulo (si1, si2); }	/* { dg-error "is not supported on Xenon: the .vmulosw. instruction is not implemented" } */
+v2di f33 (void) { return (v2di) vec_mulo (ui1, ui2); }	/* { dg-error "is not supported on Xenon: the .vmulouw. instruction is not implemented" } */
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-builtin-2.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtin-2.c
new file mode 100644
index 000000000..ee662e0e3
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtin-2.c
@@ -0,0 +1,78 @@
+/* The same intrinsics as xenon-builtin-1.c still work on other CPUs: the
+   Xenon gating (TARGET_ALTIVEC_INT_MUL / TARGET_ALTIVEC_VSUM) is specific to
+   -mcpu=xenon.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=cell" } */
+/* { dg-final { scan-assembler {\mvmhaddshs\M} } } */
+/* { dg-final { scan-assembler {\mvmhraddshs\M} } } */
+/* { dg-final { scan-assembler {\mvmladduhm\M} } } */
+/* { dg-final { scan-assembler {\mvmsummbm\M} } } */
+/* { dg-final { scan-assembler {\mvmsumshm\M} } } */
+/* { dg-final { scan-assembler {\mvmsumshs\M} } } */
+/* { dg-final { scan-assembler {\mvmsumubm\M} } } */
+/* { dg-final { scan-assembler {\mvmsumuhm\M} } } */
+/* { dg-final { scan-assembler {\mvmsumuhs\M} } } */
+/* { dg-final { scan-assembler {\mvmulesb\M} } } */
+/* { dg-final { scan-assembler {\mvmulesh\M} } } */
+/* { dg-final { scan-assembler {\mvmuleub\M} } } */
+/* { dg-final { scan-assembler {\mvmuleuh\M} } } */
+/* { dg-final { scan-assembler {\mvmulosb\M} } } */
+/* { dg-final { scan-assembler {\mvmulosh\M} } } */
+/* { dg-final { scan-assembler {\mvmuloub\M} } } */
+/* { dg-final { scan-assembler {\mvmulouh\M} } } */
+/* { dg-final { scan-assembler {\mvsum2sws\M} } } */
+/* { dg-final { scan-assembler {\mvsum4sbs\M} } } */
+/* { dg-final { scan-assembler {\mvsum4shs\M} } } */
+/* { dg-final { scan-assembler {\mvsum4ubs\M} } } */
+/* { dg-final { scan-assembler {\mvsumsws\M} } } */
+#include <altivec.h>
+
+typedef __vector signed char vsc;
+typedef __vector unsigned char vuc;
+typedef __vector signed short vss;
+typedef __vector unsigned short vus;
+typedef __vector signed int vsi;
+typedef __vector unsigned int vui;
+
+extern vsc sc1, sc2;
+extern vuc uc1, uc2;
+extern vss ss1, ss2, ss3;
+extern vus us1, us2, us3;
+extern vsi si1, si2;
+extern vui ui1;
+
+vus f00 (void) { return vec_mule (uc1, uc2); }
+vss f01 (void) { return vec_mule (sc1, sc2); }
+vui f02 (void) { return vec_mule (us1, us2); }
+vsi f03 (void) { return vec_mule (ss1, ss2); }
+vus f04 (void) { return vec_mulo (uc1, uc2); }
+vss f05 (void) { return vec_mulo (sc1, sc2); }
+vui f06 (void) { return vec_mulo (us1, us2); }
+vsi f07 (void) { return vec_mulo (ss1, ss2); }
+vui f08 (void) { return vec_msum (uc1, uc2, ui1); }
+vsi f09 (void) { return vec_msum (sc1, uc2, si1); }
+vui f10 (void) { return vec_msum (us1, us2, ui1); }
+vsi f11 (void) { return vec_msum (ss1, ss2, si1); }
+vui f12 (void) { return vec_msums (us1, us2, ui1); }
+vsi f13 (void) { return vec_msums (ss1, ss2, si1); }
+vss f14 (void) { return vec_madds (ss1, ss2, ss3); }
+vss f15 (void) { return vec_mradds (ss1, ss2, ss3); }
+vss f16 (void) { return vec_mladd (ss1, ss2, ss3); }
+vus f17 (void) { return vec_mladd (us1, us2, us3); }
+vss f18 (void) { return vec_madd (ss1, ss2, ss3); }
+vui f19 (void) { return vec_sum4s (uc1, ui1); }
+vsi f20 (void) { return vec_sum4s (sc1, si1); }
+vsi f21 (void) { return vec_sum4s (ss1, si1); }
+vsi f22 (void) { return vec_sum2s (si1, si2); }
+vsi f23 (void) { return vec_sums (si1, si2); }
+vus f24 (void) { return vec_vmuleub (uc1, uc2); }
+vsi f25 (void) { return vec_vmsumshm (ss1, ss2, si1); }
+vui f26 (void) { return vec_vsum4ubs (uc1, ui1); }
+vsi f27 (void) { return vec_vsumsws (si1, si2); }
+vss f28 (void) { return vec_vmhaddshs (ss1, ss2, ss3); }
+vss f29 (void) { return vec_vmladduhm (ss1, ss2, ss3); }
+vui f30 (void) { return __builtin_altivec_vmulouh (us1, us2); }
+vui f31 (void) { return __builtin_altivec_vmsumuhm (us1, us2, ui1); }
+vss f32 (void) { return __builtin_altivec_vmladduhm (ss1, ss2, ss3); }
+vsi f33 (void) { return __builtin_altivec_vsum4shs (ss1, si1); }
+vsi f34 (void) { return __builtin_altivec_vsumsws_be (si1, si2); }
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-builtin-3.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtin-3.c
new file mode 100644
index 000000000..19dfad9c1
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtin-3.c
@@ -0,0 +1,22 @@
+/* The Xenon builtin gating follows the per-function cpu: a
+   target("cpu=cell") function may use the integer multiply intrinsics in a
+   -mcpu=xenon unit (xenon-builtin-6.c: a -mcpu=xenon function may not; the
+   error test is separate because a compile that fails writes no assembly
+   to scan).  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon" } */
+/* { dg-prune-output "overloaded builtin" } */
+/* { dg-final { scan-assembler {\mvmuleub\M} } } */
+/* { dg-final { scan-assembler {\mvsumsws\M} } } */
+
+#include <altivec.h>
+
+typedef __vector unsigned char vuc;
+typedef __vector unsigned short vus;
+typedef __vector signed int vsi;
+
+__attribute__ ((target ("cpu=cell")))
+vus cell_mule (vuc a, vuc b) { return vec_mule (a, b); }
+
+__attribute__ ((target ("cpu=cell")))
+vsi cell_sums (vsi a, vsi b) { return vec_sums (a, b); }
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-builtin-4.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtin-4.c
new file mode 100644
index 000000000..717615eef
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtin-4.c
@@ -0,0 +1,32 @@
+/* Xenon (-mcpu=xenon): the __builtin_altivec_* functions behind the
+   integer multiply, multiply-sum and sum-across intrinsics are rejected when
+   they are expanded, with an error that names the instruction.  (They are
+   separate from xenon-builtin-1.c because expansion-time errors are not
+   reported once the front end has given errors.)  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon" } */
+
+#include <altivec.h>
+
+typedef __vector signed char vsc;
+typedef __vector unsigned char vuc;
+typedef __vector signed short vss;
+typedef __vector unsigned short vus;
+typedef __vector signed int vsi;
+typedef __vector unsigned int vui;
+
+extern vsc sc1, sc2;
+extern vuc uc1, uc2;
+extern vss ss1, ss2, ss3;
+extern vus us1, us2, us3;
+extern vsi si1, si2;
+extern vui ui1, ui2;
+typedef long long v2di __attribute__ ((vector_size (16)));
+
+vui f30 (void) { return __builtin_altivec_vmulouh (us1, us2); }	/* { dg-error "is not supported on Xenon: the .vmulouh. instruction is not implemented" } */
+vui f31 (void) { return __builtin_altivec_vmsumuhm (us1, us2, ui1); }	/* { dg-error "is not supported on Xenon: the .vmsumuhm. instruction is not implemented" } */
+vss f32 (void) { return __builtin_altivec_vmladduhm (ss1, ss2, ss3); }	/* { dg-error "is not supported on Xenon: the .vmladduhm. instruction is not implemented" } */
+vsi f33 (void) { return __builtin_altivec_vsum4shs (ss1, si1); }	/* { dg-error "is not supported on Xenon: the .vsum4shs. instruction is not implemented" } */
+vsi f34 (void) { return __builtin_altivec_vsumsws_be (si1, si2); }	/* { dg-error "is not supported on Xenon: the .vsumsws. instruction is not implemented" } */
+v2di f35 (void) { return (v2di) __builtin_altivec_vmulesw (si1, si2); }	/* { dg-error "is not supported on Xenon: the .vmulesw. instruction is not implemented" } */
+v2di f36 (void) { return (v2di) __builtin_altivec_vmulouw (ui1, ui2); }	/* { dg-error "is not supported on Xenon: the .vmulouw. instruction is not implemented" } */
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-builtin-5.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtin-5.c
new file mode 100644
index 000000000..cbf47d6ff
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtin-5.c
@@ -0,0 +1,20 @@
+/* The vector __int128 forms of vperm, vsel and vsldoi need V1TImode, which
+   is a vector mode only with VSX.  Without VSX (-mcpu=xenon) they are
+   refused with the usual "requires -mvsx" error instead of an ICE in
+   copy_to_mode_reg.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -mdejagnu-cpu=xenon" } */
+
+#include <altivec.h>
+
+typedef __vector signed __int128 vsq;
+typedef __vector unsigned __int128 vuq;
+extern vsq a, b;
+extern vuq ua, ub, uc;
+extern __vector unsigned char pc;
+
+vsq f0 (void) { return __builtin_altivec_vperm_1ti (a, b, pc); }	/* { dg-error "requires the .-mvsx. option" } */
+vuq f1 (void) { return __builtin_altivec_vperm_1ti_uns (ua, ub, pc); }	/* { dg-error "requires the .-mvsx. option" } */
+vsq f2 (void) { return __builtin_altivec_vsel_1ti (a, b, uc); }	/* { dg-error "requires the .-mvsx. option" } */
+vuq f3 (void) { return __builtin_altivec_vsel_1ti_uns (ua, ub, uc); }	/* { dg-error "requires the .-mvsx. option" } */
+vsq f4 (void) { return __builtin_altivec_vsldoi_v1ti (a, b, 3); }	/* { dg-error "requires the .-mvsx. option" } */
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-builtin-6.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtin-6.c
new file mode 100644
index 000000000..b1fd20a7e
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtin-6.c
@@ -0,0 +1,17 @@
+/* The Xenon builtin gating follows the per-function cpu: in a -mcpu=xenon
+   unit the integer multiply intrinsics are an error, also next to a
+   target("cpu=cell") function that may use them (xenon-builtin-3.c scans
+   that function's code).  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon" } */
+/* { dg-prune-output "overloaded builtin" } */
+
+#include <altivec.h>
+
+typedef __vector unsigned char vuc;
+typedef __vector unsigned short vus;
+
+__attribute__ ((target ("cpu=cell")))
+vus cell_mule (vuc a, vuc b) { return vec_mule (a, b); }
+
+vus xenon_mule (vuc a, vuc b) { return vec_mule (a, b); }	/* { dg-error "is not supported on Xenon: the .vmuleub. instruction" } */
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-builtins-1.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtins-1.c
new file mode 100644
index 000000000..55841da70
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtins-1.c
@@ -0,0 +1,183 @@
+/* Xenon VMX128-only builtins (plan 4.2, D7, step 7): each builtin emits
+   exactly its instruction, with the operand order of isa/xenon_isa.json:
+   vmsum3fp128/vmsum4fp128/vmulfp128 vD,vA,vB; vmaddcfp128 vD,vA,vD,vB
+   (= vA*vD + vB, the multiplicand tied); vrlimi128 vD,vB,UIMM,VD3D2 (vD
+   tied); vpermwi128 vD,vB,PERM; vpkd3d128 vD,vB,VD3D0,VD3D1,VD3D2 (vD
+   tied); vupkd3d128 vD,vB,UIMM with UIMM = type << 2.  The operands are
+   forced into v40-v43 (and v0-v31, v64+, v127) with register asm; the 128
+   mnemonic is printed for every register.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon" } */
+
+/* { dg-final { scan-assembler {\mvmsum3fp128 42,40,41$} } } */
+/* { dg-final { scan-assembler {\mvmsum4fp128 42,40,41$} } } */
+/* { dg-final { scan-assembler {\mvmulfp128 42,40,41$} } } */
+/* { dg-final { scan-assembler {\mvmaddcfp128 41,40,41,42$} } } */
+/* { dg-final { scan-assembler {\mvrlimi128 42,40,9,2$} } } */
+/* { dg-final { scan-assembler {\mvpermwi128 42,40,27$} } } */
+/* { dg-final { scan-assembler {\mvpkd3d128 42,40,5,2,3$} } } */
+/* { dg-final { scan-assembler {\mvupkd3d128 42,40,24$} } } */
+/* Low registers: still the 128 forms (no legacy equivalent).  */
+/* { dg-final { scan-assembler {\mvmsum4fp128 6,4,5$} } } */
+/* { dg-final { scan-assembler {\mvmaddcfp128 5,4,5,[0-9]+$} } } */
+/* { dg-final { scan-assembler {\mvrlimi128 6,4,15,0$} } } */
+/* High registers.  */
+/* { dg-final { scan-assembler {\mvmsum3fp128 127,64,100$} } } */
+/* { dg-final { scan-assembler {\mvpermwi128 127,64,255$} } } */
+/* { dg-final { scan-assembler {\mvpkd3d128 127,64,0,1,0$} } } */
+/* { dg-final { scan-assembler {\mvupkd3d128 64,127,0$} } } */
+/* Integer types use the same instructions.  */
+/* { dg-final { scan-assembler {\mvrlimi128 42,40,1,3$} } } */
+/* { dg-final { scan-assembler {\mvpermwi128 42,40,147$} } } */
+/* { dg-final { scan-assembler {\mvpkd3d128 42,40,6,3,1$} } } */
+/* Exactly one instruction per call.  */
+/* { dg-final { scan-assembler-times {\mvmsum3fp128 } 2 } } */
+/* { dg-final { scan-assembler-times {\mvmsum4fp128 } 2 } } */
+/* { dg-final { scan-assembler-times {\mvmulfp128 } 1 } } */
+/* { dg-final { scan-assembler-times {\mvmaddcfp128 } 2 } } */
+/* { dg-final { scan-assembler-times {\mvrlimi128 } 3 } } */
+/* { dg-final { scan-assembler-times {\mvpermwi128 } 3 } } */
+/* { dg-final { scan-assembler-times {\mvpkd3d128 } 3 } } */
+/* { dg-final { scan-assembler-times {\mvupkd3d128 } 2 } } */
+/* No other vector arithmetic (only the asm-barrier-free loads/stores).  */
+/* { dg-final { scan-assembler-not {\mv(madd|nmsub)fp|\mvperm |\mvsldoi|\mvsel} } } */
+
+typedef __vector float vf;
+typedef __vector unsigned int vui;
+typedef __vector signed int vsi;
+
+#define IN2(T, A, B, RA, RB)						\
+  register T A __asm__ (RA) = pa[0];					\
+  register T B __asm__ (RB) = pa[1];					\
+  __asm__ ("" : "+wV" (A), "+wV" (B))
+
+#define OUT(T, R, RR, E)						\
+  register T R __asm__ (RR) = (E);					\
+  __asm__ ("" : "+wV" (R));						\
+  *pr = R
+
+void
+msum3 (vf *pr, const vf *pa)
+{
+  IN2 (vf, a, b, "v40", "v41");
+  OUT (vf, r, "v42", __builtin_xenon_vmsum3fp (a, b));
+}
+
+void
+msum4 (vf *pr, const vf *pa)
+{
+  IN2 (vf, a, b, "v40", "v41");
+  OUT (vf, r, "v42", __builtin_xenon_vmsum4fp (a, b));
+}
+
+void
+mulfp (vf *pr, const vf *pa)
+{
+  IN2 (vf, a, b, "v40", "v41");
+  OUT (vf, r, "v42", __builtin_xenon_vmulfp (a, b));
+}
+
+void
+maddc (vf *pr, const vf *pa)
+{
+  register vf a __asm__ ("v40") = pa[0];
+  register vf d __asm__ ("v41") = pa[1];
+  register vf b __asm__ ("v42") = pa[2];
+  __asm__ ("" : "+wV" (a), "+wV" (d), "+wV" (b));
+  d = __builtin_xenon_vmaddcfp (a, d, b);
+  __asm__ ("" : "+wV" (d));
+  *pr = d;
+}
+
+void
+rlimi (vf *pr, const vf *pa)
+{
+  IN2 (vf, b, d, "v40", "v42");
+  d = __builtin_xenon_vrlimi (d, b, 9, 2);
+  __asm__ ("" : "+wV" (d));
+  *pr = d;
+}
+
+void
+permwi (vf *pr, const vf *pa)
+{
+  register vf b __asm__ ("v40") = pa[0];
+  __asm__ ("" : "+wV" (b));
+  OUT (vf, r, "v42", __builtin_xenon_vpermwi (b, 0x1B));
+}
+
+void
+pkd3d (vf *pr, const vf *pa)
+{
+  IN2 (vf, b, d, "v40", "v42");
+  d = __builtin_xenon_vpkd3d (d, b, 5, 2, 3);
+  __asm__ ("" : "+wV" (d));
+  *pr = d;
+}
+
+void
+upkd3d (vf *pr, const vui *pa)
+{
+  register vui b __asm__ ("v40") = pa[0];
+  __asm__ ("" : "+wV" (b));
+  OUT (vf, r, "v42", __builtin_xenon_vupkd3d (b, 6));
+}
+
+/* v0-v31 */
+void
+low (vf *pr, const vf *pa)
+{
+  register vf a __asm__ ("v4") = pa[0];
+  register vf b __asm__ ("v5") = pa[1];
+  __asm__ ("" : "+v" (a), "+v" (b));
+  register vf r __asm__ ("v6") = __builtin_xenon_vmsum4fp (a, b);
+  __asm__ ("" : "+v" (r));
+  pr[0] = r;
+  b = __builtin_xenon_vmaddcfp (a, b, r);
+  __asm__ ("" : "+v" (b));
+  pr[1] = b;
+  r = __builtin_xenon_vrlimi (r, a, 15, 0);
+  __asm__ ("" : "+v" (r));
+  pr[2] = r;
+}
+
+/* v64-v127 */
+void
+high (vf *pr, const vf *pa, const vui *pu)
+{
+  register vf a __asm__ ("v64") = pa[0];
+  register vf b __asm__ ("v100") = pa[1];
+  __asm__ ("" : "+wV" (a), "+wV" (b));
+  register vf r __asm__ ("v127") = __builtin_xenon_vmsum3fp (a, b);
+  __asm__ ("" : "+wV" (r));
+  pr[0] = r;
+  r = __builtin_xenon_vpermwi (a, 255);
+  __asm__ ("" : "+wV" (r));
+  pr[1] = r;
+  r = __builtin_xenon_vpkd3d (r, a, 0, 1, 0);
+  __asm__ ("" : "+wV" (r));
+  pr[2] = r;
+  register vui u __asm__ ("v127") = pu[0];
+  __asm__ ("" : "+wV" (u));
+  a = __builtin_xenon_vupkd3d (u, 0);
+  __asm__ ("" : "+wV" (a));
+  pr[3] = a;
+}
+
+/* vector unsigned int / signed int */
+void
+ints (vui *pr, const vui *pa, vsi *ps)
+{
+  IN2 (vui, b, d, "v40", "v42");
+  d = __builtin_xenon_vrlimi (d, b, 1, 3);
+  __asm__ ("" : "+wV" (d));
+  pr[0] = d;
+  register vsi s __asm__ ("v40") = ps[0];
+  __asm__ ("" : "+wV" (s));
+  register vsi t __asm__ ("v42") = __builtin_xenon_vpermwi (s, 0x93);
+  __asm__ ("" : "+wV" (t));
+  ps[1] = t;
+  t = __builtin_xenon_vpkd3d (t, (vf) s, 6, 3, 1);
+  __asm__ ("" : "+wV" (t));
+  ps[2] = t;
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-builtins-10.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtins-10.c
new file mode 100644
index 000000000..b459e9af7
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtins-10.c
@@ -0,0 +1,31 @@
+/* Xenon VMX128-only builtins (step 7) follow the target attribute and
+   pragma: available in a cpu=xenon function of a -mcpu=cell unit.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=cell" } */
+
+/* { dg-final { scan-assembler {\mvmsum4fp128 } } } */
+/* { dg-final { scan-assembler {\mvrlimi128 [0-9]+,[0-9]+,1,1$} } } */
+/* { dg-final { scan-assembler {\mvpermwi128 [0-9]+,[0-9]+,7$} } } */
+
+typedef __vector float vf;
+
+__attribute__ ((target ("cpu=xenon"))) vf
+f1 (vf a, vf b)
+{
+  return __builtin_xenon_vmsum4fp (a, b);
+}
+
+__attribute__ ((target ("cpu=xenon"))) vf
+f2 (vf d, vf b)
+{
+  return __builtin_xenon_vrlimi (d, b, 1, 1);
+}
+
+#pragma GCC push_options
+#pragma GCC target ("cpu=xenon")
+vf
+f3 (vf b)
+{
+  return __builtin_xenon_vpermwi (b, 7);
+}
+#pragma GCC pop_options
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-builtins-11.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtins-11.c
new file mode 100644
index 000000000..81c152cc1
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtins-11.c
@@ -0,0 +1,25 @@
+/* Xenon VMX128-only builtins: <xenon_vmx.h> can be included in a unit
+   compiled for another CPU (s78-fix; it used to stop with an #error).  Its
+   definitions are compiled for Xenon under a pushed target pragma, which
+   does not leak: __VMX128__ stays undefined after the header, and the
+   unit's own code is Cell code (xenon-builtins-14.c / -15.c use the
+   functions).  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=cell" } */
+/* { dg-final { scan-assembler-not {\.machine xenon} } } */
+/* { dg-final { scan-assembler-not {128\M} } } */
+
+#include <xenon_vmx.h>
+
+#ifdef __VMX128__
+#error "__VMX128__ leaked out of xenon_vmx.h"
+#endif
+#ifndef XENON_MASK_XYZW
+#error "the constants of xenon_vmx.h are missing"
+#endif
+
+vector float
+cell_madd (vector float a, vector float b, vector float c)
+{
+  return a * b + c;
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-builtins-12.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtins-12.c
new file mode 100644
index 000000000..af9a64579
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtins-12.c
@@ -0,0 +1,19 @@
+/* Xenon VMX128-only builtins (step 7): a no-vmx128 function of a
+   -mcpu=xenon unit cannot use them (front-end error for the overloaded
+   name).  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon" } */
+
+typedef __vector float vf;
+
+__attribute__ ((target ("no-vmx128"))) vf
+f1 (vf b)
+{
+  return __builtin_xenon_vpermwi (b, 7);	/* { dg-error "'__builtin_xenon_vpermwi_v4sf' requires the '-mvmx128' option" } */
+}
+
+vf
+f2 (vf b)
+{
+  return __builtin_xenon_vpermwi (b, 7);
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-builtins-13.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtins-13.c
new file mode 100644
index 000000000..9378913fb
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtins-13.c
@@ -0,0 +1,57 @@
+/* Xenon VMX128-only operations (step 7) are reached only through the
+   __builtin_xenon_* functions: the vectorizer and the generic permute and
+   fma expansion never emit them (vmsum3fp128/vmsum4fp128 are not IEEE dot
+   products).  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O3 -ffast-math -maltivec -mdejagnu-cpu=xenon" } */
+
+/* { dg-final { scan-assembler-not {\mvmsum[34]fp128\M} } } */
+/* { dg-final { scan-assembler-not {\mvrlimi128\M} } } */
+/* { dg-final { scan-assembler-not {\mvpermwi128\M} } } */
+/* { dg-final { scan-assembler-not {\mv(up|pk)d3d128\M} } } */
+
+typedef float v4sf __attribute__ ((vector_size (16)));
+typedef int v4si __attribute__ ((vector_size (16)));
+
+float
+dot (const float *restrict a, const float *restrict b, int n)
+{
+  float s = 0.0f;
+  for (int i = 0; i < n; i++)
+    s += a[i] * b[i];
+  return s;
+}
+
+void
+dot4 (float *restrict o, const float *restrict a, const float *restrict b, int n)
+{
+  for (int i = 0; i < n; i++)
+    o[i] = a[4 * i] * b[4 * i] + a[4 * i + 1] * b[4 * i + 1]
+	   + a[4 * i + 2] * b[4 * i + 2] + a[4 * i + 3] * b[4 * i + 3];
+}
+
+void
+dot3 (float *restrict o, const float *restrict a, const float *restrict b, int n)
+{
+  for (int i = 0; i < n; i++)
+    o[i] = a[4 * i] * b[4 * i] + a[4 * i + 1] * b[4 * i + 1]
+	   + a[4 * i + 2] * b[4 * i + 2];
+}
+
+v4sf
+swizzle (v4sf a)
+{
+  return __builtin_shuffle (a, (v4si) { 3, 2, 1, 0 });
+}
+
+v4sf
+blend (v4sf a, v4sf b)
+{
+  return __builtin_shuffle (a, b, (v4si) { 0, 5, 2, 7 });
+}
+
+v4sf
+rot (v4sf a, v4sf b)
+{
+  return __builtin_shuffle (a, b, (v4si) { 5, 6, 7, 0 });
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-builtins-14.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtins-14.c
new file mode 100644
index 000000000..75f3758e8
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtins-14.c
@@ -0,0 +1,38 @@
+/* <xenon_vmx.h> in a unit compiled for another CPU: its functions are
+   compiled for Xenon (the header pushes target ("cpu=xenon") when VMX128 is
+   off), so a function marked target ("cpu=xenon") or compiled under the
+   pragma can use them (the multi-CPU dispatch pattern).  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=cell" } */
+/* { dg-final { scan-assembler {\mvmsum4fp128\M} } } */
+/* { dg-final { scan-assembler {\mvrlimi128\M} } } */
+/* { dg-final { scan-assembler {\mvmulfp128\M} } } */
+/* { dg-final { scan-assembler {\.machine xenon} } } */
+
+#include <xenon_vmx.h>
+
+#ifdef __VMX128__
+#error "__VMX128__ leaked out of xenon_vmx.h"
+#endif
+
+__attribute__ ((target ("cpu=xenon")))
+vector float
+dot_rot (vector float a, vector float b)
+{
+  return xenon_vrlimi (xenon_vmsum4fp (a, b), b, XENON_MASK_X, 1);
+}
+
+#pragma GCC push_options
+#pragma GCC target ("cpu=xenon")
+vector float
+mul (vector float a, vector float b)
+{
+  return xenon_vmulfp (a, b);
+}
+#pragma GCC pop_options
+
+vector float
+cell_add (vector float a, vector float b)
+{
+  return a + b;
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-builtins-15.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtins-15.c
new file mode 100644
index 000000000..7d81bada0
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtins-15.c
@@ -0,0 +1,16 @@
+/* <xenon_vmx.h> in a unit compiled for another CPU: using one of its
+   functions in a function that is not compiled for Xenon is an error (the
+   always_inline function cannot be inlined across the target mismatch),
+   as with the x86 intrinsic headers.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=cell" } */
+
+#include <xenon_vmx.h>
+
+vector float
+bad (vector float a, vector float b)
+{
+  return xenon_vmsum4fp (a, b);
+}
+
+/* { dg-error "inlining failed in call to 'always_inline' 'xenon_vmsum4fp': target specific option mismatch" "" { target *-*-* } 0 } */
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-builtins-2.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtins-2.c
new file mode 100644
index 000000000..a44d8cb78
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtins-2.c
@@ -0,0 +1,73 @@
+/* Xenon VMX128-only builtins (step 7): the destructive forms vmaddcfp128,
+   vrlimi128 and vpkd3d128 read their destination register (JSON
+   tied_operands [VD128]).  When the tied input stays live, the register
+   allocator copies it into the result register first (vor128 for v32+,
+   the legacy vor when both are in v0-v31), then the instruction updates
+   the copy.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon" } */
+
+/* { dg-final { scan-assembler {\mvor128 43,41,41\M} } } */
+/* { dg-final { scan-assembler {\mvrlimi128 43,40,3,1$} } } */
+/* { dg-final { scan-assembler {\mvor128 44,41,41\M} } } */
+/* { dg-final { scan-assembler {\mvpkd3d128 44,40,4,1,2$} } } */
+/* { dg-final { scan-assembler {\mvor128 45,41,41\M} } } */
+/* { dg-final { scan-assembler {\mvmaddcfp128 45,40,45,42$} } } */
+/* Low registers: the legacy vor copies.  */
+/* { dg-final { scan-assembler {\mvor 6,5,5\M} } } */
+/* { dg-final { scan-assembler {\mvrlimi128 6,4,12,3$} } } */
+/* The old value is still stored from its own register.  */
+/* { dg-final { scan-assembler-times {\mstvx128 41,} 3 } } */
+/* No legacy mnemonic with a v32+ operand.  */
+/* { dg-final { scan-assembler-not {^\t(v[a-z]+|lv[a-z]+|stv[a-z]+)\.? ([0-9]+,)*(3[2-9]|[4-9][0-9]|1[0-2][0-9])(,|$)} } } */
+
+typedef __vector float vf;
+
+void
+rl_copy (vf *pr, const vf *pa)
+{
+  register vf b __asm__ ("v40") = pa[0];
+  register vf d __asm__ ("v41") = pa[1];
+  __asm__ ("" : "+wV" (b), "+wV" (d));
+  register vf r __asm__ ("v43") = __builtin_xenon_vrlimi (d, b, 3, 1);
+  __asm__ ("" : "+wV" (r), "+wV" (d), "+wV" (b));
+  pr[0] = r;
+  pr[1] = d;
+}
+
+void
+pk_copy (vf *pr, const vf *pa)
+{
+  register vf b __asm__ ("v40") = pa[0];
+  register vf d __asm__ ("v41") = pa[1];
+  __asm__ ("" : "+wV" (b), "+wV" (d));
+  register vf r __asm__ ("v44") = __builtin_xenon_vpkd3d (d, b, 4, 1, 2);
+  __asm__ ("" : "+wV" (r), "+wV" (d), "+wV" (b));
+  pr[0] = r;
+  pr[1] = d;
+}
+
+void
+madd_copy (vf *pr, const vf *pa)
+{
+  register vf a __asm__ ("v40") = pa[0];
+  register vf d __asm__ ("v41") = pa[1];
+  register vf b __asm__ ("v42") = pa[2];
+  __asm__ ("" : "+wV" (a), "+wV" (d), "+wV" (b));
+  register vf r __asm__ ("v45") = __builtin_xenon_vmaddcfp (a, d, b);
+  __asm__ ("" : "+wV" (r), "+wV" (d));
+  pr[0] = r;
+  pr[1] = d;
+}
+
+void
+low_copy (vf *pr, const vf *pa)
+{
+  register vf a __asm__ ("v4") = pa[0];
+  register vf d __asm__ ("v5") = pa[1];
+  __asm__ ("" : "+v" (a), "+v" (d));
+  register vf r __asm__ ("v6") = __builtin_xenon_vrlimi (d, a, 12, 3);
+  __asm__ ("" : "+v" (r), "+v" (d));
+  pr[0] = r;
+  pr[1] = d;
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-builtins-3.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtins-3.c
new file mode 100644
index 000000000..ebb8ce330
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtins-3.c
@@ -0,0 +1,43 @@
+/* Xenon VMX128-only builtins (step 7): the immediates must be literals
+   within the instruction fields' defined values (vrlimi mask 0-15, rotate
+   0-3; vpermwi 0-255; vpkd3d type 0-6, pack size 1-3, slot 0-3; vupkd3d
+   type 0-6).  These are expansion-time errors, so this file contains no
+   front-end errors.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon" } */
+
+typedef __vector float vf;
+typedef __vector unsigned int vui;
+
+vf rl1 (vf d, vf b) { return __builtin_xenon_vrlimi (d, b, 16, 0); }	/* { dg-error "argument 3 must be a literal between 0 and 15, inclusive" } */
+vf rl2 (vf d, vf b) { return __builtin_xenon_vrlimi (d, b, -1, 0); }	/* { dg-error "argument 3 must be a literal between 0 and 15, inclusive" } */
+vf rl3 (vf d, vf b) { return __builtin_xenon_vrlimi (d, b, 15, 4); }	/* { dg-error "argument 4 must be a literal between 0 and 3, inclusive" } */
+vf rl4 (vf d, vf b, int m) { return __builtin_xenon_vrlimi (d, b, m, 0); }	/* { dg-error "argument 3 must be a literal between 0 and 15, inclusive" } */
+vf rl5 (vf d, vf b, int r) { return __builtin_xenon_vrlimi (d, b, 1, r); }	/* { dg-error "argument 4 must be a literal between 0 and 3, inclusive" } */
+vui rl6 (vui d, vui b) { return __builtin_xenon_vrlimi (d, b, 31, 0); }	/* { dg-error "argument 3 must be a literal between 0 and 15, inclusive" } */
+vf rl7 (vf d, vf b) { return __builtin_xenon_vrlimi_v4sf (d, b, 32, 0); }	/* { dg-error "argument 3 must be a literal between 0 and 15, inclusive" } */
+
+vf pw1 (vf b) { return __builtin_xenon_vpermwi (b, 256); }	/* { dg-error "argument 2 must be a literal between 0 and 255, inclusive" } */
+vf pw2 (vf b) { return __builtin_xenon_vpermwi (b, -1); }	/* { dg-error "argument 2 must be a literal between 0 and 255, inclusive" } */
+vui pw3 (vui b, int p) { return __builtin_xenon_vpermwi (b, p); }	/* { dg-error "argument 2 must be a literal between 0 and 255, inclusive" } */
+
+vf pk1 (vf d, vf b) { return __builtin_xenon_vpkd3d (d, b, 7, 1, 0); }	/* { dg-error "argument 3 must be a literal between 0 and 6, inclusive" } */
+vf pk2 (vf d, vf b) { return __builtin_xenon_vpkd3d (d, b, -1, 1, 0); }	/* { dg-error "argument 3 must be a literal between 0 and 6, inclusive" } */
+vf pk3 (vf d, vf b) { return __builtin_xenon_vpkd3d (d, b, 0, 0, 0); }	/* { dg-error "argument 4 must be a literal between 1 and 3, inclusive" } */
+vf pk4 (vf d, vf b) { return __builtin_xenon_vpkd3d (d, b, 0, 4, 0); }	/* { dg-error "argument 4 must be a literal between 1 and 3, inclusive" } */
+vf pk5 (vf d, vf b) { return __builtin_xenon_vpkd3d (d, b, 0, 1, 4); }	/* { dg-error "argument 5 must be a literal between 0 and 3, inclusive" } */
+vui pk6 (vui d, vf b, int s) { return __builtin_xenon_vpkd3d (d, b, 0, 1, s); }	/* { dg-error "argument 5 must be a literal between 0 and 3, inclusive" } */
+vf pk7 (vf d, vf b, int t) { return __builtin_xenon_vpkd3d (d, b, t, 1, 0); }	/* { dg-error "argument 3 must be a literal between 0 and 6, inclusive" } */
+
+vf up1 (vui b) { return __builtin_xenon_vupkd3d (b, 7); }	/* { dg-error "argument 2 must be a literal between 0 and 6, inclusive" } */
+vf up2 (vui b) { return __builtin_xenon_vupkd3d (b, -1); }	/* { dg-error "argument 2 must be a literal between 0 and 6, inclusive" } */
+vf up3 (vf b, int t) { return __builtin_xenon_vupkd3d (b, t); }	/* { dg-error "argument 2 must be a literal between 0 and 6, inclusive" } */
+
+/* The limits themselves are accepted.  */
+vf ok1 (vf d, vf b) { return __builtin_xenon_vrlimi (d, b, 15, 3); }
+vf ok2 (vf d, vf b) { return __builtin_xenon_vrlimi (d, b, 0, 0); }
+vf ok3 (vf b) { return __builtin_xenon_vpermwi (b, 255); }
+vf ok4 (vf d, vf b) { return __builtin_xenon_vpkd3d (d, b, 6, 3, 3); }
+vf ok5 (vf d, vf b) { return __builtin_xenon_vpkd3d (d, b, 0, 1, 0); }
+vf ok6 (vui b) { return __builtin_xenon_vupkd3d (b, 6); }
+vf ok7 (vui b) { return __builtin_xenon_vupkd3d (b, 0); }
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-builtins-4.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtins-4.c
new file mode 100644
index 000000000..6a503c8cf
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtins-4.c
@@ -0,0 +1,31 @@
+/* Xenon VMX128-only builtins (step 7): argument types.  The word-granular
+   builtins take vector float/signed int/unsigned int (and bool int for
+   vrlimi and vpermwi) with matching types; vpkd3d packs vector float;
+   vupkd3d accepts any non-bool 128-bit vector; the dot products, vmaddcfp
+   and vmulfp take vector float only.  Front-end errors.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon" } */
+
+typedef __vector float vf;
+typedef __vector signed int vsi;
+typedef __vector unsigned int vui;
+typedef __vector __bool int vbi;
+typedef __vector signed short vss;
+typedef __vector __bool short vbs;
+typedef __vector __pixel vp;
+
+vf t1 (vf d, vsi b) { return __builtin_xenon_vrlimi (d, b, 1, 1); }	/* { dg-error "invalid parameter combination for AltiVec intrinsic '__builtin_xenon_vrlimi'" } */
+vss t2 (vss b) { return __builtin_xenon_vpermwi (b, 1); }	/* { dg-error "invalid parameter combination for AltiVec intrinsic '__builtin_xenon_vpermwi'" } */
+vsi t3 (vsi d, vsi b) { return __builtin_xenon_vpkd3d (d, b, 0, 1, 0); }	/* { dg-error "invalid parameter combination for AltiVec intrinsic '__builtin_xenon_vpkd3d'" } */
+vbi t4 (vbi d, vf b) { return __builtin_xenon_vpkd3d (d, b, 0, 1, 0); }	/* { dg-error "invalid parameter combination for AltiVec intrinsic '__builtin_xenon_vpkd3d'" } */
+vf t5 (vbs b) { return __builtin_xenon_vupkd3d (b, 0); }	/* { dg-error "invalid parameter combination for AltiVec intrinsic '__builtin_xenon_vupkd3d'" } */
+vf t6 (vp b) { return __builtin_xenon_vupkd3d (b, 0); }	/* { dg-error "invalid parameter combination for AltiVec intrinsic '__builtin_xenon_vupkd3d'" } */
+vf t7 (vf b) { return __builtin_xenon_vrlimi (b, 1, 1); }	/* { dg-error "too few arguments" } */
+/* { dg-error "incompatible type for argument 2" "" { target *-*-* } .-1 } */
+vf t8 (vsi a, vf b) { return __builtin_xenon_vmsum4fp (a, b); }	/* { dg-error "incompatible type for argument 1|incompatible type" } */
+
+/* Accepted combinations.  */
+vbi ok1 (vbi d, vbi b) { return __builtin_xenon_vrlimi (d, b, 1, 1); }
+vui ok2 (vui b) { return __builtin_xenon_vpermwi (b, 1); }
+vsi ok3 (vsi d, vf b) { return __builtin_xenon_vpkd3d (d, b, 0, 1, 0); }
+vf ok4 (vss b) { return __builtin_xenon_vupkd3d (b, 3); }
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-builtins-5.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtins-5.c
