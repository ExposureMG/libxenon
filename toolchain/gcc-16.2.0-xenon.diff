diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-vec-nabs.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-vec-nabs.c
new file mode 100644
index 000000000..193146b2e
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-vec-nabs.c
@@ -0,0 +1,15 @@
+/* vec_nabs on vector float without VSX (Xenon, Cell): the builtin used to
+   name the VSX pattern xvnabssp and ended as an unrecognizable insn.  It
+   now sets the sign bits with vspltisw/vslw/vor (their VMX128 forms when
+   the registers are v32-v127, plan step 5).  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler {\mvspltisw(128)?\M} } } */
+/* { dg-final { scan-assembler {\mvslw(128)?\M} } } */
+/* { dg-final { scan-assembler {\mvor(128)?\M} } } */
+/* { dg-final { scan-assembler-not {\mxvnabssp\M} } } */
+
+#include <altivec.h>
+
+vector float f (vector float a) { return vec_nabs (a); }
+vector float g (vector float a) { return __builtin_altivec_nabs_v4sf (a); }
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-vect-cost-1.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-vect-cost-1.c
new file mode 100644
index 000000000..baf33270c
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-vect-cost-1.c
@@ -0,0 +1,54 @@
+/* Xenon vectorizer costs (plan 5.5): plain float loops are vectorized.  A
+   VMX op costs its issue cycle (1, like a scalar FP op; its 12-cycle
+   latency is the scheduler's business), a vector load its stream throughput
+   2.93 -> 3, a vector store 3.50 -> 4, a scalar float load 2.93 -> 3 and a
+   scalar store 2.93 -> 3 (FINDINGS 3.4, generated table VEC_*).  The
+   vectorizer's own unrolling keeps the generic 4-wide issue model with an
+   idle sibling (xenon-smt-10.c: halved with a busy one).  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O3 -mdejagnu-cpu=xenon -fdump-tree-vect-details" } */
+/* { dg-final { scan-tree-dump-times {optimized: loop vectorized} 5 "vect" } } */
+/* { dg-final { scan-tree-dump {1 times vector_load costs 3 in body} "vect" } } */
+/* { dg-final { scan-tree-dump {1 times vector_store costs 4 in body} "vect" } } */
+/* { dg-final { scan-tree-dump {1 times vector_stmt costs 1 in body} "vect" } } */
+/* { dg-final { scan-tree-dump {1 times scalar_load costs 3 in prologue} "vect" } } */
+/* { dg-final { scan-tree-dump {1 times scalar_store costs 3 in prologue} "vect" } } */
+/* { dg-final { scan-tree-dump {28:\d+: optimized: loop vectorized using 16 byte vectors and unroll factor 16} "vect" } } */
+/* { dg-final { scan-assembler {\mvaddfp(128)?\M} } } */
+/* { dg-final { scan-assembler {\mvmaddfp(128)?\M|\mvmaddcfp128\M} } } */
+/* { dg-final { scan-assembler {\mvsel(128)?\M} } } */
+/* { dg-final { scan-assembler {\mvcfsx\M|\mvcsxwfp128\M} } } */
+
+#define N 1024
+float a[N], b[N], c[N], d[N];
+int ia[N];
+
+void add (void)
+{
+  for (int i = 0; i < N; i++)
+    a[i] = b[i] + c[i];
+}
+
+void fma4 (void)
+{
+  for (int i = 0; i < N; i++)
+    a[i] = b[i] * c[i] + d[i];
+}
+
+void scale (float k)
+{
+  for (int i = 0; i < N; i++)
+    a[i] = b[i] * k;
+}
+
+void maxf (void)
+{
+  for (int i = 0; i < N; i++)
+    a[i] = b[i] > c[i] ? b[i] : c[i];
+}
+
+void cvt (void)
+{
+  for (int i = 0; i < N; i++)
+    a[i] = (float) ia[i];
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-vect-cost-2.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-vect-cost-2.c
new file mode 100644
index 000000000..d7eb66b74
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-vect-cost-2.c
@@ -0,0 +1,40 @@
+/* Xenon vectorizer costs (plan 5.5): integer vector multiplies cost their
+   instruction count, not 1.  The AltiVec multiply family is illegal on
+   Xenon and altivec.md multiplies in single precision: V4SI 33, V8HI 25,
+   V16QI 31 in-loop instructions, a widening V8HI/V16QI half 12/15
+   (VMUL_*_INSNS / VWMUL_*_INSNS, checked against the compiled code by
+   tools/xenon_vect_cost_check.py); a multiply by a constant costs its
+   shift/add synthesis (x * 10: 3, x * 12345: 8).  The scalar side costs
+   mullw's 11 cycles (unpipelined), mulli's 7 or the synthesis (x * 10: 3).
+   Per element the vector forms are still cheaper (V4SI 8.3, V8HI 3.1,
+   V16QI 1.9 against 11), so every loop here is vectorized; the sched2 model
+   agrees (xenon_vect_cost_check.py "decide").  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O3 -mdejagnu-cpu=xenon -fdump-tree-vect-details" } */
+/* { dg-final { scan-tree-dump-times {optimized: loop vectorized} 9 "vect" } } */
+/* { dg-final { scan-tree-dump {\* _2 1 times vector_stmt costs 33 in body} "vect" } } */
+/* { dg-final { scan-tree-dump {\* _4 1 times vector_stmt costs 25 in body} "vect" } } */
+/* { dg-final { scan-tree-dump {\* _4 1 times vector_stmt costs 31 in body} "vect" } } */
+/* { dg-final { scan-tree-dump {w\* _3 2 times vector_stmt costs 24 in body} "vect" } } */
+/* { dg-final { scan-tree-dump {w\* _3 2 times vector_stmt costs 30 in body} "vect" } } */
+/* { dg-final { scan-tree-dump {\* 12345 1 times vector_stmt costs 8 in body} "vect" } } */
+/* { dg-final { scan-tree-dump {\* 10 1 times vector_stmt costs 3 in body} "vect" } } */
+/* { dg-final { scan-tree-dump {\* 12345 1 times scalar_stmt costs 7 in prologue} "vect" } } */
+/* { dg-final { scan-tree-dump {\* 10 1 times scalar_stmt costs 3 in prologue} "vect" } } */
+/* { dg-final { scan-tree-dump {\* _2 1 times scalar_stmt costs 11 in prologue} "vect" } } */
+/* { dg-final { scan-assembler-not {\mvmul[eo][su][bh]\M|\mvmsum[a-z]+\M|\mvmladduhm\M|\mvmuluwm\M} } } */
+
+#define N 1024
+int a[N], b[N], c[N];
+short sa[N], sb[N], sc[N];
+signed char qa[N], qb[N], qc[N];
+
+void m4 (void) { for (int i = 0; i < N; i++) a[i] = b[i] * c[i]; }
+void m8 (void) { for (int i = 0; i < N; i++) sa[i] = sb[i] * sc[i]; }
+void m16 (void) { for (int i = 0; i < N; i++) qa[i] = qb[i] * qc[i]; }
+void w8 (void) { for (int i = 0; i < N; i++) a[i] = sb[i] * sc[i]; }
+void w16 (void) { for (int i = 0; i < N; i++) sa[i] = qb[i] * qc[i]; }
+void k4 (void) { for (int i = 0; i < N; i++) a[i] = b[i] * 12345; }
+void k10 (void) { for (int i = 0; i < N; i++) a[i] = b[i] * 10; }
+int dot (void) { int s = 0; for (int i = 0; i < N; i++) s += b[i] * c[i]; return s; }
+int sdot (void) { int s = 0; for (int i = 0; i < N; i++) s += sb[i] * sc[i]; return s; }
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-vect-cost-3.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-vect-cost-3.c
new file mode 100644
index 000000000..127fd822b
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-vect-cost-3.c
@@ -0,0 +1,12 @@
+/* The integer vector multiply sequence is an ISA property of -mcpu=xenon,
+   so it is costed as its 33 instructions with any tuning (here power7's
+   generic costs, one unit per instruction).  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O3 -mdejagnu-cpu=xenon -mdejagnu-tune=power7 -fdump-tree-vect-details" } */
+/* { dg-final { scan-tree-dump {\* _2 1 times vector_stmt costs 33 in body} "vect" } } */
+/* { dg-final { scan-tree-dump {\* _2 1 times scalar_stmt costs 1 in prologue} "vect" } } */
+
+#define N 1024
+int a[N], b[N], c[N];
+
+void m4 (void) { for (int i = 0; i < N; i++) a[i] = b[i] * c[i]; }
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-vect-cost-4.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-vect-cost-4.c
new file mode 100644
index 000000000..b08731198
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-vect-cost-4.c
@@ -0,0 +1,31 @@
+/* Xenon vectorizer costs (plan 5.5), misaligned accesses: movmisalign loads
+   are lvlx + lvrx + vor = 3 + 3 + 1 = 7 (rotating-destination throughput
+   2.94/2.93, FINDINGS 3.4) and stores stvlx + stvrx = 4 + 12 (CSV store
+   streams 3.50 / 12.48), against 3 / 4 aligned.  A misaligned load next to
+   aligned accesses uses lvlx/lvrx; a misaligned store is aligned by peeling
+   (3 iterations) and the loads become misaligned instead.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O3 -mdejagnu-cpu=xenon -fdump-tree-vect-details" } */
+/* { dg-final { scan-tree-dump-times {optimized: loop vectorized} 2 "vect" } } */
+/* { dg-final { scan-tree-dump {b\[_1\] 1 times unaligned_load \(misalign 4\) costs 7 in body} "vect" } } */
+/* { dg-final { scan-tree-dump {unaligned_load \(misalign 12\) costs 7 in body} "vect" } } */
+/* { dg-final { scan-tree-dump {known peeling = 3} "vect" } } */
+/* { dg-final { scan-assembler {\mlvlx(128)?\M} } } */
+/* { dg-final { scan-assembler {\mlvrx(128)?\M} } } */
+/* { dg-final { scan-assembler-not {\mstv[lr]x(128)?\M} } } */
+/* { dg-final { scan-assembler-not {\mlvs[lr](128)?\M} } } */
+
+#define N 1024
+float a[N], b[N + 4], c[N];
+
+void ld (void)
+{
+  for (int i = 0; i < N; i++)
+    a[i] = b[i + 1] + c[i];
+}
+
+void st (void)
+{
+  for (int i = 0; i < N; i++)
+    b[i + 1] = a[i] + c[i];
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-vect-cost-5.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-vect-cost-5.c
new file mode 100644
index 000000000..3db610b8b
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-vect-cost-5.c
@@ -0,0 +1,29 @@
+/* Xenon vectorizer costs (plan 5.5): a lane goes between a VR and a GPR/FPR
+   only through memory (store, then a load that hits it: ~40 cycles,
+   FINDINGS 3.5), so vec_to_scalar costs 40 and basic-block SLP that needs
+   lane extracts is not done (h); the same block without scalar uses of the
+   lanes is (k).  xenon-vect-cost-6.c: Cell tuning SLPs both.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O3 -mdejagnu-cpu=xenon -fdump-tree-slp2-details" } */
+/* { dg-final { scan-tree-dump {vec_to_scalar costs 40 in epilogue} "slp2" } } */
+/* { dg-final { scan-tree-dump-times {basic block part vectorized} 1 "slp2" } } */
+/* { dg-final { scan-tree-dump {not vectorized: vectorization is not profitable} "slp2" } } */
+
+float A[4] __attribute__ ((aligned (16)));
+float B[4] __attribute__ ((aligned (16)));
+float OUT[4] __attribute__ ((aligned (16)));
+float SIDE[16];
+
+void h (void)
+{
+  float x0 = A[0] * B[0], x1 = A[1] * B[1], x2 = A[2] * B[2], x3 = A[3] * B[3];
+  OUT[0] = x0; OUT[1] = x1; OUT[2] = x2; OUT[3] = x3;
+  SIDE[0] = x0 - x3;
+  SIDE[9] = x1 + x2;
+}
+
+void k (void)
+{
+  float x0 = A[0] * B[0], x1 = A[1] * B[1], x2 = A[2] * B[2], x3 = A[3] * B[3];
+  OUT[0] = x0; OUT[1] = x1; OUT[2] = x2; OUT[3] = x3;
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-vect-cost-6.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-vect-cost-6.c
new file mode 100644
index 000000000..4b9e2cb62
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-vect-cost-6.c
@@ -0,0 +1,26 @@
+/* Contrast for xenon-vect-cost-5.c: with Cell tuning (the generic rs6000
+   costs: vec_to_scalar 1) both blocks are SLP vectorized, so the Xenon
+   decision comes from the Xenon transfer cost.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O3 -mdejagnu-cpu=xenon -mdejagnu-tune=cell -fdump-tree-slp2-details" } */
+/* { dg-final { scan-tree-dump {vec_to_scalar costs 1 in epilogue} "slp2" } } */
+/* { dg-final { scan-tree-dump-times {basic block part vectorized} 2 "slp2" } } */
+
+float A[4] __attribute__ ((aligned (16)));
+float B[4] __attribute__ ((aligned (16)));
+float OUT[4] __attribute__ ((aligned (16)));
+float SIDE[16];
+
+void h (void)
+{
+  float x0 = A[0] * B[0], x1 = A[1] * B[1], x2 = A[2] * B[2], x3 = A[3] * B[3];
+  OUT[0] = x0; OUT[1] = x1; OUT[2] = x2; OUT[3] = x3;
+  SIDE[0] = x0 - x3;
+  SIDE[9] = x1 + x2;
+}
+
+void k (void)
+{
+  float x0 = A[0] * B[0], x1 = A[1] * B[1], x2 = A[2] * B[2], x3 = A[3] * B[3];
+  OUT[0] = x0; OUT[1] = x1; OUT[2] = x2; OUT[3] = x3;
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-vect-cost-7.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-vect-cost-7.c
new file mode 100644
index 000000000..d3cbdaac6
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-vect-cost-7.c
@@ -0,0 +1,37 @@
+/* Xenon vectorizer costs (plan 5.5): building a vector from scalars goes
+   through memory: one store per element and a vector load that hits them,
+   VEC_XFER 40 + 3 * VEC_CONSTRUCT_ELT 3 = 49 for four lanes.  A loop with a
+   runtime stride is vectorized only in its stride-1 version (the
+   element-wise version "will never be profitable"); Cell tuning (generic
+   costs, vec_construct 5) vectorizes the float element-wise version too.
+   The scalar side of a variable shift costs slw's 16 cycles (microcoded,
+   FINDINGS 2.4) against 1 for vslw, so it is vectorized.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O3 -mdejagnu-cpu=xenon -fdump-tree-vect-details" } */
+/* { dg-final { scan-tree-dump {b\[_1\] 1 times vec_construct costs 49 in body} "vect" } } */
+/* { dg-final { scan-tree-dump {fb\[_1\] 1 times vec_construct costs 49 in body} "vect" } } */
+/* { dg-final { scan-tree-dump {<< _3 1 times scalar_stmt costs 16 in prologue} "vect" } } */
+/* { dg-final { scan-tree-dump {not vectorized: vector version will never be profitable} "vect" } } */
+/* { dg-final { scan-tree-dump-times {optimized: loop vectorized} 3 "vect" } } */
+
+#define N 1024
+int a[N], b[64 * N], c[N];
+float fa[N], fb[64 * N];
+
+void sv (int s)
+{
+  for (int i = 0; i < N; i++)
+    a[i] = b[i * s] + 1;
+}
+
+void fsv (int s)
+{
+  for (int i = 0; i < N; i++)
+    fa[i] = fb[i * s] * 2.0f;
+}
+
+void shl (void)
+{
+  for (int i = 0; i < N; i++)
+    a[i] = c[i] << (b[i] & 31);
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-vmx128-1.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-vmx128-1.c
new file mode 100644
index 000000000..a0e38d7aa
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-vmx128-1.c
@@ -0,0 +1,239 @@
+/* Xenon VMX128 (plan 4.2, step 5): every legacy AltiVec/Cell instruction
+   with a VMX128 form of the same operands (tools/gen_xenon_retarget.py,
+   kind DIRECT) is emitted in its 128 form when its operands are in
+   v32-v127.  The inputs are register asm variables in v40/v41 that an asm
+   keeps there, so the instruction must read v40/v41 directly; the result
+   goes through a register asm variable in v42.  The legacy mnemonic must
+   not appear with a v32+ operand (the runner also assembles this under
+   .machine xenon, which rejects that).  The estimates (vrefp, vrsqrtefp,
+   vexptefp, vlogefp) are kept legacy-only (kind "unverified"): see
+   xenon-vmx128-9.c.  */
