+
+int
+catcher (v4sf *restrict o, const v4sf *restrict a)
+{
+  v4sf x0 = a[0], x1 = a[1], x2 = a[2];
+  if (__builtin_setjmp (buf))
+    return 1;
+  g ();
+  o[0] = x2; o[1] = x1; o[2] = x0;
+  return 0;
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-abi-16.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-16.c
new file mode 100644
index 000000000..d699dbf70
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-16.c
@@ -0,0 +1,25 @@
+/* Xenon VMX128 ABI (plan 4.3): AltiVec v20-v31 and VMX128 v64-v127 saved
+   together.  Values used by legacy-only AltiVec arithmetic (integer adds,
+   which have no 128 form) take v31 downwards,
+   move-only values v127 downwards (xenon-regs-9.c); the two save areas are
+   adjacent (VMX128 right below AltiVec), 16-byte aligned, and each
+   register has its own slot (tools/check_xenon_abi_frames.py).  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler-times {\mstvx (2[6-9]|3[01]),1,0\M} 6 } } */
+/* { dg-final { scan-assembler-times {\mstvx128 (12[2-7]),1,0\M} 6 } } */
+
+typedef __attribute__ ((vector_size (16))) float v4sf;
+typedef __attribute__ ((vector_size (16))) int v4si;
+
+void g (void);
+
+void
+both (v4si *restrict o, const v4si *restrict a)
+{
+  v4si x0 = a[0], x1 = a[1], x2 = a[2], x3 = a[3], x4 = a[4], x5 = a[5];
+  v4si y0 = a[6], y1 = a[7], y2 = a[8], y3 = a[9], y4 = a[10], y5 = a[11];
+  g ();
+  o[0] = x5; o[1] = x4; o[2] = x3; o[3] = x2; o[4] = x1; o[5] = x0;
+  o[6] = ((y0 + y1) + (y2 + y3)) + (y4 + y5);
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-abi-17.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-17.c
new file mode 100644
index 000000000..fe179b3a8
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-17.c
@@ -0,0 +1,24 @@
+/* Xenon VMX128 ABI (plan 4.3): shrink-wrapping.  The early exit needs no
+   frame; the path with the calls saves v122-v127 and restores them.
+   The epilogue's CFI restore notes keep the unwind info consistent on
+   both paths (dwarf2cfi would fail otherwise).  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler-times {\mstvx128 (12[2-7]),1,0\M} 6 } } */
+/* { dg-final { scan-assembler-times {\mlvx128 (12[2-7]),1,0\M} 6 } } */
+/* { dg-final { scan-assembler {\.cfi_restore 215\M} } } */
+
+typedef __attribute__ ((vector_size (16))) float v4sf;
+
+void g (void);
+
+void
+keep6_sw (v4sf *restrict o, const v4sf *restrict a, int n)
+{
+  if (n == 0)
+    return;
+  v4sf x0 = a[0], x1 = a[1], x2 = a[2], x3 = a[3], x4 = a[4], x5 = a[5];
+  for (int i = 0; i < n; i++)
+    g ();
+  o[0] = x5; o[1] = x4; o[2] = x3; o[3] = x2; o[4] = x1; o[5] = x0;
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-abi-18.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-18.c
new file mode 100644
index 000000000..12c6a855f
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-18.c
@@ -0,0 +1,22 @@
+/* Xenon VMX128 ABI (plan 4.3): with -mabi=no-altivec the prologue saves no
+   vector register (as for every CPU, it saves v20-v31 only in the AltiVec
+   ABI), so v64-v127 are made call-used: nothing saves them and no value
+   is kept in them across a call.  (Upstream, without the AltiVec ABI the
+   compiler assumes v0-v31 survive calls without saving them; that is
+   unchanged and not a Xenon matter.)  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon -mabi=no-altivec" } */
+/* { dg-final { scan-assembler-not {\.cfi_offset (1[2-9][0-9]|20[0-9]|21[0-5]),} } } */
+/* { dg-final { scan-assembler-not {\mlvx128 (6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7]),} } } */
+
+typedef __attribute__ ((vector_size (16))) float v4sf;
+
+void g (void);
+
+void
+keep6 (v4sf *restrict o, const v4sf *restrict a)
+{
+  v4sf x0 = a[0], x1 = a[1], x2 = a[2], x3 = a[3], x4 = a[4], x5 = a[5];
+  g ();
+  o[0] = x5; o[1] = x4; o[2] = x3; o[3] = x2; o[4] = x1; o[5] = x0;
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-abi-19.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-19.c
new file mode 100644
index 000000000..537d00fa2
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-19.c
@@ -0,0 +1,30 @@
+/* Xenon VMX128 ABI (plan 4.3): a frame larger than 32 KiB whose v64-v127
+   save area reaches below the 288-byte red zone (20 registers, kept inline
+   with --param=xenon-vmx128-ool-threshold=0): the prologue saves through
+   the r12 pointer to the top of the vector area; the epilogue loads the
+   back chain into r11 and restores through it before popping the frame.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon --param=xenon-vmx128-ool-threshold=0" } */
+/* { dg-final { scan-assembler-times {\mstvx128 (10[89]|11[0-9]|12[0-7]),12,0\M} 20 } } */
+/* { dg-final { scan-assembler-times {\mlvx128 (10[89]|11[0-9]|12[0-7]),11,0\M} 20 } } */
+/* { dg-final { scan-assembler {\mld 11,0\(1\)} } } */
+/* { dg-final { scan-assembler-not {\m_savevr128_} } } */
+
+typedef __attribute__ ((vector_size (16))) float v4sf;
+
+void g (char *);
+
+void
+keep20_bigframe (v4sf *restrict o, const v4sf *restrict a)
+{
+  char buf[40000];
+  v4sf x0 = a[0], x1 = a[1], x2 = a[2], x3 = a[3], x4 = a[4], x5 = a[5], x6
+    = a[6], x7 = a[7], x8 = a[8], x9 = a[9], x10 = a[10], x11 = a[11], x12
+    = a[12], x13 = a[13], x14 = a[14], x15 = a[15], x16 = a[16], x17 =
+    a[17], x18 = a[18], x19 = a[19];
+  g (buf);
+  o[0] = x19; o[1] = x18; o[2] = x17; o[3] = x16; o[4] = x15; o[5] = x14;
+    o[6] = x13; o[7] = x12; o[8] = x11; o[9] = x10; o[10] = x9; o[11] = x8;
+    o[12] = x7; o[13] = x6; o[14] = x5; o[15] = x4; o[16] = x3; o[17] = x2;
+    o[18] = x1; o[19] = x0;
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-abi-2.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-2.c
new file mode 100644
index 000000000..5268e6f90
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-2.c
@@ -0,0 +1,28 @@
+/* Xenon VMX128 ABI (plan 4.3): v32-v63 are volatile.  A leaf function
+   with 40 values live at once allocates v32-v63 first (and v0-v19) and
+   saves no vector register (the GPRs it saves for the many load offsets
+   fit in the red zone, so there is no stack frame either).  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler {\mlvx128 (3[2-9]|[45][0-9]|6[0-3]),} } } */
+/* { dg-final { scan-assembler-not {\mlvx128 (6[4-9]|[7-9][0-9]|1[0-2][0-9]),} } } */
+/* { dg-final { scan-assembler-not {\mstvx128 [0-9]+,1,} } } */
+/* { dg-final { scan-assembler-not {\mstdu\M} } } */
+/* { dg-final { scan-assembler-not {\.cfi_offset (7[7-9]|[89][0-9]|10[0-8]|1[2-9][0-9]|20[0-9]|21[0-5]),} } } */
+
+typedef __attribute__ ((vector_size (16))) int v4si;
+
+#define L8(B) v4si x##B##0 = a[B##0], x##B##1 = a[B##1], x##B##2 = a[B##2], \
+  x##B##3 = a[B##3], x##B##4 = a[B##4], x##B##5 = a[B##5], x##B##6 = a[B##6], \
+  x##B##7 = a[B##7];
+#define S8(B) o[B##0] = x##B##7; o[B##1] = x##B##6; o[B##2] = x##B##5; \
+  o[B##3] = x##B##4; o[B##4] = x##B##3; o[B##5] = x##B##2; o[B##6] = x##B##1; \
+  o[B##7] = x##B##0;
+
+void
+mov40 (v4si *restrict o, const v4si *restrict a)
+{
+  L8 (1) L8 (2) L8 (3) L8 (4) L8 (5)
+  __asm__ volatile ("" ::: "memory");
+  S8 (5) S8 (4) S8 (3) S8 (2) S8 (1)
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-abi-20.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-20.c
new file mode 100644
index 000000000..d55760e81
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-20.c
@@ -0,0 +1,33 @@
+/* Xenon VMX128 ABI (plan 4.3): out-of-line saves in a leaf without a stack
+   frame.  Optimizing for size, a leaf that only clobbers v125-v127 calls
+   _savevr128_125 / _restvr128_125 with r0 = r1: the slots are in the red
+   zone, the routine uses no stack, and the call only needs LR saved in the
+   caller's frame header.  (With two registers a leaf that saves LR only
+   for the routine saves them inline: xenon-abi-25.c, s345-fix finding 6.)
+   With more callee-saved registers (r31, f31, v31) the VMX128 area sits
+   below the AltiVec one; the out-of-line FPR restore saves LR anyway, so
+   two registers go out of line there.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-Os -maltivec -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler-times {\mbl _savevr128_125\M} 1 } } */
+/* { dg-final { scan-assembler-times {\mbl _restvr128_125\M} 1 } } */
+/* { dg-final { scan-assembler-times {\mbl _savevr128_126\M} 1 } } */
+/* { dg-final { scan-assembler-times {\mbl _restvr128_126\M} 1 } } */
+/* { dg-final { scan-assembler {\mmr 0,1\M} } } */
+/* { dg-final { scan-assembler {\maddi 0,1,-32\M} } } */
+/* { dg-final { scan-assembler-not {\mstdu\M} } } */
+/* { dg-final { scan-assembler {\.cfi_offset 215, -16\M} } } */
+/* { dg-final { scan-assembler {\.cfi_offset 215, -48\M} } } */
+/* { dg-final { scan-assembler {\.cfi_offset 108, -32\M} } } */
+
+void
+leaf3 (void)
+{
+  __asm__ volatile ("# clobbers v125 v126 v127" ::: "v125", "v126", "v127");
+}
+
+void
+leaf_mixed (void)
+{
+  __asm__ volatile ("# clobbers" ::: "v126", "v127", "r31", "fr31", "v31");
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-abi-21.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-21.c
new file mode 100644
index 000000000..27c936a85
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-21.c
@@ -0,0 +1,37 @@
+/* Xenon VMX128 ABI (s345-fix finding 1): in a frame over 32 KiB the
+   epilogue restores v64-v127 through r11 (the back chain) before popping
+   the frame, because their slots are below the 288-byte red zone.  The
+   stack pointer restore (mr 1,11) must stay after the restores: a stack
+   tie keeps sched2 from moving it above them (it did, both above the
+   out-of-line bl _restvr128_N and above inline lvx128 restores), which
+   read deallocated stack and put the REG_CFA_RESTORE notes too early.
+   20 vectors live across the call: out of line by default (threshold 16).
+   Each file holds one function, so a match spanning "mr 1,11" and a later
+   restore can only be a restore after the pop.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler {\mbl _restvr128_108\M} } } */
+/* { dg-final { scan-assembler {\mld 11,0\(1\)} } } */
+/* { dg-final { scan-assembler {\mmr 1,11\M} } } */
+/* { dg-final { scan-assembler-not {\mmr 1,11\n(?:[^\n]*\n)*?[^\n]*(?:_restvr128_|lvx128 [0-9]+,11,0)} } } */
+/* The CFI restores of v108-v127 (columns 196-215) come after the restore.  */
+/* { dg-final { scan-assembler-not {\.cfi_restore 215\n(?:[^\n]*\n)*?[^\n]*_restvr128_} } } */
+
+typedef __attribute__ ((vector_size (16))) float v4sf;
+void h (void *);
+int loc (int);
+
+#define L4(b) v4sf x##b##0 = a[b*4+0], x##b##1 = a[b*4+1], \
+  x##b##2 = a[b*4+2], x##b##3 = a[b*4+3];
+#define S4(b) o[b*4+0] = x##b##3; o[b*4+1] = x##b##2; \
+  o[b*4+2] = x##b##1; o[b*4+3] = x##b##0;
+
+int
+big_ool (v4sf *restrict o, const v4sf *restrict a, int z)
+{
+  char buf[40000];
+  L4 (0) L4 (1) L4 (2) L4 (3) L4 (4)
+  h (buf);
+  S4 (0) S4 (1) S4 (2) S4 (3) S4 (4)
+  return loc (z);
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-abi-22.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-22.c
new file mode 100644
index 000000000..f0c23345e
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-22.c
@@ -0,0 +1,31 @@
+/* Xenon VMX128 ABI (s345-fix finding 1, inline restores): as
+   xenon-abi-21.c, with --param=xenon-vmx128-ool-threshold=0, so that the
+   20 registers are restored inline (li 0,OFF; lvx128 vN,11,0) before the
+   frame is popped by mr 1,11; sched2 moved the pop above some of them.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon --param=xenon-vmx128-ool-threshold=0" } */
+/* { dg-final { scan-assembler-times {\mlvx128 (10[89]|11[0-9]|12[0-7]),11,0\M} 20 } } */
+/* { dg-final { scan-assembler {\mld 11,0\(1\)} } } */
+/* { dg-final { scan-assembler {\mmr 1,11\M} } } */
+/* { dg-final { scan-assembler-not {\m_restvr128_} } } */
+/* { dg-final { scan-assembler-not {\mmr 1,11\n(?:[^\n]*\n)*?[^\n]*\mlvx128 [0-9]+,11,0} } } */
+/* { dg-final { scan-assembler-not {\.cfi_restore 215\n(?:[^\n]*\n)*?[^\n]*\mlvx128 [0-9]+,11,0} } } */
+
+typedef __attribute__ ((vector_size (16))) float v4sf;
+void h (void *);
+int loc (int);
+
+#define L4(b) v4sf x##b##0 = a[b*4+0], x##b##1 = a[b*4+1], \
+  x##b##2 = a[b*4+2], x##b##3 = a[b*4+3];
+#define S4(b) o[b*4+0] = x##b##3; o[b*4+1] = x##b##2; \
+  o[b*4+2] = x##b##1; o[b*4+3] = x##b##0;
+
+int
+big_inline (v4sf *restrict o, const v4sf *restrict a, int z)
+{
+  char buf[40000];
+  L4 (0) L4 (1) L4 (2) L4 (3) L4 (4)
+  h (buf);
+  S4 (0) S4 (1) S4 (2) S4 (3) S4 (4)
+  return loc (z);
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-abi-23.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-23.c
new file mode 100644
index 000000000..6abb3b01c
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-23.c
@@ -0,0 +1,19 @@
+/* Xenon VMX128 ABI (s345-fix finding 5): at -O0 a __builtin_eh_return
+   function has a frame pointer and pops its frame with addi 1,31,SIZE.
+   The EH data registers r3-r6 are loaded from slots below the VMX128 area
+   (SP0-1536 .. SP0-1512), far below the 288-byte red zone: they must be
+   loaded before the pop (through r31), not from deallocated stack after
+   it.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O0 -maltivec -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler-times {\mld [3-6],[0-9]+\(31\)} 4 } } */
+/* { dg-final { scan-assembler {\maddi 1,31,1[0-9]{3}\M} } } */
+/* { dg-final { scan-assembler-not {\mld [3-6],-[0-9]+\(1\)} } } */
+/* { dg-final { scan-assembler-not {\maddi 1,31,[0-9]+\n(?:[^\n]*\n)*?\tld [3-6],} } } */
+
+void
+eh_ret (long offset, void *handler)
+{
+  __builtin_unwind_init ();
+  __builtin_eh_return (offset, handler);
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-abi-24.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-24.c
new file mode 100644
index 000000000..0898adafe
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-24.c
@@ -0,0 +1,15 @@
+/* Xenon VMX128 ABI (s345-fix finding 5): as xenon-abi-23.c, optimized,
+   with a frame pointer.  The EH data words below the VMX128 area are read
+   before the frame is popped (addi 1,31,SIZE).  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -fno-omit-frame-pointer -maltivec -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler-times {\mld [3-6],[0-9]+\(31\)} 4 } } */
+/* { dg-final { scan-assembler {\maddi 1,31,1[0-9]{3}\M} } } */
+/* { dg-final { scan-assembler-not {\maddi 1,31,[0-9]+\n(?:[^\n]*\n)*?\tld [3-6],} } } */
+
+void
+eh_ret (long offset, void *handler)
+{
+  __builtin_unwind_init ();
+  __builtin_eh_return (offset, handler);
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-abi-25.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-25.c
new file mode 100644
index 000000000..054798263
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-25.c
@@ -0,0 +1,38 @@
+/* Xenon VMX128 ABI (s345-fix finding 6): at -Os the out-of-line
+   _savevr128_N/_restvr128_N routines are used from two registers only
+   when LR is saved anyway (a call, or another out-of-line routine);
+   otherwise the bl costs mflr/std/ld/mtlr, so a leaf saves two registers
+   inline (8 instructions either way, no calls, no LR slot) and goes out
+   of line from three.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-Os -maltivec -mdejagnu-cpu=xenon" } */
+/* leaf2: v126, v127 inline from the red zone; no LR traffic.  */
+/* { dg-final { scan-assembler-times {\mstvx128 12[67],1,0\M} 2 } } */
+/* { dg-final { scan-assembler-times {\mlvx128 12[67],1,0\M} 2 } } */
+/* leaf3: v125-v127 out of line; call2: v126, v127 out of line.  */
+/* { dg-final { scan-assembler-times {\mbl _savevr128_125\M} 1 } } */
+/* { dg-final { scan-assembler-times {\mbl _restvr128_125\M} 1 } } */
+/* { dg-final { scan-assembler-times {\mbl _savevr128_126\M} 1 } } */
+/* { dg-final { scan-assembler-times {\mbl _restvr128_126\M} 1 } } */
+/* { dg-final { scan-assembler-times {\mmflr 0\M} 2 } } */
+
+void g (void);
+
+void
+leaf2 (void)
+{
+  __asm__ volatile ("# clobbers v126 v127" ::: "v126", "v127");
+}
+
+void
+leaf3 (void)
+{
+  __asm__ volatile ("# clobbers v125 v126 v127" ::: "v125", "v126", "v127");
+}
+
+void
+call2 (void)
+{
+  __asm__ volatile ("# clobbers v126 v127" ::: "v126", "v127");
+  g ();
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-abi-3.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-3.c
new file mode 100644
index 000000000..89441d074
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-3.c
@@ -0,0 +1,26 @@
+/* Xenon VMX128 ABI (plan 4.3): optimizing for size, a function that saves
+   two or more of v64-v127, all from the first one to v127, calls the
+   out-of-line libgcc routines: r0 = end of the save area, then
+   bl _savevr128_N / bl _restvr128_N (libgcc/config/rs6000/crtsavevr128.S).
+   The CFI still describes each register's slot.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-Os -maltivec -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler-times {\mbl _savevr128_122\M} 1 } } */
+/* { dg-final { scan-assembler-times {\mbl _restvr128_122\M} 1 } } */
+/* { dg-final { scan-assembler {\maddi 0,1,} } } */
+/* { dg-final { scan-assembler-not {\mstvx128 [0-9]+,1,0\M} } } */
+/* { dg-final { scan-assembler-not {\mlvx128 [0-9]+,1,0\M} } } */
+/* { dg-final { scan-assembler {\.cfi_offset 215, } } } */
+/* { dg-final { scan-assembler {\.cfi_offset 210, } } } */
+
+typedef __attribute__ ((vector_size (16))) float v4sf;
+
+void g (void);
+
+void
+keep6 (v4sf *restrict o, const v4sf *restrict a)
+{
+  v4sf x0 = a[0], x1 = a[1], x2 = a[2], x3 = a[3], x4 = a[4], x5 = a[5];
+  g ();
+  o[0] = x5; o[1] = x4; o[2] = x3; o[3] = x2; o[4] = x1; o[5] = x0;
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-abi-4.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-4.c
