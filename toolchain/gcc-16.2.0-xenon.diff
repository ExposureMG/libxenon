+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler-times {\mlvx128\M} 32 } } */
+/* { dg-final { scan-assembler-times {\mstvx128\M} 32 } } */
