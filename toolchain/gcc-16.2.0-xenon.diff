index 000000000..a389ff6d1
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-recip-3.c
@@ -0,0 +1,13 @@
+/* -mrecip (default precision) on Xenon: fres for SFmode division, no
+   frsqrte for DFmode (low-precision estimates), never fre/frsqrtes.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -ffast-math -mrecip -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler-not {\mfre\M} } } */
+/* { dg-final { scan-assembler-not {\mfrsqrtes\M} } } */
+/* { dg-final { scan-assembler {\mfres\M} } } */
+/* { dg-final { scan-assembler {\mfdiv\M} } } */
+
+float divf (float a, float b) { return a / b; }
+double divd (double a, double b) { return a / b; }
+float rsqrtf (float a) { return 1.0f / __builtin_sqrtf (a); }
+double rsqrtd (double a) { return 1.0 / __builtin_sqrt (a); }
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-recip-4.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-recip-4.c
new file mode 100644
index 000000000..f351141d8
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-recip-4.c
@@ -0,0 +1,15 @@
+/* -mcpu=xenon never turns -mrecip-precision on: -mrecip=all keeps the
+   standard Newton-Raphson step counts for the 8-bit fres and 9-bit frsqrte
+   estimates (isa/FINDINGS.md 1.2).  With -mrecip-precision the single
+   division would take one step instead of two and the double rsqrt two
+   instead of three; the step counts are checked through the number of
+   fused multiply-adds.  */
+/* { dg-do compile { target { powerpc*-*-* && lp64 } } } */
+/* { dg-options "-Ofast -mrecip=all -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler {\mfres\M} } } */
+/* { dg-final { scan-assembler {\mfrsqrte\M} } } */
+/* { dg-final { scan-assembler-times {\mf(n?m(add|sub))s\M} 5 } } */
+/* { dg-final { scan-assembler-times {\mf(n?m(add|sub))\M} 11 } } */
+
+float rf (float a, float b) { return a / b; }
+double rs (double x) { return 1.0 / __builtin_sqrt (x); }
