+/* { dg-options "-O2 -mdejagnu-cpu=cell -maltivec -mxenon-smt=busy -fsched-verbose=2 -fdump-rtl-sched2" } */
+/* { dg-warning "'-mxenon-smt=' only affects code tuned for Xenon" "" { target *-*-* } 0 } */
