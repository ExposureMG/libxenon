+   shorter algebraic load stays.  */
+/* { dg-do compile { target { powerpc*-*-* && lp64 } } } */
+/* { dg-options "-Os -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler {\mlwax?\M} } } */
+/* { dg-final { scan-assembler {\mlhax?\M} } } */
