index 000000000..06ff4bfc9
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-popcount.c
@@ -0,0 +1,16 @@
+/* Xenon has no popcntb (nor popcntw/popcntd): __builtin_popcount and
+   __builtin_parity expand to generic code.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler-not {\mpopcnt[bwd]\M} } } */
+/* { dg-final { scan-assembler-not {\mprty[wd]\M} } } */
+/* { dg-final { scan-assembler-not {\mcmpb\M} } } */
+
+int pop32 (unsigned int x) { return __builtin_popcount (x); }
+int pop64 (unsigned long x) { return __builtin_popcountl (x); }
+int pop64ll (unsigned long long x) { return __builtin_popcountll (x); }
+int par32 (unsigned int x) { return __builtin_parity (x); }
+int par64 (unsigned long x) { return __builtin_parityl (x); }
+int ctz32 (unsigned int x) { return __builtin_ctz (x); }
+int ffs64 (long x) { return __builtin_ffsl (x); }
+int clz64 (unsigned long x) { return __builtin_clzl (x); }
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-recip-1.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-recip-1.c
new file mode 100644
index 000000000..65c077034
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-recip-1.c
@@ -0,0 +1,28 @@
+/* Xenon has fres and frsqrte but no fre and no frsqrtes (both raise the
+   illegal-instruction interrupt), so TARGET_FRE and TARGET_FRSQRTES are
+   false and -mrecip may use only the estimates that exist: fres for SFmode
+   division and frsqrte for DFmode reciprocal square roots.  DFmode division
+   and SFmode reciprocal square roots keep fdiv / fsqrts + fres.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -ffast-math -mrecip=all -maltivec -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler-not {\mfre\M} } } */
+/* { dg-final { scan-assembler-not {\mfre\.} } } */
+/* { dg-final { scan-assembler-not {\mfrsqrtes\M} } } */
+/* { dg-final { scan-assembler-not {\mx[sv][a-z]+} } } */
+/* { dg-final { scan-assembler {\mfres\M} } } */
+/* { dg-final { scan-assembler {\mfrsqrte\M} } } */
+/* { dg-final { scan-assembler {\mfdiv\M} } } */
+/* { dg-final { scan-assembler {\mvrefp\M} } } */
+/* { dg-final { scan-assembler {\mvrsqrtefp\M} } } */
+
+#include <altivec.h>
+
+float divf (float a, float b) { return a / b; }
+double divd (double a, double b) { return a / b; }
+float rsqrtf (float a) { return 1.0f / __builtin_sqrtf (a); }
+double rsqrtd (double a) { return 1.0 / __builtin_sqrt (a); }
+float sqrtf_ (float a) { return __builtin_sqrtf (a); }
+double sqrtd_ (double a) { return __builtin_sqrt (a); }
+
+vector float vre (vector float a) { return vec_re (a); }
+vector float vrsqrte (vector float a) { return vec_rsqrte (a); }
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-recip-2.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-recip-2.c
new file mode 100644
index 000000000..dfbd325bb
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-recip-2.c
@@ -0,0 +1,18 @@
+/* Without -mrecip, -ffast-math on Xenon divides and takes square roots with
+   fdivs/fdiv/fsqrts/fsqrt and uses no estimate instruction Xenon lacks;
+   the default -mrecip (low precision) leaves DFmode rsqrt alone as well.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -ffast-math -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler-not {\mfre\M} } } */
+/* { dg-final { scan-assembler-not {\mfrsqrtes\M} } } */
+/* { dg-final { scan-assembler-not {\mfrsqrte\M} } } */
+/* { dg-final { scan-assembler-not {\mfres\M} } } */
+/* { dg-final { scan-assembler {\mfdivs\M} } } */
+/* { dg-final { scan-assembler {\mfdiv\M} } } */
+/* { dg-final { scan-assembler {\mfsqrt\M} } } */
+/* { dg-final { scan-assembler {\mfsqrts\M} } } */
+
+float divf (float a, float b) { return a / b; }
+double divd (double a, double b) { return a / b; }
+float rsqrtf (float a) { return 1.0f / __builtin_sqrtf (a); }
+double sqrtd_ (double a) { return __builtin_sqrt (a); }
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-recip-3.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-recip-3.c
