diff --git gcc-16.2.0/gcc/testsuite/g++.target/powerpc/xenon-builtins-1.C gcc/gcc/testsuite/g++.target/powerpc/xenon-builtins-1.C
new file mode 100644
index 000000000..14af9e74f
--- /dev/null
+++ gcc/gcc/testsuite/g++.target/powerpc/xenon-builtins-1.C
@@ -0,0 +1,52 @@
+// Xenon VMX128-only builtins (step 7): <xenon_vmx.h> in C++, clean with
+// -Wall -Wextra -pedantic, and the overloaded builtins resolve in C++.
+// { dg-do compile { target powerpc*-*-* } }
+// { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon -std=c++17 -Wall -Wextra -pedantic" }
+
+// { dg-final { scan-assembler {\mvmsum3fp128 } } }
+// { dg-final { scan-assembler {\mvrlimi128 [0-9]+,[0-9]+,15,1$} } }
+// { dg-final { scan-assembler {\mvpermwi128 [0-9]+,[0-9]+,27$} } }
+// { dg-final { scan-assembler {\mvpkd3d128 [0-9]+,[0-9]+,1,1,2$} } }
+// { dg-final { scan-assembler {\mvupkd3d128 [0-9]+,[0-9]+,4$} } }
+
+#include <xenon_vmx.h>
+
+typedef __vector float vf;
+typedef __vector unsigned int vui;
+
+template <typename T>
+T
+rot1 (T d, T b)
+{
+  return xenon_vrlimi (d, b, XENON_MASK_XYZW, 1);
+}
+
+vf
+dot3 (vf a, vf b)
+{
+  return xenon_vmsum3fp (a, b);
+}
+
+vui
+f (vui d, vui b)
+{
+  return rot1 (d, b);
+}
+
+vf
+g (vf b)
+{
+  return xenon_vswizzle (b, 0, 1, 2, 3);
+}
+
+vui
+h (vui d, vf b)
+{
+  return xenon_vpkd3d (d, b, XENON_D3D_NORMSHORT2, XENON_PACK_32, 2);
+}
+
+vf
+k (vui b)
+{
+  return xenon_vupkd3d (b, XENON_D3D_NORMSHORT2);
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-abi-1.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-1.c
new file mode 100644
index 000000000..e4ab1e9f2
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-abi-1.c
@@ -0,0 +1,28 @@
+/* Xenon VMX128 ABI (plan 4.3): v64-v127 are callee-saved.  Six vector
+   values that live across a call and only move take v127 down to v122
+   (xenon-regs-9.c); the prologue saves exactly those six with stvx128 and
+   the offset in r0, the epilogue restores them with lvx128 from the same
+   slots, and the CFI describes the saves (.eh_frame numbers 120 + N - 32:
+   v122 = 210, v127 = 215).  No other vector register is saved.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler-times {\mstvx128 (12[2-7]),1,0\M} 6 } } */
+/* { dg-final { scan-assembler-times {\mlvx128 (12[2-7]),1,0\M} 6 } } */
+/* { dg-final { scan-assembler-not {\mstvx128 ([3-9][0-9]|1[01][0-9]|12[01]),1,} } } */
+/* { dg-final { scan-assembler-not {\mstvx\M} } } */
+/* { dg-final { scan-assembler {\.cfi_offset 215, } } } */
+/* { dg-final { scan-assembler {\.cfi_offset 210, } } } */
+/* { dg-final { scan-assembler-not {\.cfi_offset (209|1[2-9][0-9]|20[0-8]), } } } */
+/* { dg-final { scan-assembler-not {\m_savevr128_} } } */
+
+typedef __attribute__ ((vector_size (16))) float v4sf;
+
+void g (void);
+
+void
+keep6 (v4sf *restrict o, const v4sf *restrict a)
+{
+  v4sf x0 = a[0], x1 = a[1], x2 = a[2], x3 = a[3], x4 = a[4], x5 = a[5];
+  g ();
+  o[0] = x5; o[1] = x4; o[2] = x3; o[3] = x2; o[4] = x1; o[5] = x0;
+}
