diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-sync.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-sync.c
new file mode 100644
index 000000000..2356eabd9
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-sync.c
@@ -0,0 +1,38 @@
+/* Xenon executes lwsync (32 cycles against 162 for sync), so acquire and
+   release fences use it; sequentially consistent ones use sync.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler {\mlwsync\M} } } */
+/* { dg-final { scan-assembler {\msync\M} } } */
+/* { dg-final { scan-assembler {\mlwarx\M} } } */
+/* { dg-final { scan-assembler {\mldarx\M} } } */
+/* { dg-final { scan-assembler-not {\m(lbarx|lharx|lqarx|stbcx|sthcx|stqcx)\M} } } */
+/* { dg-final { scan-assembler-not {\mmcrxr\M} } } */
+
+int x;
+long y;
+
+void fence_acq (void) { __atomic_thread_fence (__ATOMIC_ACQUIRE); }
+void fence_rel (void) { __atomic_thread_fence (__ATOMIC_RELEASE); }
+void fence_acq_rel (void) { __atomic_thread_fence (__ATOMIC_ACQ_REL); }
+void fence_sc (void) { __atomic_thread_fence (__ATOMIC_SEQ_CST); }
+int load_acq (void) { return __atomic_load_n (&x, __ATOMIC_ACQUIRE); }
+void store_rel (int v) { __atomic_store_n (&x, v, __ATOMIC_RELEASE); }
+int fetch_add (int v) { return __atomic_fetch_add (&x, v, __ATOMIC_ACQ_REL); }
+long fetch_add_l (long v) { return __atomic_fetch_add (&y, v, __ATOMIC_SEQ_CST); }
+int cas (int o, int n)
+{
+  return __atomic_compare_exchange_n (&x, &o, n, 0, __ATOMIC_ACQUIRE,
+				      __ATOMIC_RELAXED);
+}
+char cas_c (char *p, char o, char n)
+{
+  __atomic_compare_exchange_n (p, &o, n, 0, __ATOMIC_SEQ_CST,
+			       __ATOMIC_SEQ_CST);
+  return o;
+}
+short xchg_s (short *p, short v)
+{
+  return __atomic_exchange_n (p, v, __ATOMIC_RELEASE);
+}
+void sync_sync (void) { __sync_synchronize (); }
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-vec-mul-1.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-vec-mul-1.c
new file mode 100644
index 000000000..21991f640
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-vec-mul-1.c
@@ -0,0 +1,66 @@
+/* Xenon (-mcpu=xenon): the AltiVec integer multiply, multiply-sum and
+   sum-across instructions do not exist, so integer multiply, widening
+   multiply, dot-product and reduction loops must be vectorized with the
+   replacement sequences (or not at all) and never use one of them.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O3 -ftree-vectorize -maltivec -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler-not {\mvmul[eo][su][bh]\M} } } */
+/* { dg-final { scan-assembler-not {\mvmsum[a-z]+\M} } } */
+/* { dg-final { scan-assembler-not {\mvmhr?addshs\M} } } */
+/* { dg-final { scan-assembler-not {\mvmladduhm\M} } } */
+/* { dg-final { scan-assembler-not {\mvsum(4ubs|4sbs|4shs|2sws|sws)\M} } } */
+/* { dg-final { scan-assembler-not {\mvmuluwm\M} } } */
+/* The replacement sequences: exact single-precision products (vmulfp128
+   and the VMX128 forms of the conversions with -mvmx128, plan step 5).  */
+/* { dg-final { scan-assembler {\m(vcfux|vcuxwfp128)\M} } } */
+/* { dg-final { scan-assembler {\m(vcfsx|vcsxwfp128)\M} } } */
+/* { dg-final { scan-assembler {\m(vctuxs|vcfpuxws128)\M} } } */
+/* { dg-final { scan-assembler {\m(vctsxs|vcfpsxws128)\M} } } */
+/* { dg-final { scan-assembler {\mvmulfp128\M} } } */
+
+#define N 1024
+
+#define ARR(T, NAME) T NAME[N] __attribute__ ((aligned (16)))
+
+ARR (int, si1); ARR (int, si2); ARR (int, si3);
+ARR (unsigned int, ui1); ARR (unsigned int, ui2); ARR (unsigned int, ui3);
+ARR (short, ss1); ARR (short, ss2); ARR (short, ss3);
+ARR (unsigned short, us1); ARR (unsigned short, us2); ARR (unsigned short, us3);
+ARR (signed char, sc1); ARR (signed char, sc2); ARR (signed char, sc3);
+ARR (unsigned char, uc1); ARR (unsigned char, uc2); ARR (unsigned char, uc3);
+
+/* Same-width multiply (mulv4si3, mulv8hi3, mulv16qi3).  */
+void mul_si (void) { for (int i = 0; i < N; i++) si3[i] = si1[i] * si2[i]; }
+void mul_ui (void) { for (int i = 0; i < N; i++) ui3[i] = ui1[i] * ui2[i]; }
+void mul_ss (void) { for (int i = 0; i < N; i++) ss3[i] = ss1[i] * ss2[i]; }
+void mul_us (void) { for (int i = 0; i < N; i++) us3[i] = us1[i] * us2[i]; }
+void mul_sc (void) { for (int i = 0; i < N; i++) sc3[i] = sc1[i] * sc2[i]; }
+void mul_uc (void) { for (int i = 0; i < N; i++) uc3[i] = uc1[i] * uc2[i]; }
+
+/* Multiply by constants.  */
+void mulc_si (void) { for (int i = 0; i < N; i++) si3[i] = si1[i] * 12345; }
+void mulc_ss (void) { for (int i = 0; i < N; i++) ss3[i] = ss1[i] * -77; }
+void mulc_uc (void) { for (int i = 0; i < N; i++) uc3[i] = uc1[i] * 13; }
+
+/* Widening multiply (vec_widen_[su]mult_{hi,lo}).  */
+void wmul_ss (void) { for (int i = 0; i < N; i++) si3[i] = ss1[i] * ss2[i]; }
+void wmul_us (void)
+{
+  for (int i = 0; i < N; i++)
+    ui3[i] = (unsigned int) us1[i] * us2[i];
+}
+void wmul_sc (void) { for (int i = 0; i < N; i++) ss3[i] = sc1[i] * sc2[i]; }
+void wmul_uc (void) { for (int i = 0; i < N; i++) us3[i] = uc1[i] * uc2[i]; }
+void wmul_sc_si (void) { for (int i = 0; i < N; i++) si3[i] = sc1[i] * sc2[i]; }
+
+/* Multiply-add.  */
+void madd_si (void)
+{
+  for (int i = 0; i < N; i++)
+    si3[i] += si1[i] * si2[i];
+}
+void madd_ss (void)
+{
+  for (int i = 0; i < N; i++)
+    ss3[i] += ss1[i] * ss2[i];
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-vec-mul-2.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-vec-mul-2.c
new file mode 100644
index 000000000..90d3c92ae
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-vec-mul-2.c
@@ -0,0 +1,146 @@
+/* Xenon: dot products, widening sums and reductions (sdot_prod, udot_prod,
+   widen_[su]sum, reduc_plus_scal) must not use vmsum* or vsum*.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O3 -ftree-vectorize -maltivec -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler-not {\mvmul[eo][su][bh]\M} } } */
+/* { dg-final { scan-assembler-not {\mvmsum[a-z]+\M} } } */
+/* { dg-final { scan-assembler-not {\mvmhr?addshs\M} } } */
+/* { dg-final { scan-assembler-not {\mvmladduhm\M} } } */
+/* { dg-final { scan-assembler-not {\mvsum(4ubs|4sbs|4shs|2sws|sws)\M} } } */
+
+#define N 1024
+
+#define ARR(T, NAME) T NAME[N] __attribute__ ((aligned (16)))
+
+ARR (int, si1); ARR (int, si2);
+ARR (unsigned int, ui1);
+ARR (short, ss1); ARR (short, ss2);
+ARR (unsigned short, us1); ARR (unsigned short, us2);
+ARR (signed char, sc1); ARR (signed char, sc2);
+ARR (unsigned char, uc1); ARR (unsigned char, uc2);
+
+int dot_ss (void)
+{
+  int s = 0;
+  for (int i = 0; i < N; i++)
+    s += ss1[i] * ss2[i];
+  return s;
+}
+
+unsigned int dot_us (void)
+{
+  unsigned int s = 0;
+  for (int i = 0; i < N; i++)
+    s += (unsigned int) us1[i] * us2[i];
+  return s;
+}
+
+int dot_sc (void)
+{
+  int s = 0;
+  for (int i = 0; i < N; i++)
+    s += sc1[i] * sc2[i];
+  return s;
+}
+
+unsigned int dot_uc (void)
+{
+  unsigned int s = 0;
+  for (int i = 0; i < N; i++)
+    s += uc1[i] * uc2[i];
+  return s;
+}
+
+int dot_si (void)
+{
+  int s = 0;
+  for (int i = 0; i < N; i++)
+    s += si1[i] * si2[i];
+  return s;
+}
+
+/* Widening sums (widen_ssum / widen_usum).  */
+int wsum_ss (void)
+{
+  int s = 0;
+  for (int i = 0; i < N; i++)
+    s += ss1[i];
+  return s;
+}
+
+unsigned int wsum_uc (void)
+{
+  unsigned int s = 0;
+  for (int i = 0; i < N; i++)
+    s += uc1[i];
+  return s;
+}
+
+int wsum_sc (void)
+{
+  int s = 0;
+  for (int i = 0; i < N; i++)
+    s += sc1[i];
+  return s;
+}
+
+/* Same-width reductions (reduc_plus_scal_<mode>).  */
+short sum_ss (void)
+{
+  short s = 0;
+  for (int i = 0; i < N; i++)
+    s += ss1[i];
+  return s;
+}
+
+signed char sum_sc (void)
+{
+  signed char s = 0;
+  for (int i = 0; i < N; i++)
+    s += sc1[i];
+  return s;
+}
+
+int sum_si (void)
+{
+  int s = 0;
+  for (int i = 0; i < N; i++)
+    s += si1[i];
+  return s;
+}
+
+unsigned int sum_ui (void)
+{
+  unsigned int s = 0;
+  for (int i = 0; i < N; i++)
+    s += ui1[i];
+  return s;
+}
+
+/* Sum of absolute differences.  */
+int sad_uc (void)
+{
+  int s = 0;
+  for (int i = 0; i < N; i++)
