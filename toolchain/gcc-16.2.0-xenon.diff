diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-vmx128-10.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-vmx128-10.c
new file mode 100644
index 000000000..62cd4c2aa
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-vmx128-10.c
@@ -0,0 +1,31 @@
+/* Xenon VMX128 (s345-fix finding 10): which spellings of an under-aligned
+   vector type reach the misaligned-access code (lvlx/lvrx + vor,
+   stvlx/stvrx; plan 4.2 movmisalign).  aligned (N < 16) is honoured on a
+   vector_size typedef and on a typedef of an existing vector typedef (also
+   one spelled with __vector), but has no effect on a typedef that uses the
+   AltiVec keyword itself, as for every AltiVec CPU (documented under
+   -mvmx128 in invoke.texi): that type keeps 16-byte alignment and its
+   accesses are plain lvx/stvx, which ignore EA[28:31].  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon" } */
+/* a1, a2: left/right loads and stores.  */
+/* { dg-final { scan-assembler-times {\mlvlx(128)? } 2 } } */
+/* { dg-final { scan-assembler-times {\mlvrx(128)? } 2 } } */
+/* { dg-final { scan-assembler-times {\mstvlx(128)? } 2 } } */
+/* { dg-final { scan-assembler-times {\mstvrx(128)? } 2 } } */
+/* a3: the AltiVec-keyword typedef stays aligned: lvx/stvx.  */
+/* { dg-final { scan-assembler-times {\mlvx(128)? } 1 } } */
+/* { dg-final { scan-assembler-times {\mstvx(128)? } 1 } } */
+
+typedef float vf4u __attribute__ ((vector_size (16), aligned (4)));
+typedef __vector float vfa;
+typedef vfa vfau __attribute__ ((aligned (4)));
+typedef __vector float vfk __attribute__ ((aligned (4)));
+
+_Static_assert (__alignof__ (vf4u) == 4, "vector_size + aligned (4)");
+_Static_assert (__alignof__ (vfau) == 4, "typedef of a vector typedef");
+_Static_assert (__alignof__ (vfk) == 16, "__vector keyword typedef");
+
+void a1 (vf4u *d, const vf4u *s) { *d = *s; }
+void a2 (vfau *d, const vfau *s) { *d = *s; }
+void a3 (vfk *d, const vfk *s) { *d = *s; }
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-vmx128-11.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-vmx128-11.c
new file mode 100644
index 000000000..108c55df8
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-vmx128-11.c
@@ -0,0 +1,61 @@
+/* Xenon (s345-fix finding 8), with -mno-vmx128 (the fix is keyed on
+   -mcpu=xenon, not on VMX128): the Cell store builtins write only part of
+   the 16 bytes at EA (FINDINGS 1.4): vec_stvlx the bytes from EA to the
+   end of EA's quadword, vec_stvrx those from the start of EA's quadword
+   up to EA - 1.  With -mcpu=xenon they are BLKmode stores of unknown size,
+   so DSE no longer deletes earlier stores to bytes they leave alone (the
+   patterns claimed a 16-byte store at each EA).  The unaligned store of
+   16 bytes at buf + 1 (bytes 4-19) never touches buf[5] (bytes 20-23).  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon -mno-vmx128" } */
+/* test: the store of 1.0f to buf[5] survives.  */
+/* { dg-final { scan-assembler {\mst(w|fs) [0-9]+,20\(3\)} } } */
+/* t4: p[4] (bytes 16-19) survives vec_stvrx (v, 16, p), which stores
+   nothing when p is 16-byte aligned.  */
+/* { dg-final { scan-assembler {\mst(w|fs) [0-9]+,16\(3\)} } } */
+/* t2: p[2] survives vec_stvlx (v, 0, p).  */
+/* { dg-final { scan-assembler {\mst(w|fs) [0-9]+,8\(3\)} } } */
+/* tl: the LRU-hint forms; c[16] survives.  */
+/* { dg-final { scan-assembler {\mstb [0-9]+,16\(3\)} } } */
+/* { dg-final { scan-assembler-times {\mstvlx\M} 2 } } */
+/* { dg-final { scan-assembler-times {\mstvrx\M} 2 } } */
+/* { dg-final { scan-assembler-times {\mstvlxl\M} 1 } } */
+/* { dg-final { scan-assembler-times {\mstvrxl\M} 1 } } */
+
+#include <altivec.h>
+
+static inline void
+store_unaligned (float *p, vector float v)
+{
+  vec_stvlx (v, 0, p);
+  vec_stvrx (v, 16, p);
+}
+
+void
+test (float *buf, vector float v)
+{
+  buf[5] = 1.0f;
+  store_unaligned (buf + 1, v);
+}
+
+void
+t4 (float *p, vector float v)
+{
+  p[4] = 7.0f;
+  vec_stvrx (v, 16, p);
+}
+
+void
+t2 (float *p, vector float v)
+{
+  p[2] = 7.0f;
+  vec_stvlx (v, 0, p);
+}
+
+void
+tl (unsigned char *c, vector unsigned char v)
+{
+  c[16] = 9;
+  vec_stvlxl (v, 0, c);
+  vec_stvrxl (v, 16, c);
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-vmx128-2.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-vmx128-2.c
new file mode 100644
index 000000000..d74cefae7
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-vmx128-2.c
@@ -0,0 +1,144 @@
+/* Xenon VMX128 (plan 4.2, step 5): the destructive VMX128 forms and
+   vperm128.  vmaddfp128 vD,vA,vB,vD = vA*vB + vD and vmaddcfp128
+   vD,vA,vD,vB = vA*vD + vB implement fma (the addend or a multiplicand
+   tied to the destination), vnmsubfp128 vD,vA,vB,vD = -(vA*vB - vD) the
+   negated fms, vsel128 vD,vA,vB,vD takes its mask from vD; vperm128's
+   control register is v0-v7 (wU), the legacy vperm's anything in v0-v31.
+   With every register in v0-v31 the legacy mnemonics are printed.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon" } */
+
+/* Addend tied.  */
+/* { dg-final { scan-assembler {\mvmaddfp128 42,4[01],4[01],42$} } } */
+/* Multiplicand tied (operand order vD,vA,vD,vB).  */
+/* { dg-final { scan-assembler {\mvmaddcfp128 41,40,41,42$} } } */
+/* { dg-final { scan-assembler {\mvmaddcfp128 40,41,40,42$} } } */
+/* { dg-final { scan-assembler {\mvnmsubfp128 42,4[01],4[01],42$} } } */
+/* { dg-final { scan-assembler {\mvsel128 42,40,41,42$} } } */
+/* Result in a fresh register while the addend stays live: a copy, then
+   a tied form.  */
+/* { dg-final { scan-assembler {\mvmadd(c)?fp128 43,[0-9]+,[0-9]+,[0-9]+$} } } */
+/* vperm128 with the control in v0-v7, copied there from v20.  */
+/* { dg-final { scan-assembler {\mvperm128 42,40,41,[0-7]$} } } */
+/* { dg-final { scan-assembler-not {\mvperm128 [0-9]+,[0-9]+,[0-9]+,([89]|[1-9][0-9]+)$} } } */
+/* The same operations with every register in v0-v31: legacy forms; the
+   legacy vperm takes its control from v20 directly.  */
+/* { dg-final { scan-assembler {\mvmaddfp 6,4,5,6$} } } */
+/* { dg-final { scan-assembler {\mvnmsubfp 6,4,5,6$} } } */
+/* { dg-final { scan-assembler {\mvsel 6,4,5,6$} } } */
+/* { dg-final { scan-assembler {\mvperm 6,4,5,20$} } } */
+/* No legacy mnemonic with a v32+ operand.  */
+/* { dg-final { scan-assembler-not {^\t(v[a-z]+|lv[a-z]+|stv[a-z]+)\.? ([0-9]+,)*(3[2-9]|[4-9][0-9]|1[0-2][0-9])(,|$)} } } */
+
+#include <altivec.h>
+
+typedef __vector float vf;
+typedef __vector unsigned int vui;
+typedef __vector unsigned char vuc;
+
+#define IN3(T, A, B, C, RA, RB, RC)					\
+  register T A __asm__ (RA) = pa[0];					\
+  register T B __asm__ (RB) = pa[1];					\
+  register T C __asm__ (RC) = pa[2];					\
+  __asm__ ("" : "+wV" (A), "+wV" (B), "+wV" (C))
+
+void
+madd_addend (vf *pr, const vf *pa)
+{
+  IN3 (vf, a, b, c, "v40", "v41", "v42");
+  c = vec_madd (a, b, c);
+  __asm__ ("" : "+wV" (c));
+  *pr = c;
+}
+
+void
+madd_mult (vf *pr, const vf *pa)
+{
+  IN3 (vf, a, b, c, "v40", "v41", "v42");
+  b = vec_madd (a, b, c);
+  __asm__ ("" : "+wV" (b));
+  *pr = b;
+}
+
+void
+madd_mult1 (vf *pr, const vf *pa)
+{
+  IN3 (vf, a, b, c, "v40", "v41", "v42");
+  a = vec_madd (a, b, c);
+  __asm__ ("" : "+wV" (a));
+  *pr = a;
+}
+
+void
+madd_copy (vf *pr, const vf *pa)
+{
+  IN3 (vf, a, b, c, "v40", "v41", "v42");
+  register vf r __asm__ ("v43") = vec_madd (a, b, c);
+  __asm__ ("" : "+wV" (r), "+wV" (a), "+wV" (b), "+wV" (c));
+  pr[0] = r;
+  pr[1] = c;
+}
+
+void
+nmsub_tied (vf *pr, const vf *pa)
+{
+  IN3 (vf, a, b, c, "v40", "v41", "v42");
+  c = vec_nmsub (a, b, c);
+  __asm__ ("" : "+wV" (c));
+  *pr = c;
+}
+
+void
+sel_tied (vui *pr, const vui *pa)
+{
+  IN3 (vui, a, b, m, "v40", "v41", "v42");
+  m = vec_sel (a, b, m);
+  __asm__ ("" : "+wV" (m));
+  *pr = m;
+}
+
+void
+perm_hi (vuc *pr, const vuc *pa)
+{
+  IN3 (vuc, a, b, c, "v40", "v41", "v20");
+  register vuc r __asm__ ("v42") = vec_perm (a, b, c);
+  __asm__ ("" : "+wV" (r));
+  *pr = r;
+}
+
+/* Every register in v0-v31.  */
+void
+madd_lo (vf *pr, const vf *pa)
+{
+  IN3 (vf, a, b, c, "v4", "v5", "v6");
+  c = vec_madd (a, b, c);
+  __asm__ ("" : "+v" (c));
+  *pr = c;
+}
+
+void
+nmsub_lo (vf *pr, const vf *pa)
+{
+  IN3 (vf, a, b, c, "v4", "v5", "v6");
+  c = vec_nmsub (a, b, c);
+  __asm__ ("" : "+v" (c));
+  *pr = c;
+}
+
+void
+sel_lo (vui *pr, const vui *pa)
+{
+  IN3 (vui, a, b, m, "v4", "v5", "v6");
+  m = vec_sel (a, b, m);
+  __asm__ ("" : "+v" (m));
+  *pr = m;
+}
+
+void
+perm_lo (vuc *pr, const vuc *pa)
+{
+  IN3 (vuc, a, b, c, "v4", "v5", "v20");
+  register vuc r __asm__ ("v6") = vec_perm (a, b, c);
+  __asm__ ("" : "+v" (r));
+  *pr = r;
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-vmx128-3.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-vmx128-3.c
new file mode 100644
index 000000000..679404cbf
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-vmx128-3.c
@@ -0,0 +1,39 @@
+/* Xenon VMX128 (plan 4.2, step 5): fma and multiplication of vector float.
+   A V4SF multiply is vmulfp128 (the rounded product, FINDINGS 1.3), not
+   the vmaddfp with a -0.0 addend; a*b+c contracts to fma, which is
+   vmaddfp (v0-v31), vmaddfp128 (addend tied) or vmaddcfp128 (a
+   multiplicand tied); with -ffp-contract=off it stays vmulfp128 +
+   vaddfp.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O3 -maltivec -mdejagnu-cpu=xenon -ffp-contract=fast" } */
+/* { dg-final { scan-assembler {\mvmulfp128\M} } } */
+/* { dg-final { scan-assembler {\mvmadd(c)?fp(128)?\M} } } */
+/* { dg-final { scan-assembler-not {\mvspltisw(128)? [0-9]+,-1\M} } } */
+/* { dg-final { scan-assembler-not {\mvslw(128)?\M} } } */
+
+typedef __attribute__ ((vector_size (16))) float v4sf;
+
+v4sf mul (v4sf a, v4sf b) { return a * b; }
+v4sf fma3 (v4sf a, v4sf b, v4sf c) { return a * b + c; }
+
+#define N 1024
+float x[N] __attribute__ ((aligned (16)));
+float y[N] __attribute__ ((aligned (16)));
+float z[N] __attribute__ ((aligned (16)));
+
+void saxpy (float a) { for (int i = 0; i < N; i++) y[i] = a * x[i] + y[i]; }
+void vmul (void) { for (int i = 0; i < N; i++) z[i] = x[i] * y[i]; }
+
+/* Many live accumulators: v32-v127 and the tied 128 forms.  */
+void
+acc64 (v4sf *restrict o, const v4sf *restrict a, const v4sf *restrict b, int n)
+{
+  v4sf s[64];
+  for (int k = 0; k < 64; k++)
+    s[k] = o[k];
+  for (int j = 0; j < n; j++)
+    for (int k = 0; k < 64; k++)
+      s[k] = a[j * 64 + k] * b[k] + s[k];
+  for (int k = 0; k < 64; k++)
+    o[k] = s[k];
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-vmx128-4.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-vmx128-4.c
new file mode 100644
index 000000000..3777cf090
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-vmx128-4.c
@@ -0,0 +1,42 @@
+/* Xenon VMX128 (plan 4.2, step 5): misaligned vector accesses use
+   movmisalign (lvlx + lvrx + vor, stvlx + stvrx), not the lvsl + vperm
+   realignment, and the vectorizer uses them for loads and stores of
+   unknown alignment.  lvsl128/lvsr128 (illegal) never appear.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O3 -maltivec -mdejagnu-cpu=xenon -fno-vect-cost-model -fno-tree-loop-distribute-patterns" } */
+/* { dg-final { scan-assembler {\mlvlx(128)?\M} } } */
+/* { dg-final { scan-assembler {\mlvrx(128)?\M} } } */
+/* { dg-final { scan-assembler {\mstvlx(128)?\M} } } */
+/* { dg-final { scan-assembler {\mstvrx(128)?\M} } } */
+/* { dg-final { scan-assembler-not {\mlvs[lr](128)?\M} } } */
+/* { dg-final { scan-assembler-not {\mvperm(128)?\M} } } */
+
+typedef __attribute__ ((vector_size (16))) float v4sf;
+typedef __attribute__ ((vector_size (16), aligned (1))) float v4sf_u;
+typedef __attribute__ ((vector_size (16), aligned (1))) int v4si_u;
+
+/* Unknown alignment of both pointers.  */
+void
+copy (float *restrict d, const float *restrict s, int n)
+{
+  for (int i = 0; i < n; i++)
+    d[i] = s[i];
+}
+
+void
+scale (float *restrict d, const float *restrict s, float k, int n)
+{
+  for (int i = 0; i < n; i++)
+    d[i] = s[i] * k;
+}
+
+/* Known misalignment.  */
+float a[1028] __attribute__ ((aligned (16)));
+float b[1028] __attribute__ ((aligned (16)));
+void shift1 (void) { for (int i = 0; i < 1024; i++) b[i + 3] = a[i + 1] + 1.0f; }
+
+/* Explicitly under-aligned vector types.  */
+v4sf ld_u (const v4sf_u *p) { return *p; }
+void st_u (v4sf_u *p, v4sf v) { *p = v; }
+v4sf ld_u_idx (const float *p, long i) { return *(const v4sf_u *) (p + i); }
+void cp_u_i (v4si_u *d, const v4si_u *s) { *d = *s; }
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-vmx128-5.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-vmx128-5.c
new file mode 100644
index 000000000..de6963c67
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-vmx128-5.c
@@ -0,0 +1,30 @@
+/* Xenon VMX128 (plan 4.2, step 5): with -mno-vmx128 the compiler emits no
+   VMX128 instruction and no v32-v127, the multiply is the vmaddfp
+   sequence and misaligned accesses use no lvlx/lvrx (the old Xenon
+   output).  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O3 -maltivec -mdejagnu-cpu=xenon -mno-vmx128" } */
+/* { dg-final { scan-assembler-not {^\t[a-z]+128\.?\s} } } */
+/* { dg-final { scan-assembler {\mvmaddfp\M} } } */
+/* { dg-final { scan-assembler-not {\mlv[lr]x\M} } } */
+
+typedef __attribute__ ((vector_size (16))) float v4sf;
+v4sf mul (v4sf a, v4sf b) { return a * b; }
+v4sf fma3 (v4sf a, v4sf b, v4sf c) { return a * b + c; }
+void
+acc (v4sf *restrict o, const v4sf *restrict a, int n)
+{
+  v4sf s[40];
+  for (int k = 0; k < 40; k++)
+    s[k] = o[k];
+  for (int j = 0; j < n; j++)
+    for (int k = 0; k < 40; k++)
+      s[k] = a[j * 40 + k] * s[k] + a[k];
+  for (int k = 0; k < 40; k++)
+    o[k] = s[k];
+}
+void copy (float *restrict d, const float *restrict s, int n)
+{
+  for (int i = 0; i < n; i++)
+    d[i] = s[i] * 2.0f;
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-vmx128-6.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-vmx128-6.c
new file mode 100644
index 000000000..fe863b37a
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-vmx128-6.c
@@ -0,0 +1,51 @@
+/* Xenon VMX128 (plan 4.2, step 5): lvsl and lvsr stay legal and are
+   emitted in their legacy form only (lvsl128 and lvsr128 are illegal on
+   the hardware): a result wanted in v32-v127 is loaded into v0-v31 and
+   copied.  Legacy-only instructions (integer add, byte merges) never name
+   v32-v127 either.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler {\mlvsl [0-9],} } } */
+/* { dg-final { scan-assembler {\mlvsr [0-9]+,} } } */
+/* { dg-final { scan-assembler-not {\mlvs[lr]128\M} } } */
+/* { dg-final { scan-assembler {\mvor128 40,[0-9]+,[0-9]+$} } } */
+/* { dg-final { scan-assembler {\mvadduwm [0-9]+,[0-9]+,[0-9]+$} } } */
+/* { dg-final { scan-assembler {\mvmrghb [0-9]+,[0-9]+,[0-9]+$} } } */
+/* { dg-final { scan-assembler-not {^\t(v[a-z]+|lv[a-z]+|stv[a-z]+)\.? ([0-9]+,)*(3[2-9]|[4-9][0-9]|1[0-2][0-9])(,|$)} } } */
+
+#include <altivec.h>
+
+typedef __vector unsigned char vuc;
+typedef __vector signed int vsi;
+
+void
+lvsl_hi (vuc *pr, const unsigned char *p)
+{
+  register vuc r __asm__ ("v40") = vec_lvsl (0, p);
+  __asm__ ("" : "+wV" (r));
+  *pr = r;
+}
+
+vuc lvsr_lo (const unsigned char *p) { return vec_lvsr (5, p); }
+
+void
+add_hi (vsi *pr, const vsi *pa)
+{
+  register vsi a __asm__ ("v40") = pa[0];
+  register vsi b __asm__ ("v41") = pa[1];
+  __asm__ ("" : "+wV" (a), "+wV" (b));
+  register vsi r __asm__ ("v42") = vec_add (a, b);
+  __asm__ ("" : "+wV" (r));
+  *pr = r;
+}
+
+void
+mrgb_hi (vuc *pr, const vuc *pa)
+{
+  register vuc a __asm__ ("v40") = pa[0];
+  register vuc b __asm__ ("v41") = pa[1];
+  __asm__ ("" : "+wV" (a), "+wV" (b));
+  register vuc r __asm__ ("v42") = vec_mergeh (a, b);
+  __asm__ ("" : "+wV" (r));
+  *pr = r;
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-vmx128-7.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-vmx128-7.c
new file mode 100644
index 000000000..7c950133d
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-vmx128-7.c
@@ -0,0 +1,11 @@
+/* Xenon VMX128: without contraction a*b+c is vmulfp128 + vaddfp.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon -ffp-contract=off" } */
+/* { dg-final { scan-assembler-times {\mvmulfp128\M} 2 } } */
+/* { dg-final { scan-assembler-times {\mvaddfp(128)?\M} 1 } } */
+/* { dg-final { scan-assembler-not {\mvmadd(c)?fp(128)?\M} } } */
+
+typedef __attribute__ ((vector_size (16))) float v4sf;
+
+v4sf mul (v4sf a, v4sf b) { return a * b; }
+v4sf muladd (v4sf a, v4sf b, v4sf c) { return a * b + c; }
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-vmx128-8.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-vmx128-8.c
new file mode 100644
index 000000000..13c2e2365
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-vmx128-8.c
@@ -0,0 +1,60 @@
+/* Xenon (s345-fix finding 8): the Cell store builtins write only part of
+   the 16 bytes at EA (FINDINGS 1.4): vec_stvlx the bytes from EA to the
+   end of EA's quadword, vec_stvrx those from the start of EA's quadword
+   up to EA - 1.  With -mcpu=xenon they are BLKmode stores of unknown size,
+   so DSE no longer deletes earlier stores to bytes they leave alone (the
+   patterns claimed a 16-byte store at each EA).  The unaligned store of
+   16 bytes at buf + 1 (bytes 4-19) never touches buf[5] (bytes 20-23).  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon" } */
+/* test: the store of 1.0f to buf[5] survives.  */
+/* { dg-final { scan-assembler {\mst(w|fs) [0-9]+,20\(3\)} } } */
+/* t4: p[4] (bytes 16-19) survives vec_stvrx (v, 16, p), which stores
+   nothing when p is 16-byte aligned.  */
+/* { dg-final { scan-assembler {\mst(w|fs) [0-9]+,16\(3\)} } } */
+/* t2: p[2] survives vec_stvlx (v, 0, p).  */
+/* { dg-final { scan-assembler {\mst(w|fs) [0-9]+,8\(3\)} } } */
+/* tl: the LRU-hint forms; c[16] survives.  */
+/* { dg-final { scan-assembler {\mstb [0-9]+,16\(3\)} } } */
+/* { dg-final { scan-assembler-times {\mstvlx\M} 2 } } */
+/* { dg-final { scan-assembler-times {\mstvrx\M} 2 } } */
+/* { dg-final { scan-assembler-times {\mstvlxl\M} 1 } } */
+/* { dg-final { scan-assembler-times {\mstvrxl\M} 1 } } */
+
+#include <altivec.h>
+
+static inline void
+store_unaligned (float *p, vector float v)
+{
+  vec_stvlx (v, 0, p);
+  vec_stvrx (v, 16, p);
+}
+
+void
+test (float *buf, vector float v)
+{
+  buf[5] = 1.0f;
+  store_unaligned (buf + 1, v);
+}
+
+void
+t4 (float *p, vector float v)
+{
+  p[4] = 7.0f;
+  vec_stvrx (v, 16, p);
+}
+
+void
+t2 (float *p, vector float v)
+{
+  p[2] = 7.0f;
+  vec_stvlx (v, 0, p);
+}
+
+void
+tl (unsigned char *c, vector unsigned char v)
+{
+  c[16] = 9;
+  vec_stvlxl (v, 0, c);
+  vec_stvrxl (v, 16, c);
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-vmx128-9.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-vmx128-9.c
new file mode 100644
index 000000000..fbeef73de
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-vmx128-9.c
@@ -0,0 +1,37 @@
+/* Xenon VMX128 (plan 4.2; s345-fix finding 9): the estimate instructions
+   are kept in their legacy forms.  Whether vrefp128, vrsqrtefp128,
+   vexptefp128 and vlogefp128 return the same estimates as vrefp,
+   vrsqrtefp, vexptefp and vlogefp is not established by the hardware
+   sources (the estimate tables are unknown, FINDINGS 1.2), so GCC never
+   emits them: with both forms allowed, the estimate computed for one
+   source operation would depend on register allocation.  An operand in
+   v40 is copied into v0-v31 first.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler-not {\mv(refp|rsqrtefp|exptefp|logefp)128\M} } } */
+/* { dg-final { scan-assembler-times {\mvrefp ([0-9]|[12][0-9]|3[01]),([0-9]|[12][0-9]|3[01])$} 1 } } */
+/* { dg-final { scan-assembler-times {\mvrsqrtefp ([0-9]|[12][0-9]|3[01]),([0-9]|[12][0-9]|3[01])$} 1 } } */
+/* { dg-final { scan-assembler-times {\mvexptefp ([0-9]|[12][0-9]|3[01]),([0-9]|[12][0-9]|3[01])$} 1 } } */
+/* { dg-final { scan-assembler-times {\mvlogefp ([0-9]|[12][0-9]|3[01]),([0-9]|[12][0-9]|3[01])$} 1 } } */
+/* The v40 input reaches the legacy instruction through a copy.  */
+/* { dg-final { scan-assembler-times {\mvor128 ([0-9]|[12][0-9]|3[01]),40,40$} 4 } } */
+
+#include <altivec.h>
+
+typedef __vector float vf;
+
+#define OP1(NAME, EXPR)							\
+  void NAME (vf *pr, const vf *pa)					\
+  {									\
+    register vf a __asm__ ("v40") = *pa;				\
+    register vf r __asm__ ("v42");					\
+    __asm__ ("" : "+wV" (a));						\
+    r = (EXPR);								\
+    __asm__ ("" : "+wV" (r));						\
+    *pr = r;								\
+  }
+
+OP1 (re_f, vec_re (a))
+OP1 (rsqrte_f, vec_rsqrte (a))
+OP1 (expte_f, vec_expte (a))
+OP1 (loge_f, vec_loge (a))
diff --git gcc-16.2.0/libgcc/config.host gcc/libgcc/config.host
index ac10ccc43..174505567 100644
--- gcc-16.2.0/libgcc/config.host
+++ gcc/libgcc/config.host
@@ -1237,6 +1237,22 @@ powerpc*-*-freebsd*)
 	  ;;
 	esac
 	;;
+powerpc64-xenon-elf* | powerpc64-*-elf*)
+	# 64-bit bare-metal ELF (ELFv1), newlib; modelled on
+	# powerpc*-*-freebsd*.  Hard float, so no soft-fp.  The 64-bit
+	# out-of-line save/restore routines are generated by GNU ld
+	# (t-savresfgpr builds the 32-bit ones for the -m32 multilib).
+	# No md_unwind_header: there are no signal frames to unwind.
+	tmake_file="${tmake_file} rs6000/t-ppccomm rs6000/t-savresfgpr rs6000/t-crtstuff rs6000/t-ppc64-fp rs6000/t-xenon64"
+	case ${host} in
+	powerpc64-xenon-elf*)
+		# The Xbox 360 PPE: libgcc and the crt files are always
+		# built for it, whatever --with-cpu says (plan section 6).
+		tmake_file="${tmake_file} rs6000/t-xenon64-cpu"
+		;;
+	esac
+	extra_parts="$extra_parts crti.o crtn.o"
+	;;
 powerpc-*-netbsd*)
 	tmake_file="$tmake_file rs6000/t-netbsd rs6000/t-crtstuff"
 	;;
