diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-regs-11.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-regs-11.c
new file mode 100644
index 000000000..b1ec6a588
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-regs-11.c
@@ -0,0 +1,13 @@
+/* Xenon VMX128 (plan 4.1): v32-v127 in an asm clobber list are only valid
+   with the VMX128 registers; without them (here -mno-vmx128, likewise any
+   other CPU) they are rejected as before they existed.  v0-v31 are
+   fine.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon -mno-vmx128" } */
+
+void
+f (void)
+{
+  __asm__ __volatile__ ("" ::: "v31");
+  __asm__ __volatile__ ("" ::: "v40"); /* { dg-error "register 'v40' in an 'asm' clobber list needs the Xenon VMX128 registers" } */
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-regs-12.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-regs-12.c
new file mode 100644
index 000000000..c5aec6ac7
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-regs-12.c
@@ -0,0 +1,20 @@
+/* Xenon VMX128 (plan 4.1/4.3): an asm that clobbers v32-v127 makes the
+   compiler keep its values out of them; a clobbered v64-v127 is a
+   callee-saved register the function uses (its save is plan step 4), a
+   clobbered v32-v63 needs no save.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler-not {\m(lvx|stvx|vor)128 (3[2-9]|4[0-9]|50),} } } */
+/* { dg-final { scan-assembler {\mlvx128 51,} } } */
+
+typedef __attribute__ ((vector_size (16))) int v4si;
+
+void
+f (v4si *restrict o, const v4si *restrict a)
+{
+  v4si x = a[0];
+  __asm__ __volatile__ ("" ::: "v32", "v33", "v34", "v35", "v36", "v37",
+			"v38", "v39", "v40", "v41", "v42", "v43", "v44",
+			"v45", "v46", "v47", "v48", "v49", "v50", "memory");
+  o[0] = x;
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-regs-13.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-regs-13.c
new file mode 100644
index 000000000..150ea377b
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-regs-13.c
@@ -0,0 +1,41 @@
+/* Xenon VMX128 registers (s345-fix finding 2): -ffixed-vN for one of
+   v32-v127 is honoured with -mvmx128.  FIXED_REGISTERS used to mark them
+   fixed and rs6000_conditional_register_usage freed all of them again,
+   undoing the user's option; now only that hook fixes them (without
+   VMX128), so the option survives, also across target attribute and
+   pragma switches.  No vector instruction may name v32, v40, v100 or v127
+   (immediates never exceed 31, GPR operands neither).  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon -fno-ipa-icf -ffixed-v32 -ffixed-v40 -ffixed-v100 -ffixed-v127 -ffixed-v20" } */
+/* { dg-final { scan-assembler-not {^\t(?:v[a-z0-9.]*|[ls]v[a-z]*128) (?:[0-9]+,)*(?:32|40|100|127|20)(?:,|$)} } } */
+/* The other registers are used: v33 (the first free volatile), v126
+   (the first free callee-saved one).  */
+/* { dg-final { scan-assembler {^\t(?:v[a-z0-9.]*|lvx128) 33,} } } */
+/* { dg-final { scan-assembler {\mstvx128 126,1,0\M} } } */
+
+typedef __attribute__ ((vector_size (16))) float v4sf;
+void g (void);
+
+#define L4(b) v4sf x##b##0 = a[b*4+0], x##b##1 = a[b*4+1], \
+  x##b##2 = a[b*4+2], x##b##3 = a[b*4+3];
+#define S4(b) o[b*4+0] = x##b##3; o[b*4+1] = x##b##2; \
+  o[b*4+2] = x##b##1; o[b*4+3] = x##b##0;
+#define A4(b) x##b##0 += x##b##1; x##b##1 += x##b##2; \
+  x##b##2 += x##b##3; x##b##3 += x##b##0;
+#define L40 L4(0) L4(1) L4(2) L4(3) L4(4) L4(5) L4(6) L4(7) L4(8) L4(9)
+#define S40 S4(0) S4(1) S4(2) S4(3) S4(4) S4(5) S4(6) S4(7) S4(8) S4(9)
+#define A40 A4(0) A4(1) A4(2) A4(3) A4(4) A4(5) A4(6) A4(7) A4(8) A4(9)
+#define BODY { L40 for (int i = 0; i < n; i++) { A40 } S40 }
+#define BODYC { L4(0) L4(1) g (); S4(0) S4(1) }
+
+void f1 (v4sf *restrict o, const v4sf *restrict a, int n) BODY
+void f2 (v4sf *restrict o, const v4sf *restrict a, int n) BODYC
+__attribute__ ((target ("cpu=cell")))
+void f3 (v4sf *restrict o, const v4sf *restrict a, int n) BODY
+void f4 (v4sf *restrict o, const v4sf *restrict a, int n) BODY
+#pragma GCC push_options
+#pragma GCC target ("no-vmx128")
+void f5 (v4sf *restrict o, const v4sf *restrict a, int n) BODYC
+#pragma GCC pop_options
+void f6 (v4sf *restrict o, const v4sf *restrict a, int n) BODY
+void f7 (v4sf *restrict o, const v4sf *restrict a, int n) BODYC
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-regs-14.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-regs-14.c
new file mode 100644
index 000000000..45eef7b52
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-regs-14.c
@@ -0,0 +1,26 @@
+/* Xenon VMX128 registers (s345-fix finding 2): with -ffixed-v127 at -Os,
+   v127 is neither allocated nor saved, so the saved set cannot end at v127
+   and the out-of-line _savevr128_N/_restvr128_N routines (which save
+   vN..v127) are not used: the eight values kept across the call are saved
+   inline from v126 down.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-Os -maltivec -mdejagnu-cpu=xenon -ffixed-v127" } */
+/* { dg-final { scan-assembler-not {^\t(?:v[a-z0-9.]*|[ls]v[a-z]*128) (?:[0-9]+,)*127(?:,|$)} } } */
+/* { dg-final { scan-assembler-not {\m_(save|rest)vr128_} } } */
+/* { dg-final { scan-assembler-times {\mstvx128 (119|12[0-6]),1,0\M} 8 } } */
+
+typedef __attribute__ ((vector_size (16))) float v4sf;
+void g (void);
+
+#define L4(b) v4sf x##b##0 = a[b*4+0], x##b##1 = a[b*4+1], \
+  x##b##2 = a[b*4+2], x##b##3 = a[b*4+3];
+#define S4(b) o[b*4+0] = x##b##3; o[b*4+1] = x##b##2; \
+  o[b*4+2] = x##b##1; o[b*4+3] = x##b##0;
+
+void
+k8 (v4sf *restrict o, const v4sf *restrict a)
+{
+  L4 (0) L4 (1)
+  g ();
+  S4 (0) S4 (1)
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-regs-15.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-regs-15.c
new file mode 100644
index 000000000..74a18cdbc
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-regs-15.c
@@ -0,0 +1,20 @@
+/* Xenon VMX128 registers (s345-fix finding 3): v32-v63 are volatile and
+   no prologue saves them, so -fcall-saved-vN for one of them would let a
+   callee clobber a value its caller keeps there.  It is rejected.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon -fcall-saved-v40 -fcall-saved-v63" } */
+/* { dg-error "-fcall-saved-v40.* is not supported" "" { target *-*-* } 0 } */
+/* { dg-error "-fcall-saved-v63.* is not supported" "" { target *-*-* } 0 } */
+
+typedef __attribute__ ((vector_size (16))) float v4sf;
+void g (void);
+
+void
+f40 (v4sf *o, v4sf *a)
+{
+  register v4sf x __asm__ ("v40") = a[0];
+  __asm__ ("" : "+wV" (x));
+  g ();
+  __asm__ ("" : "+wV" (x));
+  o[0] = x;
+}
