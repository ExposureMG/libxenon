+   on && / || of comparisons stays a short-circuit branch; it is not turned
+   into logic on setcc values, which for FP compares is a 26-cycle
+   microcoded mfcr and for integers a serial carry chain.  */
+/* { dg-do compile { target { powerpc*-*-* && lp64 } } } */
+/* { dg-options "-O2 -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler-not {\mmfcr\M} } } */
+/* { dg-final { scan-assembler-not {\mmfocrf\M} } } */
+/* { dg-final { scan-assembler-not {\msubf(ic|e)\M} } } */
+/* { dg-final { scan-assembler-times {\mfcmpu\M} 2 } } */
+
+extern void abort (void);
+void g (_Complex double x, _Complex double y) { if (x != y) abort (); }
+int k (long a, long b, long c, long d) { if (a != b || c != d) return 5; return 9; }
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-sched-data-2.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-sched-data-2.c
new file mode 100644
index 000000000..c0e9537f3
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-sched-data-2.c
@@ -0,0 +1,20 @@
+/* Xenon FP loads and stores take an alignment interrupt unless EA % 4 == 0
+   (FINDINGS 1.4).  Also without 64-bit GPRs (-m32 -mno-powerpc64) an
+   under-aligned SF/DF/SI/DI access never uses lfd/stfd/lfs/stfs/stfiwx at
+   the unaligned address: 8-byte values are moved as two words.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -m32 -mno-powerpc64 -mdejagnu-cpu=xenon" } */
+/* FP accesses only to the (aligned) stack.  */
+/* { dg-final { scan-assembler-not {\m(lf|stf)[a-z]*u? [0-9]+,-?[0-9]+\((?!1\))[0-9]+\)} } } */
+/* { dg-final { scan-assembler-not {\m(lf|stf)[a-z]*x [0-9]+,(?!0,)} } } */
+/* { dg-final { scan-assembler-not {\mstfiwx [0-9]+,(?!0,)} } } */
+
+struct __attribute__ ((packed)) s { char c; double d; long long l; int i; float f; };
+double get_d (struct s *p) { return p->d; }
+void set_d (struct s *p, double v) { p->d = v; }
+double l2d (struct s *p) { return p->l; }
+void d2l (struct s *p, double v) { p->l = v; }
+void d2i (struct s *p, double v) { p->i = v; }
+float get_f (struct s *p) { return p->f; }
+void set_f (struct s *p, float v) { p->f = v; }
+void cpy (struct s *p, char *b) { __builtin_memcpy (&p->d, b + 1, 8); }
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-sched-data.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-sched-data.c
new file mode 100644
index 000000000..31300c3de
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-sched-data.c
@@ -0,0 +1,31 @@
+/* Xenon data layout (plan 5.3): a line-crossing access costs ~55 cycles, so
+   global arrays of a line or more are line (128-byte) aligned and arrays of
+   16 bytes or more quadword aligned; FP loads and stores take an alignment
+   interrupt unless EA % 4 == 0, so a packed double is not loaded with lfd
+   from its unaligned address.  */
+/* { dg-do compile { target { powerpc*-*-* && lp64 } } } */
+/* { dg-options "-O2 -mdejagnu-cpu=xenon -fno-common -fno-section-anchors" } */
+/* { dg-final { scan-assembler {\.lcomm\s+big,256,128|\.align 7\n(\s+\.[a-z]+[^\n]*\n)*big:} } } */
+/* { dg-final { scan-assembler {\.lcomm\s+mid,20,16|\.align 4\n(\s+\.[a-z]+[^\n]*\n)*mid:} } } */
+/* { dg-final { scan-assembler {\.align 7\n(\s+\.[a-z]+[^\n]*\n)*ibig:} } } */
+/* { dg-final { scan-assembler {\.align 4\n(\s+\.[a-z]+[^\n]*\n)*imid:} } } */
+/* { dg-final { scan-assembler {\.align 2\n(\s+\.[a-z]+[^\n]*\n)*ismall:} } } */
+/* FP loads and stores only touch the (aligned) stack; the packed fields
+   are accessed with integer loads and stores (no trap, free in a line).  */
+/* { dg-final { scan-assembler-not {\m(lf|stf)[a-z]*u? [0-9]+,-?[0-9]+\((?!1\))[0-9]+\)} } } */
+/* { dg-final { scan-assembler-not {\m(lf|stf)[a-z]*x [0-9]+,(?!0,)} } } */
+/* { dg-final { scan-assembler {\mstw [0-9]+,17\(3\)} } } */
+/* { dg-final { scan-assembler-not {\mlbz\M} } } */
+
+int big[64];
+char mid[20];
+int ibig[64] = { 1 };
+char imid[20] = { 1 };
+int ismall[3] = { 1 };
+
+struct __attribute__ ((packed)) s { char c; double d; long l; int i; };
+double get_d (struct s *p) { return p->d; }
+void set_d (struct s *p, double v) { p->d = v; }
+double l2d (struct s *p) { return p->l; }
+void d2l (struct s *p, double v) { p->l = v; }
+void d2i (struct s *p, double v) { p->i = v; }
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-sched-dfa.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-sched-dfa.c
new file mode 100644
index 000000000..b3b061196
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-sched-dfa.c
@@ -0,0 +1,21 @@
+/* Xenon scheduler sanity: sched2 uses the xenon.md automaton (the dump
+   prints each insn's reservation with the xe_* units).  */
+/* { dg-do compile { target { powerpc*-*-* && lp64 } } } */
+/* { dg-options "-O2 -mdejagnu-cpu=xenon -fsched-verbose=2 -fdump-rtl-sched2" } */
+/* { dg-final { scan-rtl-dump {xe_fxu} "sched2" } } */
+/* { dg-final { scan-rtl-dump {xe_lsu} "sched2" } } */
+/* { dg-final { scan-rtl-dump {xe_vsu1} "sched2" } } */
+/* { dg-final { scan-rtl-dump {xenon_issue} "sched2" } } */
+/* { dg-final { scan-rtl-dump {xe_lfd} "sched2" } } */
+
+double g (double *a, long *b, int n)
+{
+  double s = 0;
+  long t = 0;
+  for (int i = 0; i < n; i++)
+    {
+      s += a[i] * a[i + 1];
+      t += b[i] * 3 + (b[i] >> 2);
+    }
+  return s + t;
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-sched-loopalign-2.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-sched-loopalign-2.c
new file mode 100644
index 000000000..94d7b16bc
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-sched-loopalign-2.c
@@ -0,0 +1,11 @@
+/* Xenon: an explicit -falign-loops=N replaces the loop-top pad.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -mdejagnu-cpu=xenon -falign-loops=32" } */
+/* { dg-final { scan-assembler {\.p2align 5} } } */
+/* { dg-final { scan-assembler-not {\.p2align 3\n\.L[0-9]+:\n\tnop\n} } } */
