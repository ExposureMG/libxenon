+XENON_PARAM (SMT_BUSY_ISSUE_X100, 189, XENON_EV_SINGLE_RUN, "x1.88-1.89",
+	     "FINDINGS 7: busy sibling: issue cost x1.88-1.89 (lat.data, ucode)")
+XENON_PARAM (SMT_BUSY_INT_LAT_X100, 120, XENON_EV_SINGLE_RUN, "x1.20 (2.02 -> 2.42)",
+	     "FINDINGS 7 / 3.1: integer add chain under a busy sibling")
+XENON_PARAM (SMT_BUSY_MUL_LAT_X100, 106, XENON_EV_SINGLE_RUN, "x1.04-1.08",
+	     "FINDINGS 7: mullw latency under busy_int (middle of the range); applied to the whole multiply family (mulli/mulld/mulhd not measured under SMT)")
+XENON_PARAM (SMT_BUSY_DIV_LAT_X100, 105, XENON_EV_SINGLE_RUN, "x1.05",
+	     "FINDINGS 7: divw latency under busy_int; applied to the whole divide family")
+XENON_PARAM (SMT_BUSY_LAT_X100, 100, XENON_EV_SINGLE_RUN, "x1.00",
+	     "FINDINGS 7: dependent latency median x1.00 (711-731 lat.chain records), FP/VMX latency x1.00; only integer ALU, mullw and divw latencies rise")
+XENON_PARAM (SMT_SAME_TPUT_X100, 228, XENON_EV_SINGLE_RUN, "x2.28 (up to x2.5)",
+	     "FINDINGS 7: sibling running the same instruction stream: throughput (median); no separate issue-cost figure, so it also scales the unit occupancy")
+XENON_PARAM (SMT_SAME_LAT_X100, 127, XENON_EV_SINGLE_RUN, "x1.27 (up to x2.5)",
+	     "FINDINGS 7: sibling running the same instruction stream: latency (median)")
+XENON_PARAM (SMT_BUSY_MEM_X100, 104, XENON_EV_SINGLE_RUN, "x1.02-1.05",
+	     "FINDINGS 7: sibling busy with memory (pointer chase) barely costs issue slots")
+XENON_PARAM (SMT_PARKED_X1000, 994, XENON_EV_SINGLE_RUN, "x0.994 median; 10 % of records x0.89 or faster",
+	     "FINDINGS 7: parked sibling (xenon_sleep_thread) against the default sibling in libxenon's 'or 1,1,1' wait loop")
+XENON_PARAM (SMT_LOW_PRIO_TPUT_X10, 318, XENON_EV_SINGLE_RUN, "x31.8 (one insn per ~32 cycles)",
+	     "FINDINGS 7: thread priority low ('or 1,1,1'); or 2,2,2 / or 3,3,3 x1.000 / x0.998")
+XENON_PARAM (LAT_INT_SMT_BUSY, 3, XENON_EV_DERIVED, "-",
+	     "ceil (LAT_INT * SMT_BUSY_INT_LAT_X100 / 100) = ceil (2.4): plan 5.4 'use 3 in the DFA'. Busy-sibling latencies that grow are rounded up (a dependent integer chain is never modelled faster than measured)")
+XENON_PARAM (LAT_LOAD_UPDATE_BASE_SMT_BUSY, 3, XENON_EV_DERIVED, "-",
+	     "= LAT_INT_SMT_BUSY (the base update is an integer add)")
+XENON_PARAM (LAT_LOAD_UPDATE_BASE_SMT_SAME, 3, XENON_EV_DERIVED, "-",
+	     "rnd (LAT_LOAD_UPDATE_BASE * SMT_SAME_LAT_X100 / 100), as every latency under same")
+XENON_PARAM (SMT_BUSY_ISSUE_GAP, 1, XENON_EV_DERIVED, "-",
+	     "rnd (SMT_BUSY_TPUT_X100 / 100) - 1: cycles the sibling owns after each issue cycle of this thread (the threads alternate; this thread still pairs in its own cycle, so every class slows by about the same factor, as FINDINGS 7 measures)")
+XENON_PARAM (SMT_SAME_ISSUE_GAP, 1, XENON_EV_DERIVED, "-",
+	     "rnd (SMT_SAME_TPUT_X100 / 100) - 1, as SMT_BUSY_ISSUE_GAP. Both gaps are 1, so issue-bound integer and mixed code is modelled about x1.9 slower under same as well (FINDINGS 7: x2.28; a DFA cannot alternate 1- and 2-cycle gaps): same differs from busy only in unit occupancy (x2.28) and latency (x1.27)")
+XENON_PARAM (SMT_BUSY_LAT_PER_ISSUE_X100, 52, XENON_EV_DERIVED, "-",
+	     "100 * SMT_BUSY_LAT_X100 / SMT_BUSY_TPUT_X100: one latency-bound cycle in units of a throughput-bound issue cycle (which takes x1.91 longer)")
+XENON_PARAM (SMT_SAME_LAT_PER_ISSUE_X100, 56, XENON_EV_DERIVED, "-",
+	     "100 * SMT_SAME_LAT_X100 / SMT_SAME_TPUT_X100, as busy")
+XENON_PARAM (SMT_BUSY_UNROLL_DIV, 2, XENON_EV_DERIVED, "-",
+	     "rnd (SMT_BUSY_TPUT_X100 / SMT_BUSY_LAT_X100): unrolling buys independent work to hide latency; with the sibling owning every other cycle a latency spans this many times fewer of this thread's issue cycles, so this many times less unrolling hides it")
+XENON_PARAM (SMT_SAME_UNROLL_DIV, 2, XENON_EV_DERIVED, "-",
+	     "rnd (SMT_SAME_TPUT_X100 / SMT_SAME_LAT_X100), as busy")
+XENON_PARAM (VEC_STMT, 1, XENON_EV_DERIVED, "-",
+	     "= ISS_VSIMPLE: every VMX integer, logical, permute, pack and FP op issues one per cycle (rthroughput 1.00, FINDINGS 3.1). Plan 5.5 'permute 4' and 'FP 12' are the latencies LAT_VPERM / LAT_VFLOAT: the vectorizer sums issue cycles (scalar FP costs ISS_FP 1, not its latency 10), the scheduler handles latency")
+XENON_PARAM (VEC_SCALAR_STMT, 1, XENON_EV_DERIVED, "-",
+	     "max (ISS_INT, ISS_FP)")
+XENON_PARAM (VEC_LOAD, 3, XENON_EV_REPEATABLE, "2.93",
+	     "CSV lvx load_rthroughput; 8 rotating destinations (FINDINGS 3.4: use 2.93 as the throughput); = ISS_VECLOAD")
+XENON_PARAM (VEC_STORE, 4, XENON_EV_REPEATABLE_NOISY, "3.50",
+	     "CSV stvx store_rthroughput; store stream into one line (FINDINGS 3.4 stp); the SM issue cost 2.92 (ISS_VECSTORE) is the plan's '2.9'")
+XENON_PARAM (VEC_LVLX, 3, XENON_EV_REPEATABLE, "2.94",
+	     "CSV lvlx load_rthroughput; 8 rotating destinations")
+XENON_PARAM (VEC_LVRX, 3, XENON_EV_REPEATABLE, "2.93",
+	     "CSV lvrx issue; no rotating-destination figure; its issue cost is already the stream figure")
+XENON_PARAM (VEC_UNALIGNED_LOAD, 7, XENON_EV_DERIVED, "-",
+	     "VEC_LVLX + VEC_LVRX + ISS_VSIMPLE: lvlx + lvrx + vor (xenon_expand_movmisalign; the EA+16 add is hoisted or shared). Plan 5.5 'about 12' added the same-register lvlx stream issue 6.32; the two loads write different registers")
+XENON_PARAM (VEC_STVLX, 4, XENON_EV_REPEATABLE_NOISY, "3.50",
+	     "CSV stvlx store_rthroughput; store stream")
+XENON_PARAM (VEC_STVRX, 12, XENON_EV_REPEATABLE, "12.48",
+	     "CSV stvrx store_rthroughput; store stream; stvrx alone is ~3.5x slower than stvlx/stvx there (stvrxl and stvrx128 the same), cause not explained")
+XENON_PARAM (VEC_UNALIGNED_STORE, 16, XENON_EV_DERIVED, "-",
+	     "VEC_STVLX + VEC_STVRX: stvlx + stvrx (xenon_expand_movmisalign)")
+XENON_PARAM (VEC_SCALAR_LOAD_GPR, 1, XENON_EV_DERIVED, "-",
+	     "= ISS_LOAD (lwz stream 1.03, FINDINGS 3.4)")
+XENON_PARAM (VEC_SCALAR_LOAD_FPR, 3, XENON_EV_DERIVED, "-",
+	     "= ISS_FPLOAD (lfd/lfs stream 2.93, FINDINGS 3.4)")
+XENON_PARAM (VEC_SCALAR_STORE, 3, XENON_EV_REPEATABLE, "2.93",
+	     "FINDINGS 3.4: store reciprocal throughput, stw/stfd into one line")
+XENON_PARAM (VEC_XFER, 40, XENON_EV_DERIVED, "-",
+	     "max (XFER_GPR_VR, XFER_FPR_VR): a lane goes between a GPR/FPR and a VR through memory (store, then a load that hits it, FINDINGS 3.5); latency, so scaled by SMT_*_LAT_PER_ISSUE_X100")
+XENON_PARAM (VEC_CONSTRUCT_ELT, 3, XENON_EV_DERIVED, "-",
+	     "= VEC_SCALAR_STORE: vec_construct stores each element to a stack slot and loads the vector (one VEC_XFER round trip plus a store per further element)")
+XENON_PARAM (VEC_BRANCH_TAKEN, 8, XENON_EV_DERIVED, "-",
+	     "= BR_TAKEN")
+XENON_PARAM (VEC_BRANCH_NOT_TAKEN, 5, XENON_EV_DERIVED, "-",
+	     "= BR_NOT_TAKEN")
+XENON_PARAM (VEC_DIV_POW2_INSNS, 2, XENON_EV_DERIVED, "2",
+	     "a signed divide by a power of two: srawi/sradi + addze (expand_divmod)")
+XENON_PARAM (VEC_DIV_CONST_EXTRA, 2, XENON_EV_DERIVED, "2",
+	     "a divide by another constant: mulhw/mulhd (ISS_MULW/ISS_MULD) plus a shift and the sign fix-up (expand_divmod)")
+XENON_PARAM (VEC_MUL_BIGCONST_EXTRA, 2, XENON_EV_DERIVED, "2",
+	     "a multiplier outside 16 bits is loaded (lis + ori) before mullw/mulld")
+XENON_PARAM (VMUL_V4SI_INSNS, 33, XENON_EV_DERIVED, "33 (39 with the constants)",
+	     "altivec_xenon_mulv4si3: 6 pieces, 6 converts, 6 vmulfp128, 6 vctuxs, adds/shifts")
+XENON_PARAM (VMUL_V8HI_INSNS, 25, XENON_EV_DERIVED, "25",
+	     "mulv8hi3: two altivec_xenon_widen_mult_v8hi halves + vpkuwum")
+XENON_PARAM (VMUL_V16QI_INSNS, 31, XENON_EV_DERIVED, "31",
+	     "mulv16qi3: two altivec_xenon_widen_mult_v16qi halves + vpkuhum")
+XENON_PARAM (VWMUL_V8HI_INSNS, 12, XENON_EV_DERIVED, "12",
+	     "vec_widen_[su]mult_{hi,lo}_v8hi, per half")
+XENON_PARAM (VWMUL_V16QI_INSNS, 15, XENON_EV_DERIVED, "15",
+	     "vec_widen_[su]mult_{hi,lo}_v16qi, per half")
+XENON_PARAM (VMUL_V4SI_CHAIN, 60, XENON_EV_DERIVED, "-",
+	     "operand -> result: vsrw + vand (a byte of b) + vcuxwfp128 + vmulfp128 + vctuxs + vadduwm + vslw + 2 vadduwm (6 LAT_VSIMPLE + 3 LAT_VFLOAT); not charged (s7a.md: the vectorizer unrolls such loops and sched2 overlaps the chains)")
diff --git gcc-16.2.0/gcc/config/rs6000/xenon-logue.md gcc/gcc/config/rs6000/xenon-logue.md
new file mode 100644
index 000000000..9ed06d331
--- /dev/null
+++ gcc/gcc/config/rs6000/xenon-logue.md
@@ -0,0 +1,85 @@
+;; Xbox 360 Xenon VMX128: prologue and epilogue patterns for the
+;; callee-saved vector registers v64-v127 (plan 4.3).
+;; Copyright (C) 2026 Free Software Foundation, Inc.
+
+;; This file is part of GCC.
+
+;; GCC is free software; you can redistribute it and/or modify it
+;; under the terms of the GNU General Public License as published
+;; by the Free Software Foundation; either version 3, or (at your
+;; option) any later version.
+
+;; GCC is distributed in the hope that it will be useful, but WITHOUT
+;; ANY WARRANTY; without even the implied warranty of MERCHANTABILITY
+;; or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public
+;; License for more details.
+
+;; You should have received a copy of the GNU General Public License
+;; along with GCC; see the file COPYING3.  If not see
+;; <http://www.gnu.org/licenses/>.
+
+;; This file is included last from rs6000.md, so that the insn codes of
+;; every other pattern stay as they are.  The patterns are only used by
+;; rs6000-logue.cc, and only with TARGET_VMX128.
+
+;; Inline saves and restores.  stvx128 and lvx128 take indexed or indirect
+;; addresses only, like stvx and lvx; the prologue and epilogue put the
+;; offset in r0 (li 0,OFFSET; stvx128 vN,FRAME,0).  The unspec keeps these
+;; apart from ordinary vector moves, as altivec_stvx_<mode>_internal and
+;; altivec_lvx_<mode>_internal do for the AltiVec registers v20-v31; its
+;; operand is 128 rather than their 0, so that those legacy patterns (which
+;; come first and accept any register_operand, but only v0-v31 in their
+;; constraints) never match these.
+(define_insn "xenon_stvx128_v4si_internal"
+  [(parallel
+    [(set (match_operand:V4SI 0 "memory_operand" "=Z")
+	  (match_operand:V4SI 1 "vmx128_register_operand" "wV"))
+     (unspec [(const_int 128)] UNSPEC_STVX)])]
+  "TARGET_VMX128"
+  "stvx128 %1,%y0"
+  [(set_attr "type" "vecstore")])
+
+(define_insn "xenon_lvx128_v4si_internal"
+  [(parallel
+    [(set (match_operand:V4SI 0 "vmx128_register_operand" "=wV")
+	  (match_operand:V4SI 1 "memory_operand" "Z"))
+     (unspec [(const_int 128)] UNSPEC_LVX)])]
+  "TARGET_VMX128"
+  "lvx128 %0,%y1"
+  [(set_attr "type" "vecload")])
+
+;; Calls to the out-of-line libgcc routines _savevr128_N and _restvr128_N,
+;; N = 64..127 (libgcc/config/rs6000/crtsavevr128.S, crtrestvr128.S).
+;; Convention: r0 points just past the end of the v64-v127 save area (16-byte
+;; aligned); the routine stores or loads vN..v127 at r0 - 16 * (128 - N) ..
+;; r0 - 16, using r12 for the offsets, changes nothing else (LR is set by the
+;; bl), and returns with blr.  The RTL describes the addresses relative to
+;; r0, the real base; (plus r0 const) is not a valid vector address, so like
+;; the save_vregs patterns in altivec.md these do not use memory_operand.
+;; Only the first register store or load is matched; the parallel holds one
+;; per register saved or restored.
+(define_insn "*xenon_save_vregs128_<mode>"
+  [(match_parallel 0 "any_parallel_operand"
+     [(clobber (reg:P LR_REGNO))
+      (use (match_operand:P 1 "symbol_ref_operand" "s"))
+      (clobber (reg:P 12))
+      (use (reg:P 0))
+      (set (mem:V4SI (plus:P (reg:P 0)
+			     (match_operand:P 2 "short_cint_operand" "I")))
+	   (match_operand:V4SI 3 "vmx128_register_operand" "wV"))])]
+  "TARGET_VMX128"
+  "bl %1"
+  [(set_attr "type" "branch")])
+
+(define_insn "*xenon_restore_vregs128_<mode>"
+  [(match_parallel 0 "any_parallel_operand"
+     [(clobber (reg:P LR_REGNO))
+      (use (match_operand:P 1 "symbol_ref_operand" "s"))
+      (clobber (reg:P 12))
+      (use (reg:P 0))
+      (set (match_operand:V4SI 2 "vmx128_register_operand" "=wV")
+	   (mem:V4SI (plus:P (reg:P 0)
+			     (match_operand:P 3 "short_cint_operand" "I"))))])]
+  "TARGET_VMX128"
+  "bl %1"
+  [(set_attr "type" "branch")])
diff --git gcc-16.2.0/gcc/config/rs6000/xenon-vmx.md gcc/gcc/config/rs6000/xenon-vmx.md
new file mode 100644
index 000000000..9dff692c2
--- /dev/null
+++ gcc/gcc/config/rs6000/xenon-vmx.md
@@ -0,0 +1,175 @@
+;; Xbox 360 Xenon VMX128-only operations (XENON_TARGET_PLAN 4.2 last
+;; bullets, D7, 4.4 phase 3).
+;; Copyright (C) 2026 Free Software Foundation, Inc.
+;;
+;; This file is part of GCC.
+;;
+;; GCC is free software; you can redistribute it and/or modify it
+;; under the terms of the GNU General Public License as published
+;; by the Free Software Foundation; either version 3, or (at your
+;; option) any later version.
+;;
+;; GCC is distributed in the hope that it will be useful, but WITHOUT
+;; ANY WARRANTY; without even the implied warranty of MERCHANTABILITY
+;; or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public
+;; License for more details.
+;;
+;; You should have received a copy of the GNU General Public License
+;; along with GCC; see the file COPYING3.  If not see
+;; <http://www.gnu.org/licenses/>.
+
+;; The VMX128 instructions without an AltiVec equivalent: vmsum3fp128,
+;; vmsum4fp128, vrlimi128, vpermwi128, vpkd3d128, vupkd3d128, plus the
+;; builtin forms of vmaddcfp128 and vmulfp128 (which the compiler also
+;; reaches through fma and V4SF multiplication, altivec.md).  They are only
+;; reachable through the __builtin_xenon_* functions (rs6000-builtins.def
+;; stanza [xenon-vmx128], rs6000-overload.def): every pattern is an UNSPEC,
+;; so no optimizer and in particular not the vectorizer creates, folds or
+;; contracts them, and each builtin call emits exactly one instruction.
+;; vmsum3fp128/vmsum4fp128 must stay that way: they are not IEEE dot products
+;; (FINDINGS 1.3: truncated accumulator, one's-complement sum).
+;;
+;; Every register operand is wV (v0-v127, VMX128_REGS) and the 128 mnemonic
+;; is always printed (there is no legacy form).  The destructive forms
+;; vmaddcfp128, vrlimi128 and vpkd3d128 read their destination field (JSON
+;; tied_operands [VD128]): the tied input uses the matching constraint "0",
+;; so the register allocator inserts the copy when the old value stays live.
+;; The immediates are const_int operands checked against their instruction
+;; field (isa/xenon_isa.json "fields"); the builtins check the narrower
+;; ranges with a defined meaning before expansion.
+;;
+;; Operand order and semantics (isa/xenon_isa.json, FINDINGS 1.3):
+;;   vmsum3fp128 VD,VA,VB      D.xyzw = A.x*B.x + A.y*B.y + A.z*B.z
+;;   vmsum4fp128 VD,VA,VB      D.xyzw = A.x*B.x + ... + A.w*B.w
+;;   vmaddcfp128 VD,VA,VD,VB   D = A*D + B (fused, one RNE rounding)
+;;   vmulfp128   VD,VA,VB      D = A*B (rounded product)
+;;   vrlimi128   VD,VB,UIMM,VD3D2
+;;                             D.i = rotl_words (B, VD3D2)[i] if UIMM bit
+;;                             (3-i) is set, else D.i
+;;   vpermwi128  VD,VB,VPERM128
+;;                             D.i = B[(VPERM128 >> (6-2i)) & 3]
+;;   vpkd3d128   VD,VB,VD3D0,VD3D1,VD3D2
+;;                             pack B as D3D type VD3D0, pack size VD3D1,
+;;                             into word slot VD3D2 of D; D's other words
+;;                             are kept; sets VSCR[SAT] when it clamps
+;;   vupkd3d128  VD,VB,UIMM    D = unpack B as D3D type UIMM >> 2
+;; Scheduling classes (xenon.md): vmsum3/4fp128 veccomplex (14 cycles),
+;; vmaddcfp128/vmulfp128 vecfloat (12), the others vecperm (4); FINDINGS
+;; 2.x tables.
+
+(define_c_enum "unspec"
+  [UNSPEC_XENON_VMSUM3FP
+   UNSPEC_XENON_VMSUM4FP
+   UNSPEC_XENON_VMADDCFP
+   UNSPEC_XENON_VMULFP
+   UNSPEC_XENON_VRLIMI
+   UNSPEC_XENON_VPERMWI
+   UNSPEC_XENON_VPKD3D
+   UNSPEC_XENON_VUPKD3D])
+
+;; The word-granular operations exist for vector float and vector int.
+(define_mode_iterator VXENON_W [V4SF V4SI])
+
+(define_insn "xenon_vmsum3fp128"
+  [(set (match_operand:V4SF 0 "vmx128_register_operand" "=wV")
+	(unspec:V4SF [(match_operand:V4SF 1 "vmx128_register_operand" "wV")
+		      (match_operand:V4SF 2 "vmx128_register_operand" "wV")]
+		     UNSPEC_XENON_VMSUM3FP))]
+  "TARGET_VMX128"
+  "vmsum3fp128 %0,%1,%2"
+  [(set_attr "type" "veccomplex")])
+
+(define_insn "xenon_vmsum4fp128"
+  [(set (match_operand:V4SF 0 "vmx128_register_operand" "=wV")
+	(unspec:V4SF [(match_operand:V4SF 1 "vmx128_register_operand" "wV")
+		      (match_operand:V4SF 2 "vmx128_register_operand" "wV")]
+		     UNSPEC_XENON_VMSUM4FP))]
+  "TARGET_VMX128"
+  "vmsum4fp128 %0,%1,%2"
+  [(set_attr "type" "veccomplex")])
+
+;; __builtin_xenon_vmaddcfp (a, d, b) = a*d + b with d in the destination
+;; register: vmaddcfp128 vD,vA,vD,vB.  Operand 2 is the tied multiplicand.
+(define_insn "xenon_vmaddcfp128"
+  [(set (match_operand:V4SF 0 "vmx128_register_operand" "=wV")
+	(unspec:V4SF [(match_operand:V4SF 1 "vmx128_register_operand" "wV")
+		      (match_operand:V4SF 2 "vmx128_register_operand" "0")
+		      (match_operand:V4SF 3 "vmx128_register_operand" "wV")]
+		     UNSPEC_XENON_VMADDCFP))]
+  "TARGET_VMX128"
+  "vmaddcfp128 %0,%1,%2,%3"
+  [(set_attr "type" "vecfloat")])
+
+;; __builtin_xenon_vmulfp: the rounded product as an UNSPEC, unlike
+;; xenon_vmulfp128 (altivec.md, the V4SF multiply), which the optimizers
+;; may fold or contract into an fma.
+(define_insn "xenon_vmulfp128_exact"
+  [(set (match_operand:V4SF 0 "vmx128_register_operand" "=wV")
+	(unspec:V4SF [(match_operand:V4SF 1 "vmx128_register_operand" "wV")
+		      (match_operand:V4SF 2 "vmx128_register_operand" "wV")]
+		     UNSPEC_XENON_VMULFP))]
+  "TARGET_VMX128"
+  "vmulfp128 %0,%1,%2"
+  [(set_attr "type" "vecfloat")])
+
+;; vrlimi128 vD,vB,UIMM,VD3D2 (vD tied): operand 1 is the old vD, operand 3
+;; the lane mask (UIMM, a 5-bit field, bits 3:0 used), operand 4 the
+;; rotate count in words (VD3D2, 2 bits).
+(define_insn "xenon_vrlimi128_<mode>"
+  [(set (match_operand:VXENON_W 0 "vmx128_register_operand" "=wV")
+	(unspec:VXENON_W
+	  [(match_operand:VXENON_W 1 "vmx128_register_operand" "0")
+	   (match_operand:VXENON_W 2 "vmx128_register_operand" "wV")
+	   (match_operand:SI 3 "u5bit_cint_operand" "n")
+	   (match_operand:SI 4 "const_0_to_3_operand" "n")]
+	  UNSPEC_XENON_VRLIMI))]
+  "TARGET_VMX128"
+  "vrlimi128 %0,%2,%3,%4"
+  [(set_attr "type" "vecperm")])
+
+;; vpermwi128 vD,vB,VPERM128 (8-bit immediate).
+(define_insn "xenon_vpermwi128_<mode>"
+  [(set (match_operand:VXENON_W 0 "vmx128_register_operand" "=wV")
+	(unspec:VXENON_W
+	  [(match_operand:VXENON_W 1 "vmx128_register_operand" "wV")
+	   (match_operand:SI 2 "u8bit_cint_operand" "n")]
+	  UNSPEC_XENON_VPERMWI))]
+  "TARGET_VMX128"
+  "vpermwi128 %0,%1,%2"
+  [(set_attr "type" "vecperm")])
+
+;; vpkd3d128 vD,vB,VD3D0,VD3D1,VD3D2 (vD tied): operand 1 is the old vD,
+;; operand 2 the floats to pack, operands 3-5 the D3D type (3 bits), the
+;; pack size (2 bits) and the word slot (2 bits).  A clamped value sets
+;; VSCR[SAT] (FINDINGS 1.3), modelled as for the saturating AltiVec ops.
+(define_insn "xenon_vpkd3d128_<mode>"
+  [(set (match_operand:VXENON_W 0 "vmx128_register_operand" "=wV")
+	(unspec:VXENON_W
+	  [(match_operand:VXENON_W 1 "vmx128_register_operand" "0")
+	   (match_operand:V4SF 2 "vmx128_register_operand" "wV")
+	   (match_operand:SI 3 "const_0_to_7_operand" "n")
+	   (match_operand:SI 4 "const_0_to_3_operand" "n")
+	   (match_operand:SI 5 "const_0_to_3_operand" "n")]
+	  UNSPEC_XENON_VPKD3D))
+   (set (reg:SI VSCR_REGNO) (unspec:SI [(const_int 0)] UNSPEC_SET_VSCR))]
+  "TARGET_VMX128"
+  "vpkd3d128 %0,%2,%3,%4,%5"
+  [(set_attr "type" "vecperm")])
+
+;; vupkd3d128 vD,vB,UIMM: operand 2 is the D3D type (0-7); the instruction's
+;; 5-bit UIMM is type << 2 (the semantics use UIMM >> 2 only).
+(define_insn "xenon_vupkd3d128"
+  [(set (match_operand:V4SF 0 "vmx128_register_operand" "=wV")
+	(unspec:V4SF [(match_operand:V4SI 1 "vmx128_register_operand" "wV")
+		      (match_operand:SI 2 "const_0_to_7_operand" "n")]
+		     UNSPEC_XENON_VUPKD3D))]
+  "TARGET_VMX128"
+{
+  rtx ops[3];
+  ops[0] = operands[0];
+  ops[1] = operands[1];
+  ops[2] = GEN_INT (INTVAL (operands[2]) << 2);
+  output_asm_insn ("vupkd3d128 %0,%1,%2", ops);
+  return "";
+}
+  [(set_attr "type" "vecperm")])
