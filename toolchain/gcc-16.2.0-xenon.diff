+/* This file follows rs6000/sysv4.h and rs6000/default64.h in tm_file and
+   is derived from rs6000/freebsd64.h with the operating-system parts
+   removed.  The ABI is the 64-bit ELF ABI version 1 (ELFv1): function
+   descriptors in .opd, the TOC pointer in r2, LP64, big-endian.  There is
+   no dynamic linker and no shared library support; executables are linked
+   statically.  The C library is newlib; the board support library
+   (libxenon) supplies crt0.o and the system calls.
+
+   -m64 is the default.  -m32 is a multilib (libxenon is built -m32
+   -mpowerpc64): it uses the 32-bit SysV (ABI_V4) conventions of
+   rs6000/sysv4.h, with structures returned in memory and the <stdint.h>
+   types of the existing -m32 Xenon libraries (see below).  */
+
+/* gnu-user.h is only included because rs6000/sysv4.h refers to its spec
+   macros.  Undo the parts that describe a GNU/Linux userland.  */
+#undef CPLUSPLUS_CPP_SPEC
+#undef LINK_EH_SPEC
+#undef USE_LD_AS_NEEDED
+#undef TARGET_POSIX_IO
+
+/* newlib is not glibc: only claim the C99 functions.  */
+#undef TARGET_LIBC_HAS_FUNCTION
+#define TARGET_LIBC_HAS_FUNCTION default_libc_has_function
+
+/* Override the defaults, which exist to force the proper definition.  */
+#ifdef IN_LIBGCC2
+#undef TARGET_64BIT
+#ifdef __powerpc64__
+#define TARGET_64BIT 1
+#else
+#define TARGET_64BIT 0
+#endif
+#endif
+
+/* The 64-bit ABI is the AIX-style (descriptor) ABI.  */
+#undef	TARGET_AIX
+#define	TARGET_AIX TARGET_64BIT
+
+#ifdef HAVE_LD_NO_DOT_SYMS
+/* New ABI uses a local sym for the function entry point.  */
+extern int dot_symbols;
+#undef DOT_SYMBOLS
+#define DOT_SYMBOLS dot_symbols
+#endif
+
+/* Use the -mcmodel= / -mprofile-kernel options and the 64-bit option
+   checks of rs6000/linux64.opt (rs6000_linux64_override_options).  The
+   linker is GNU ld from binutils 2.47 or later, which supports the
+   medium and large models, so -mcmodel= is always honoured.  */
+#define TARGET_USES_LINUX64_OPT 1
+#undef TARGET_CMODEL
+#define TARGET_CMODEL rs6000_current_cmodel
+#define SET_CMODEL(opt) rs6000_current_cmodel = opt
+
+/* Processor used only when no cpu is known at all (no -mcpu, no
+   --with-cpu, e.g. --with-cpu=default64): plain 64-bit PowerPC, matching
+   TARGET_DEFAULT's ISA flags.  config.gcc defaults --with-cpu to xenon for
+   powerpc64-xenon-elf (and to powerpc64 for other powerpc64-*-elf), so the
+   driver and cc1 normally use -mcpu=xenon.  */
+#undef  PROCESSOR_DEFAULT
+#define PROCESSOR_DEFAULT PROCESSOR_POWERPC64
+#undef  PROCESSOR_DEFAULT64
+#define PROCESSOR_DEFAULT64 PROCESSOR_POWERPC64
+
+/* We don't need to generate entries in .fixup, except when
+   -mrelocatable or -mrelocatable-lib is given.  */
+#undef RELOCATABLE_NEEDS_FIXUP
+#define RELOCATABLE_NEEDS_FIXUP \
+  (rs6000_isa_flags & rs6000_isa_flags_explicit & OPTION_MASK_RELOCATABLE)
+
+/* The -mcall-ABI name.  "linux" selects ABI_AIX (ELFv1) for -m64 and
+   ABI_V4 for -m32 in sysv4.h's SUBTARGET_OVERRIDE_OPTIONS; it does not
+   imply any Linux system support.  */
+#undef  RS6000_ABI_NAME
+#define RS6000_ABI_NAME "linux"
+
+#define INVALID_64BIT "%<-m%s%> not supported in this configuration"
+#define INVALID_32BIT INVALID_64BIT
+
+/* ELFv1 is the default and the tested ABI; -mabi=elfv2 selects ELFv2.  */
+#define ELFv2_ABI_CHECK (rs6000_elf_abi == 2)
+
+/* -m32 returns structures in memory (-maix-struct-return), as the
+   powerpc64 Linux configuration does for its 32-bit multilib.  libxenon
+   and the existing -m32 Xenon libraries were built that way.  */
+#undef  DRAFT_V4_STRUCT_RET
+#define DRAFT_V4_STRUCT_RET (!TARGET_64BIT)
+
+/* The 64-bit option checks are shared with linux64.h and freebsd64.h.
+   They default to -mcmodel=medium; this target defaults to
+   -mcmodel=small (TOC-indirect addressing, 16-bit TOC offsets; GNU ld
+   splits an oversized TOC into multiple TOC groups), so put the small
+   model back unless the user asked for a model explicitly.  */
+#undef  SUBSUBTARGET_OVERRIDE_OPTIONS
+#define SUBSUBTARGET_OVERRIDE_OPTIONS					\
+  do									\
+    {									\
+      rs6000_linux64_override_options ();				\
+      if (TARGET_64BIT							\
+	  && !OPTION_SET_P (rs6000_current_cmodel)			\
+	  && rs6000_current_cmodel != CMODEL_SMALL)			\
+	{								\
+	  SET_CMODEL (CMODEL_SMALL);					\
+	  if (!OPTION_SET_P (TARGET_NO_FP_IN_TOC))			\
+	    TARGET_NO_FP_IN_TOC = 0;					\
+	  if (!OPTION_SET_P (TARGET_NO_SUM_IN_TOC))			\
+	    TARGET_NO_SUM_IN_TOC = 0;					\
+	}								\
+    }									\
+  while (0)
+
+/* Assembler: -a64 by default, -a32 for the -m32 multilib.  */
+#undef	ASM_SPEC
+#define	ASM_SPEC "%{m32:%(asm_spec32)}%{!m32:%(asm_spec64)} %(asm_spec_common)"
+
+#define ASM_SPEC32 "-a32 \
+%{mrelocatable} %{mrelocatable-lib} %{" FPIE_OR_FPIC_SPEC ":-K PIC} \
+%{memb|msdata=eabi: -memb}"
+
+#define ASM_SPEC64 "-a64"
+
+#define ASM_SPEC_COMMON "%(asm_cpu) \
+%{,assembler|,assembler-with-cpp: %{mregnames} %{mno-regnames}}" \
+  ENDIAN_SELECT(" -mbig", " -mlittle", " -mbig")
+
+/* Linker: pick the emulation explicitly (elf32ppc for -m32).  */
+#define LINK_OS_SPEC32 "-m elf32ppc"
+#define LINK_OS_SPEC64 "-m elf64ppc"
+
+#undef	SUBSUBTARGET_EXTRA_SPECS
+#define SUBSUBTARGET_EXTRA_SPECS					\
+  { "asm_spec_common",		ASM_SPEC_COMMON },			\
+  { "asm_spec32",		ASM_SPEC32 },				\
+  { "asm_spec64",		ASM_SPEC64 },				\
+  { "link_os_spec32",		LINK_OS_SPEC32 },			\
+  { "link_os_spec64",		LINK_OS_SPEC64 },
+
+#undef  LINK_OS_DEFAULT_SPEC
+#define LINK_OS_DEFAULT_SPEC \
+  "%{m32:%(link_os_spec32)}%{!m32:%(link_os_spec64)}"
+
+/* Static linking only: no shared libraries, no dynamic linker.  */
+#undef  LINK_SHLIB_SPEC
+#define LINK_SHLIB_SPEC \
+  "%{shared|symbolic:%eshared libraries are not supported on this target} \
+   %{!r:-static}"
+
+/* No default load address: the image is placed by the linker script
+   (-T) of the board support package; ld's elf64ppc default script
+   already links at 0x10000000, below 4 GiB.  */
+#undef	LINK_START_DEFAULT_SPEC
+#define	LINK_START_DEFAULT_SPEC ""
+
+/* newlib start files.  The board support library (libxenon) supplies
+   crt0.o (the entry point); libgcc supplies crti.o/crtn.o (the _init and
+   _fini frames newlib's __libc_init_array calls) and crtbegin.o/crtend.o.  */
+#undef	STARTFILE_DEFAULT_SPEC
+#define	STARTFILE_DEFAULT_SPEC "%:if-exists(crt0%O%s) crti%O%s crtbegin%O%s"
+
+#undef	ENDFILE_DEFAULT_SPEC
+#define	ENDFILE_DEFAULT_SPEC "crtend%O%s crtn%O%s"
+
+#undef	LIB_DEFAULT_SPEC
+#define	LIB_DEFAULT_SPEC "-lc"
+
+/* libgcc, libc and the board support library refer to each other.  */
+#undef	LINK_GCC_C_SEQUENCE_SPEC
+#define	LINK_GCC_C_SEQUENCE_SPEC \
+  "%{nolibc:%G;:--start-group %G %L --end-group}"
+
+#undef	CPP_OS_DEFAULT_SPEC
+#define	CPP_OS_DEFAULT_SPEC ""
+
+#undef	MULTILIB_DEFAULTS
+#define MULTILIB_DEFAULTS { "mbig", "m64" }
+
+#undef  TARGET_OS_CPP_BUILTINS
+#define TARGET_OS_CPP_BUILTINS()			\
+  do							\
+    {							\
+      if (TARGET_XENON_OS)				\
+	{						\
+	  builtin_define ("__XENON__");			\
+	  builtin_assert ("system=xenon");		\
+	}						\
+      if (TARGET_64BIT)					\
+	{						\
+	  builtin_define ("__PPC__");			\
+	  builtin_define ("__PPC64__");			\
+	  builtin_define ("__powerpc__");		\
+	  builtin_define ("__powerpc64__");		\
+	  builtin_assert ("cpu=powerpc64");		\
+	  builtin_assert ("machine=powerpc64");		\
+	}						\
+      else						\
+	{						\
+	  builtin_define_std ("PPC");			\
+	  builtin_define_std ("powerpc");		\
+	  builtin_assert ("cpu=powerpc");		\
+	  builtin_assert ("machine=powerpc");		\
+	  TARGET_OS_SYSV_CPP_BUILTINS ();		\
+	}						\
+    }							\
+  while (0)
+
+#ifndef TARGET_XENON_OS
+#define TARGET_XENON_OS 0
+#endif
+
+/* PowerPC-64 increases natural record alignment to doubleword if
+   the first field is an FP double, only if in power alignment mode.  */
+#undef  ROUND_TYPE_ALIGN
+#define ROUND_TYPE_ALIGN(STRUCT, COMPUTED, SPECIFIED)			\
+  ((TARGET_64BIT							\
+    && RECORD_OR_UNION_TYPE_P (STRUCT)					\
+    && TARGET_ALIGN_NATURAL == 0)					\
+   ? rs6000_special_round_type_align (STRUCT, COMPUTED, SPECIFIED)	\
+   : MAX ((COMPUTED), (SPECIFIED)))
+
+/* Use the default for compiling target libs.  */
+#ifdef IN_TARGET_LIBS
+#undef TARGET_ALIGN_NATURAL
+#define TARGET_ALIGN_NATURAL 1
+#endif
+
+/* Indicate that jump tables go in the text section.  */
+#undef  JUMP_TABLES_IN_TEXT_SECTION
+#define JUMP_TABLES_IN_TEXT_SECTION TARGET_64BIT
+
+/* Aggregates in the parameter area are padded upward, as in the 64-bit
+   ELF ABI (same settings as linux64.h and freebsd64.h).  */
+#define AGGREGATE_PADDING_FIXED TARGET_64BIT
+#define AGGREGATES_PAD_UPWARD_ALWAYS 0
+
+/* Specify padding for the last element of a block move between
+   registers and memory.  FIRST is nonzero if this is the only
+   element.  */
+#define BLOCK_REG_PADDING(MODE, TYPE, FIRST) \
+  (!(FIRST) ? PAD_UPWARD : targetm.calls.function_arg_padding (MODE, TYPE))
+
+/* Types (LP64 for -m64).  */
+#undef  SIZE_TYPE
+#define SIZE_TYPE (TARGET_64BIT ? "long unsigned int" : "unsigned int")
+
+#undef  PTRDIFF_TYPE
+#define PTRDIFF_TYPE (TARGET_64BIT ? "long int" : "int")
+
+#undef  WCHAR_TYPE
+#define WCHAR_TYPE (TARGET_64BIT ? "int" : "long int")
+#undef  WCHAR_TYPE_SIZE
+#define WCHAR_TYPE_SIZE 32
+
+/* <stdint.h> types for -m32: int32_t is int (not newlib's default of
+   long when long is 32 bits) and int_fast8_t is signed char, as in the
+   existing -m32 Xenon libraries (libxenon), so C++ mangling and the
+   layout of structures using them do not change.  -m64 keeps the
+   newlib-stdint.h types.  */
+#undef  STDINT_LONG32
+#define STDINT_LONG32 0
+#undef  INT_FAST8_TYPE
+#define INT_FAST8_TYPE (TARGET_64BIT ? "int" : "signed char")
+#undef  UINT_FAST8_TYPE
+#define UINT_FAST8_TYPE (TARGET_64BIT ? "unsigned int" : "unsigned char")
+
+/* Function profiling bits.  */
+#undef  RS6000_MCOUNT
+#define RS6000_MCOUNT "_mcount"
+
+#define PROFILE_HOOK(LABEL) \
+  do { if (TARGET_64BIT) output_profile_hook (LABEL); } while (0)
+
+/* _init and _fini functions are built from bits spread across many
+   object files, each potentially with a different TOC pointer.  For
+   that reason, place a nop after the call so that the linker can
+   restore the TOC pointer if a TOC adjusting call stub is needed.  */
+#ifdef __powerpc64__
+#define CRT_CALL_STATIC_FUNCTION(SECTION_OP, FUNC)	\
+  asm (SECTION_OP "\n"					\
+"	bl " #FUNC "\n"					\
+"	nop\n"						\
+"	.previous");
+#endif
+
+/* Out-of-line FP save and restore routines (the 64-bit ones are
+   generated by GNU ld).  POWERPC_LINUX selects the matching names in
+   rs6000-logue.cc and IBM (not IEEE) 128-bit long double as the
+   -mlong-double-128 format, as on rtems.h; it does not imply Linux.  */
+#define POWERPC_LINUX
+
+#undef  SAVE_FP_PREFIX
+#define SAVE_FP_PREFIX (TARGET_64BIT ? "._savef" : "_savefpr_")
+#undef  SAVE_FP_SUFFIX
+#define SAVE_FP_SUFFIX ""
+#undef  RESTORE_FP_PREFIX
+#define RESTORE_FP_PREFIX (TARGET_64BIT ? "._restf" : "_restfpr_")
+#undef  RESTORE_FP_SUFFIX
+#define RESTORE_FP_SUFFIX ""
+
+/* Select a format to encode pointers in exception handling data.  CODE
+   is 0 for data, 1 for code labels, 2 for function pointers.  GLOBAL is
+   true if the symbol may be affected by dynamic relocations.  */
+#undef	ASM_PREFERRED_EH_DATA_FORMAT
+#define	ASM_PREFERRED_EH_DATA_FORMAT(CODE, GLOBAL) \
+  (TARGET_64BIT || flag_pic						\
+   ? (((GLOBAL) ? DW_EH_PE_indirect : 0) | DW_EH_PE_pcrel		\
+      | (TARGET_64BIT ? DW_EH_PE_udata8 : DW_EH_PE_sdata4))		\
+   : DW_EH_PE_absptr)
+
+/* Static stack checking is supported by means of probes.  */
+#define STACK_CHECK_STATIC_BUILTIN 1
+
+/* The default value isn't sufficient in 64-bit mode.  */
+#define STACK_CHECK_PROTECT (TARGET_64BIT ? 16 * 1024 : 12 * 1024)
+
+/* Use standard DWARF numbering for DWARF debugging information.  */
+#define RS6000_USE_DWARF_NUMBERING
+
+/* The unwinder covers the Xenon VMX128 registers v32-v127 (plan 4.3):
+   their .eh_frame numbers are 120-215 (rs6000_debugger_regno), after the
+   DMRs (112-119), so 216 columns.  v64-v127 are callee-saved and the
+   prologue describes their saves in the CFI, so the unwinder must restore
+   them when it installs a landing pad.  _Unwind_Context and
+   _Unwind_FrameState in libgcc grow accordingly (they are private to
+   libgcc's unwinder), and rs6000_init_dwarf_reg_sizes_extra gives the
+   new columns their 16-byte size.  .debug_frame (rarely used: GCC emits
+   .cfi directives, which put the .eh_frame numbers in both) has 1156-1251
+   for v32-v127.  */
+#undef  DWARF_FRAME_REGISTERS
+#define DWARF_FRAME_REGISTERS 216
+
+/* PowerPC64 word-aligns FP doubles when -malign-power is given.  */
+#undef  ADJUST_FIELD_ALIGN
+#define ADJUST_FIELD_ALIGN(FIELD, TYPE, COMPUTED) \
+  ((TARGET_64BIT							\
+    && TARGET_ALIGN_NATURAL == 0					\
+    && TYPE_MODE (strip_array_types (TYPE)) == DFmode)			\
+   ? MIN ((COMPUTED), 32)						\
+   : (COMPUTED))
+
+#undef  TOC_SECTION_ASM_OP
+#define TOC_SECTION_ASM_OP \
+  (TARGET_64BIT                                         \
+   ? "\t.section\t\".toc\",\"aw\""                      \
+   : "\t.section\t\".got\",\"aw\"")
+
+#undef  MINIMAL_TOC_SECTION_ASM_OP
+#define MINIMAL_TOC_SECTION_ASM_OP \
+  (TARGET_64BIT                                         \
+   ? "\t.section\t\".toc1\",\"aw\""                     \
+   : (flag_pic						\
+      ? "\t.section\t\".got2\",\"aw\""                  \
+      : "\t.section\t\".got1\",\"aw\""))
+
+/* This is how to declare the size of a function.  */
+#undef  ASM_DECLARE_FUNCTION_SIZE
+#define ASM_DECLARE_FUNCTION_SIZE(FILE, FNAME, DECL)                    \
+  do                                                                    \
+    {                                                                   \
+      if (!flag_inhibit_size_directive)                                 \
+        {                                                               \
+          fputs ("\t.size\t", (FILE));                                  \
+          if (TARGET_64BIT && DOT_SYMBOLS)                              \
+            putc ('.', (FILE));                                         \
+          assemble_name ((FILE), (FNAME));                              \
+          fputs (",.-", (FILE));                                        \
+          rs6000_output_function_entry (FILE, FNAME);                   \
+          putc ('\n', (FILE));                                          \
+        }                                                               \
+    }                                                                   \
+  while (0)
+
+/* Return nonzero if this entry is to be written into the constant
+   pool in a special way.  We do so if this is a SYMBOL_REF, LABEL_REF
+   or a CONST containing one of them.  If -mfp-in-toc (the default),
+   we also do this for floating-point constants.  We actually can only
+   do this if the FP formats of the target and host machines are the
+   same, but we can't check that since not every file that uses these
+   target macros includes real.h.  We also do this when we can write the
+   entry into the TOC and the entry is not larger than a TOC entry.
+   With the medium model, integer constants are materialised outside the
+   TOC (as in linux64.h).  */
+#undef  ASM_OUTPUT_SPECIAL_POOL_ENTRY_P
+#define ASM_OUTPUT_SPECIAL_POOL_ENTRY_P(X, MODE)			\
+  (TARGET_TOC								\
+   && (SYMBOL_REF_P (X)							\
+       || (GET_CODE (X) == CONST && GET_CODE (XEXP (X, 0)) == PLUS	\
+	   && SYMBOL_REF_P (XEXP (XEXP (X, 0), 0)))			\
+       || GET_CODE (X) == LABEL_REF					\
+       || (CONST_INT_P (X)						\
+	   && TARGET_CMODEL != CMODEL_MEDIUM				\
+	   && GET_MODE_BITSIZE (MODE) <= GET_MODE_BITSIZE (Pmode))	\
+       || (CONST_DOUBLE_P (X)						\
+	   && ((TARGET_64BIT						\
+		&& (TARGET_MINIMAL_TOC					\
+		    || (SCALAR_FLOAT_MODE_P (GET_MODE (X))		\
+			&& ! TARGET_NO_FP_IN_TOC)))			\
+	       || (!TARGET_64BIT					\
+		   && !TARGET_NO_FP_IN_TOC				\
+		   && SCALAR_FLOAT_MODE_P (GET_MODE (X))		\
+		   && BITS_PER_WORD == HOST_BITS_PER_INT)))))
diff --git gcc-16.2.0/gcc/config/rs6000/xenon_vmx.h gcc/gcc/config/rs6000/xenon_vmx.h
new file mode 100644
index 000000000..6e4ecf095
--- /dev/null
+++ gcc/gcc/config/rs6000/xenon_vmx.h
@@ -0,0 +1,186 @@
+/* Xbox 360 Xenon VMX128 intrinsics.
+   Copyright (C) 2026 Free Software Foundation, Inc.
+
+   This file is part of GCC.
+
+   GCC is free software; you can redistribute it and/or modify it
+   under the terms of the GNU General Public License as published
+   by the Free Software Foundation; either version 3, or (at your
+   option) any later version.
+
+   GCC is distributed in the hope that it will be useful, but WITHOUT
+   ANY WARRANTY; without even the implied warranty of MERCHANTABILITY
+   or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public
+   License for more details.
+
+   Under Section 7 of GPL version 3, you are granted additional
+   permissions described in the GCC Runtime Library Exception, version
+   3.1, as published by the Free Software Foundation.
+
+   You should have received a copy of the GNU General Public License and
+   a copy of the GCC Runtime Library Exception along with this program;
+   see the files COPYING3 and COPYING.RUNTIME respectively.  If not, see
+   <http://www.gnu.org/licenses/>.  */
+
+/* A thin layer over the __builtin_xenon_* functions, which expose the
+   VMX128 instructions that have no AltiVec equivalent (see "Xbox 360 Xenon
+   VMX128 Built-in Functions" in the GCC manual).  Each function or macro
+   below emits exactly one instruction.  Word 0 (x) is the leftmost
+   (lowest-addressed) element of a vector, as everywhere on this big-endian
+   target.
+
+     xenon_vmsum3fp (a, b)        vmsum3fp128: every word of the result is
+                                  a.x*b.x + a.y*b.y + a.z*b.z
+     xenon_vmsum4fp (a, b)        vmsum4fp128: every word is
+                                  a.x*b.x + a.y*b.y + a.z*b.z + a.w*b.w
+          These two are NOT IEEE operations: the products are exact but are
+          truncated to a common accumulator, the sum is a one's-complement
+          sum and the result is truncated to 24 bits, so its magnitude can
+          be an ulp or so below the correctly rounded dot product (more
+          when the products cancel); a NaN, inf*0 or inf-inf gives the
+          default NaN 0x7FC00000 and an overflow a NaN, never an infinity.
+     xenon_vmaddcfp (a, d, b)     vmaddcfp128: a*d + b, fused (one
+                                  round-to-nearest-even rounding); d lives
+                                  in the destination register
+     xenon_vmulfp (a, b)          vmulfp128: a*b, rounded
+     xenon_vrlimi (d, b, mask, rot)
+                                  vrlimi128: word i of the result is word
+                                  (i + rot) & 3 of b if bit (3 - i) of mask
+                                  is set (XENON_MASK_X = word 0 ...
+                                  XENON_MASK_W = word 3), else word i of d
+     xenon_vpermwi (b, perm)      vpermwi128: word i of the result is word
+                                  (perm >> (6 - 2*i)) & 3 of b
+     xenon_vswizzle (b, x, y, z, w)
+                                  vpermwi128 with XENON_PERMWI (x, y, z, w):
+                                  the result is { b[x], b[y], b[z], b[w] }
+     xenon_vpkd3d (d, b, type, pack, slot)
+                                  vpkd3d128: packs the floats of b as D3D
+                                  type TYPE (XENON_D3D_*) with pack size
+                                  PACK (XENON_PACK_*) and merges the result
+                                  into d (d is the destination register).
+                                  SLOT is the instruction's VD3D2 field
+                                  (0-3), which selects where in d the result
+                                  goes.  Which word that is, which way the
+                                  slots count, and where the two words of a
+                                  64-bit result (PACK 2 and 3) go are NOT
+                                  verified on hardware (the hardware
+                                  findings leave several (type, pack) pairs
+                                  open); the host models assume word SLOT
+                                  counted from the left (x) for PACK 1.
+                                  tools/xts-probes settles it on a console.
+                                  Sets VSCR[SAT] when a value is clamped.
+     xenon_vupkd3d (b, type)      vupkd3d128: unpacks b as D3D type TYPE
+                                  into four floats.
+
+   The integer D3D formats are "floats biased by 3.0": the integer code of
+   a lane is its float bit pattern minus 0x40400000 (FINDINGS 1.3), both
+   for the input of a pack and the output of an unpack.  FLOAT16 is the
+   Xenos half format (it saturates instead of producing inf or NaN).
+
+   MASK, ROT, PERM, TYPE, PACK and SLOT must be integer constant
+   expressions (the instruction encodes them); the compiler checks their
+   ranges: mask 0-15, rot 0-3, perm 0-255, type 0-6, pack 1-3, slot 0-3.
+   d and b of xenon_vrlimi, b of xenon_vpermwi and d of xenon_vpkd3d may be
+   vector float, vector signed int or vector unsigned int (xenon_vrlimi and
+   xenon_vpermwi also vector bool int; the result has the type of d or b);
+   b of xenon_vupkd3d may be any non-bool 128-bit vector type.
+
+   The functions need code compiled for Xenon with AltiVec and VMX128
+   (-mcpu=xenon, where -mvmx128 is the default; __VMX128__ is then
+   defined).  A unit compiled for another CPU can include the header too,
+   for functions marked __attribute__ ((target ("cpu=xenon"))) or compiled
+   under #pragma GCC target ("cpu=xenon"), as with the x86 intrinsic
+   headers: the definitions below are then compiled for Xenon, and using
+   one in a function not compiled for Xenon is an error (inlining fails on
+   the target mismatch).  */
+
+#ifndef _XENON_VMX_H
+#define _XENON_VMX_H 1
+
+#if !defined (__VMX128__)
+#if !defined (__has_builtin)
+#error "xenon_vmx.h needs a compiler with the Xenon VMX128 built-in functions (GCC with -mcpu=xenon)"
+#elif !__has_builtin (__builtin_xenon_vmsum4fp)
+#error "xenon_vmx.h needs a compiler with the Xenon VMX128 built-in functions (GCC with -mcpu=xenon)"
+#endif
+#pragma GCC push_options
+#pragma GCC target ("cpu=xenon,altivec,vmx128")
+#define __XENON_VMX_H_TARGET_PUSHED 1
+#endif
+
+/* D3D data types (the TYPE operand of xenon_vpkd3d and xenon_vupkd3d,
+   VD3D0 / UIMM >> 2 of the instructions).  */
+#define XENON_D3D_D3DCOLOR	0	/* 4 x 8-bit unsigned normalized  */
+#define XENON_D3D_NORMSHORT2	1	/* 2 x 16-bit signed normalized  */
+#define XENON_D3D_NORMPACKED32	2	/* 2_10_10_10  */
+#define XENON_D3D_FLOAT16_2	3	/* 2 x Xenos half  */
+#define XENON_D3D_NORMSHORT4	4	/* 4 x 16-bit signed normalized  */
+#define XENON_D3D_FLOAT16_4	5	/* 4 x Xenos half  */
+#define XENON_D3D_NORMPACKED64	6	/* 4_20_20_20  */
+
+/* Pack sizes (the PACK operand of xenon_vpkd3d, VD3D1): a 32-bit result,
+   or one of the two halves of a 64-bit result.  */
+#define XENON_PACK_32		1
+#define XENON_PACK_64LO		2
+#define XENON_PACK_64HI		3
+
+/* Lane masks for xenon_vrlimi.  */
+#define XENON_MASK_X		8
+#define XENON_MASK_Y		4
+#define XENON_MASK_Z		2
+#define XENON_MASK_W		1
+#define XENON_MASK_XYZW		15
+
+/* The vpermwi128 immediate that selects words X, Y, Z, W (each 0-3) of the
+   source for result words 0-3.  XENON_PERMWI (0, 1, 2, 3) is the
+   identity.  */
+#define XENON_PERMWI(x, y, z, w) \
+  ((((x) & 3) << 6) | (((y) & 3) << 4) | (((z) & 3) << 2) | ((w) & 3))
+
+static __inline__ __vector float
+__attribute__ ((__always_inline__, __artificial__))
+xenon_vmsum3fp (__vector float __a, __vector float __b)
+{
+  return __builtin_xenon_vmsum3fp (__a, __b);
+}
+
+static __inline__ __vector float
+__attribute__ ((__always_inline__, __artificial__))
+xenon_vmsum4fp (__vector float __a, __vector float __b)
+{
+  return __builtin_xenon_vmsum4fp (__a, __b);
+}
+
+static __inline__ __vector float
+__attribute__ ((__always_inline__, __artificial__))
+xenon_vmaddcfp (__vector float __a, __vector float __d, __vector float __b)
+{
+  return __builtin_xenon_vmaddcfp (__a, __d, __b);
+}
+
+static __inline__ __vector float
+__attribute__ ((__always_inline__, __artificial__))
+xenon_vmulfp (__vector float __a, __vector float __b)
+{
+  return __builtin_xenon_vmulfp (__a, __b);
+}
+
+/* The operations with immediates are macros, so that the immediates stay
+   constant expressions at every optimization level.  */
+#define xenon_vrlimi(d, b, mask, rot) \
+  __builtin_xenon_vrlimi ((d), (b), (mask), (rot))
+#define xenon_vpermwi(b, perm) \
+  __builtin_xenon_vpermwi ((b), (perm))
+#define xenon_vswizzle(b, x, y, z, w) \
+  __builtin_xenon_vpermwi ((b), XENON_PERMWI (x, y, z, w))
+#define xenon_vpkd3d(d, b, type, pack, slot) \
+  __builtin_xenon_vpkd3d ((d), (b), (type), (pack), (slot))
+#define xenon_vupkd3d(b, type) \
+  __builtin_xenon_vupkd3d ((b), (type))
+
+#ifdef __XENON_VMX_H_TARGET_PUSHED
+#undef __XENON_VMX_H_TARGET_PUSHED
+#pragma GCC pop_options
+#endif
+
+#endif /* _XENON_VMX_H */
