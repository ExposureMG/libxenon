+OP1 (trunc_f, vf, vf, vec_trunc (a))
+
+OP1 (ctf_s, vf, vsi, vec_ctf (a, 3))
+OP1 (ctf_u, vf, vui, vec_ctf (a, 31))
+OP1 (cts_f, vsi, vf, vec_cts (a, 5))
+OP1 (ctu_f, vui, vf, vec_ctu (a, 0))
+
+OP2 (cmpeq_f, vbi, vf, vf, vec_cmpeq (a, b))
