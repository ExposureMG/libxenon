+vui f2 (vui b) { return __builtin_xenon_vpermwi (b, 1); }	/* { dg-error "'__builtin_xenon_vpermwi_v4si' requires the '-mcpu=xenon' option" } */
+vf f3 (vf d, vf b) { return __builtin_xenon_vpkd3d (d, b, 0, 1, 0); }	/* { dg-error "'__builtin_xenon_vpkd3d_v4sf' requires the '-mcpu=xenon' option" } */
+vf f4 (vui b) { return __builtin_xenon_vupkd3d (b, 0); }	/* { dg-error "'__builtin_xenon_vupkd3d_v4si' requires the '-mcpu=xenon' option" } */
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-builtins-6.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtins-6.c
new file mode 100644
index 000000000..d195b5499
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtins-6.c
@@ -0,0 +1,15 @@
+/* Xenon VMX128-only builtins (step 7) need -mvmx128 (-mcpu=xenon): the
+   direct builtins on another AltiVec CPU are expansion-time errors naming
+   the option.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=cell" } */
+
+typedef __vector float vf;
+typedef __vector signed int vsi;
+
+vf f1 (vf a, vf b) { return __builtin_xenon_vmsum3fp (a, b); }	/* { dg-error "'__builtin_xenon_vmsum3fp' requires the '-mcpu=xenon' option" } */
+vf f2 (vf a, vf b) { return __builtin_xenon_vmsum4fp (a, b); }	/* { dg-error "'__builtin_xenon_vmsum4fp' requires the '-mcpu=xenon' option" } */
+vf f3 (vf a, vf d, vf b) { return __builtin_xenon_vmaddcfp (a, d, b); }	/* { dg-error "'__builtin_xenon_vmaddcfp' requires the '-mcpu=xenon' option" } */
+vf f4 (vf a, vf b) { return __builtin_xenon_vmulfp (a, b); }	/* { dg-error "'__builtin_xenon_vmulfp' requires the '-mcpu=xenon' option" } */
+vsi f5 (vsi d, vsi b) { return __builtin_xenon_vrlimi_v4si (d, b, 1, 1); }	/* { dg-error "'__builtin_xenon_vrlimi_v4si' requires the '-mcpu=xenon' option" } */
+vf f6 (vf b) { return __builtin_xenon_vpermwi_v4sf (b, 1); }	/* { dg-error "'__builtin_xenon_vpermwi_v4sf' requires the '-mcpu=xenon' option" } */
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-builtins-7.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtins-7.c
new file mode 100644
index 000000000..a119f9eae
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtins-7.c
@@ -0,0 +1,10 @@
+/* Xenon VMX128-only builtins (step 7): with -mcpu=xenon -mno-vmx128 they
+   are errors naming -mvmx128 (expansion-time errors).  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon -mno-vmx128" } */
+
+typedef __vector float vf;
+
+vf f1 (vf a, vf b) { return __builtin_xenon_vmsum3fp (a, b); }	/* { dg-error "'__builtin_xenon_vmsum3fp' requires the '-mvmx128' option" } */
+vf f2 (vf a, vf d, vf b) { return __builtin_xenon_vmaddcfp (a, d, b); }	/* { dg-error "'__builtin_xenon_vmaddcfp' requires the '-mvmx128' option" } */
+vf f3 (vf d, vf b) { return __builtin_xenon_vpkd3d_v4sf (d, b, 0, 1, 0); }	/* { dg-error "'__builtin_xenon_vpkd3d_v4sf' requires the '-mvmx128' option" } */
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-builtins-8.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtins-8.c
new file mode 100644
index 000000000..25ce8b0f1
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtins-8.c
@@ -0,0 +1,9 @@
+/* Xenon VMX128-only builtins (step 7): with -mcpu=xenon -mno-vmx128 the
+   overloaded names are front-end errors naming -mvmx128.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon -mno-vmx128" } */
+
+typedef __vector float vf;
+
+vf f1 (vf d, vf b) { return __builtin_xenon_vrlimi (d, b, 1, 1); }	/* { dg-error "'__builtin_xenon_vrlimi_v4sf' requires the '-mvmx128' option" } */
+vf f2 (vf b) { return __builtin_xenon_vupkd3d (b, 1); }	/* { dg-error "'__builtin_xenon_vupkd3d_v4si' requires the '-mvmx128' option" } */
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-builtins-9.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtins-9.c
new file mode 100644
index 000000000..0116ed792
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-builtins-9.c
@@ -0,0 +1,42 @@
+/* Xenon VMX128-only builtins (step 7): <xenon_vmx.h> compiles cleanly
+   with -Wall -Wextra -pedantic (C99) and each wrapper emits exactly its
+   instruction.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon -std=c99 -Wall -Wextra -pedantic" } */
+
+/* { dg-final { scan-assembler-times {\mvmsum3fp128 } 1 } } */
+/* { dg-final { scan-assembler-times {\mvmsum4fp128 } 1 } } */
+/* { dg-final { scan-assembler-times {\mvmaddcfp128 } 1 } } */
+/* { dg-final { scan-assembler-times {\mvmulfp128 } 1 } } */
+/* { dg-final { scan-assembler {\mvrlimi128 [0-9]+,[0-9]+,9,2$} } } */
+/* { dg-final { scan-assembler {\mvpermwi128 [0-9]+,[0-9]+,228$} } } */
+/* { dg-final { scan-assembler {\mvpermwi128 [0-9]+,[0-9]+,83$} } } */
+/* { dg-final { scan-assembler {\mvpkd3d128 [0-9]+,[0-9]+,5,2,0$} } } */
+/* { dg-final { scan-assembler {\mvpkd3d128 [0-9]+,[0-9]+,0,1,3$} } } */
+/* { dg-final { scan-assembler {\mvupkd3d128 [0-9]+,[0-9]+,24$} } } */
+/* { dg-final { scan-assembler {\mvupkd3d128 [0-9]+,[0-9]+,12$} } } */
+
+#include <xenon_vmx.h>
+
+#if !defined (__VMX128__) || XENON_D3D_NORMPACKED64 != 6 || XENON_PERMWI (0, 1, 2, 3) != 0x1B
+#error "xenon_vmx.h macros"
+#endif
+
+typedef __vector float vf;
+typedef __vector unsigned int vui;
+
+void
+use_all (vf *o, const vf *a, const vui *u)
+{
+  o[0] = xenon_vmsum3fp (a[0], a[1]);
+  o[1] = xenon_vmsum4fp (a[0], a[1]);
+  o[2] = xenon_vmaddcfp (a[0], a[1], a[2]);
+  o[3] = xenon_vmulfp (a[0], a[2]);
+  o[4] = xenon_vrlimi (a[1], a[2], XENON_MASK_X | XENON_MASK_W, 2);
+  o[5] = xenon_vpermwi (a[0], XENON_PERMWI (3, 2, 1, 0));
+  o[6] = xenon_vswizzle (a[1], 1, 1, 0, 3);
+  o[7] = xenon_vpkd3d (a[2], a[0], XENON_D3D_FLOAT16_4, XENON_PACK_64LO, 0);
+  o[8] = xenon_vpkd3d (a[2], a[0], XENON_D3D_D3DCOLOR, XENON_PACK_32, 3);
+  o[9] = xenon_vupkd3d (u[0], XENON_D3D_NORMPACKED64);
+  o[10] = xenon_vupkd3d (u[1], XENON_D3D_FLOAT16_2);
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-cell-ldst.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-cell-ldst.c
new file mode 100644
index 000000000..031fdd7f5
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-cell-ldst.c
@@ -0,0 +1,26 @@
+/* Xenon has the Cell vector load/store left/right instructions; the Cell
+   intrinsics are available under -mcpu=xenon (TARGET_CELL_VEC_LDST).  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -maltivec -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler-times {\mlvlx\M} 1 } } */
+/* { dg-final { scan-assembler-times {\mlvlxl\M} 1 } } */
+/* { dg-final { scan-assembler-times {\mlvrx\M} 1 } } */
+/* { dg-final { scan-assembler-times {\mlvrxl\M} 1 } } */
+/* { dg-final { scan-assembler-times {\mstvlx\M} 1 } } */
+/* { dg-final { scan-assembler-times {\mstvlxl\M} 1 } } */
+/* { dg-final { scan-assembler-times {\mstvrx\M} 1 } } */
+/* { dg-final { scan-assembler-times {\mstvrxl\M} 1 } } */
+
+#include <altivec.h>
+
+typedef __vector unsigned char vuc;
+typedef __vector float vf;
+
+vuc l1 (long a, unsigned char *p) { return vec_lvlx (a, p); }
+vuc l2 (long a, unsigned char *p) { return vec_lvlxl (a, p); }
+vf l3 (long a, float *p) { return vec_lvrx (a, p); }
+vf l4 (long a, float *p) { return vec_lvrxl (a, p); }
+void s1 (vuc v, long a, unsigned char *p) { vec_stvlx (v, a, p); }
+void s2 (vuc v, long a, unsigned char *p) { vec_stvlxl (v, a, p); }
+void s3 (vf v, long a, float *p) { vec_stvrx (v, a, p); }
+void s4 (vf v, long a, float *p) { vec_stvrxl (v, a, p); }
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-condmove.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-condmove.c
new file mode 100644
index 000000000..ed0334cca
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-condmove.c
@@ -0,0 +1,13 @@
+/* Xenon has no isel: conditional moves of integers use branches or
+   arithmetic.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler-not {\misel\M} } } */
+/* { dg-final { scan-assembler-not {\msetb\M} } } */
+/* { dg-final { scan-assembler-not {\mmaddld\M} } } */
+
+int sel (int a, int b, int c) { return a < b ? c : a; }
+long sell (long a, long b, long c, long d) { return a == b ? c : d; }
+unsigned selu (unsigned a, unsigned b) { return a > b ? a : b; }
+int mn (int a, int b) { return a < b ? a : b; }
+long cmp3 (long a, long b) { return (a > b) - (a < b); }
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-flags-1.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-flags-1.c
new file mode 100644
index 000000000..dd08e269c
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-flags-1.c
@@ -0,0 +1,11 @@
+/* Explicit ISA options for instructions the Xenon PPE lacks are errors
+   under -mcpu=xenon.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -mdejagnu-cpu=xenon -mpopcntb -misel -mvsx -mcmpb -mfprnd" } */
+/* { dg-error "'-mpopcntb' is not supported by '-mcpu=xenon'" "" { target *-*-* } 0 } */
+/* { dg-error "'-misel' is not supported by '-mcpu=xenon'" "" { target *-*-* } 0 } */
+/* { dg-error "'-mvsx' is not supported by '-mcpu=xenon'" "" { target *-*-* } 0 } */
+/* { dg-error "'-mcmpb' is not supported by '-mcpu=xenon'" "" { target *-*-* } 0 } */
+/* { dg-error "'-mfprnd' is not supported by '-mcpu=xenon'" "" { target *-*-* } 0 } */
+
+int f (unsigned int x) { return __builtin_popcount (x); }
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-flags-2.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-flags-2.c
new file mode 100644
index 000000000..c4cd6385b
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-flags-2.c
@@ -0,0 +1,10 @@
+/* A target attribute for another cpu in a -mcpu=xenon unit gets that cpu's
+   ISA (xenon-flags-4.c: asking for an extension Xenon lacks in a -mcpu=xenon
+   function is an error; that test is separate because a compile that fails
+   writes no assembly to scan).  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler {\mpopcntd\M} } } */
+
+__attribute__ ((target ("cpu=power7")))
+int f2 (unsigned long x) { return __builtin_popcountl (x); }
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-flags-3.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-flags-3.c
new file mode 100644
index 000000000..01505c107
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-flags-3.c
@@ -0,0 +1,10 @@
+/* -mrecip-precision tells GCC that fres/frsqrte give at least 14 bits, so
+   the -mrecip Newton-Raphson sequences take fewer steps.  The Xenon PPE's
+   fres keeps 8 bits and frsqrte 9 (isa/FINDINGS.md 1.2), so an explicit
+   request is an error under -mcpu=xenon instead of silently inaccurate
+   results.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-Ofast -mrecip=all -mrecip-precision -mdejagnu-cpu=xenon" } */
+/* { dg-error "'-mrecip-precision' is not supported by '-mcpu=xenon'" "" { target *-*-* } 0 } */
+
+float rf (float a, float b) { return a / b; }
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-flags-4.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-flags-4.c
new file mode 100644
index 000000000..ea88f2c06
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-flags-4.c
@@ -0,0 +1,11 @@
+/* A target attribute asking for an ISA extension Xenon lacks is an error
+   in a -mcpu=xenon function (xenon-flags-2.c: another cpu's function in the
+   same kind of unit gets that cpu's ISA).  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -mdejagnu-cpu=xenon" } */
+
+__attribute__ ((target ("popcntd")))
+int f1 (unsigned long x) { return __builtin_popcountl (x); }	/* { dg-error "'-mpopcntd' is not supported by '-mcpu=xenon'" } */
+
+__attribute__ ((target ("cpu=power7")))
+int f2 (unsigned long x) { return __builtin_popcountl (x); }
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-fsel.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-fsel.c
new file mode 100644
index 000000000..3fc0a9e73
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-fsel.c
@@ -0,0 +1,12 @@
+/* Xenon has fsel (it is in the allow-list, PPC_GFXOPT): with -ffast-math
+   floating-point selects use it; integer selects never use isel.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -ffast-math -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler {\mfsel\M} } } */
+/* { dg-final { scan-assembler-not {\misel\M} } } */
+/* { dg-final { scan-assembler-not {\mx[sv][a-z]+} } } */
+
+double seld (double a, double b, double c) { return a >= 0 ? b : c; }
+float self (float a, float b, float c) { return a >= 0 ? b : c; }
+double maxd (double a, double b) { return a > b ? a : b; }
+int seli (int a, int b, int c) { return a >= 0 ? b : c; }
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-ldbrx.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-ldbrx.c
new file mode 100644
index 000000000..37e1f0451
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-ldbrx.c
@@ -0,0 +1,14 @@
+/* Xenon executes ldbrx and stdbrx (TARGET_LDBRX).  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler {\mldbrx\M} } } */
+/* { dg-final { scan-assembler {\mstdbrx\M} } } */
+/* { dg-final { scan-assembler {\mlwbrx\M} } } */
+/* { dg-final { scan-assembler {\mstwbrx\M} } } */
+/* { dg-final { scan-assembler {\mlhbrx\M} } } */
+
+unsigned long ld64 (unsigned long *p) { return __builtin_bswap64 (*p); }
+void st64 (unsigned long *p, unsigned long v) { *p = __builtin_bswap64 (v); }
+unsigned int ld32 (unsigned int *p) { return __builtin_bswap32 (*p); }
+void st32 (unsigned int *p, unsigned int v) { *p = __builtin_bswap32 (v); }
+unsigned short ld16 (unsigned short *p) { return __builtin_bswap16 (*p); }
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-macros-1.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-macros-1.c
new file mode 100644
index 000000000..e776f9e03
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-macros-1.c
@@ -0,0 +1,56 @@
+/* _ARCH_XENON and __VMX128__ follow the cpu of "#pragma GCC target", also
+   when the ISA flags do not change (cell <-> xenon) and when the cpu
+   changes back with pop_options.  Unit compiled for -mcpu=xenon.  */
+/* { dg-do preprocess { target powerpc*-*-* } } */
+/* { dg-options "-mdejagnu-cpu=xenon" } */
+
+#if !defined (_ARCH_XENON) || !defined (__VMX128__)
+#error xenon macros missing at the start
+#endif
+
+#pragma GCC push_options
+#pragma GCC target ("cpu=power7")
+#ifdef _ARCH_XENON
+#error _ARCH_XENON inside cpu=power7
+#endif
+#ifdef __VMX128__
+#error __VMX128__ inside cpu=power7
+#endif
+#pragma GCC pop_options
+
+#if !defined (_ARCH_XENON) || !defined (__VMX128__)
+#error xenon macros lost after pop_options
+#endif
+
+#pragma GCC push_options
+#pragma GCC target ("cpu=cell")
+#ifdef _ARCH_XENON
+#error _ARCH_XENON inside cpu=cell
+#endif
+#ifndef __PPU__
+#error __PPU__ missing inside cpu=cell
+#endif
+#pragma GCC pop_options
+
+#ifdef __PPU__
+#error __PPU__ leaks after pop_options
+#endif
+#if !defined (_ARCH_XENON) || !defined (__VMX128__)
+#error xenon macros lost after the second pop_options
+#endif
+
+#pragma GCC push_options
+#pragma GCC target ("no-altivec")
+#ifdef __VMX128__
+#error __VMX128__ without AltiVec
+#endif
+#ifndef _ARCH_XENON
+#error _ARCH_XENON lost with no-altivec
+#endif
+#pragma GCC pop_options
+
+#ifndef __VMX128__
+#error __VMX128__ lost after no-altivec pop
+#endif
+
+int x;
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-macros-2.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-macros-2.c
new file mode 100644
index 000000000..2228246fd
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-macros-2.c
@@ -0,0 +1,29 @@
+/* _ARCH_XENON and __VMX128__ follow "#pragma GCC target ("cpu=xenon")" in
+   a unit compiled for another cpu: defined inside, undefined after
+   pop_options.  -mcpu=power7 changes ISA flags; see xenon-macros-3.c for
+   cell, where the ISA flags are the same as xenon's.  */
+/* { dg-do preprocess { target powerpc*-*-* } } */
+/* { dg-options "-mdejagnu-cpu=power7" } */
+
+#ifdef _ARCH_XENON
+#error _ARCH_XENON for -mcpu=power7
+#endif
+
+#pragma GCC push_options
+#pragma GCC target ("cpu=xenon")
+#ifndef _ARCH_XENON
+#error _ARCH_XENON missing inside cpu=xenon
+#endif
+#ifndef __VMX128__
+#error __VMX128__ missing inside cpu=xenon
+#endif
+#pragma GCC pop_options
+
+#ifdef _ARCH_XENON
+#error _ARCH_XENON leaks after pop_options
+#endif
+#ifdef __VMX128__
+#error __VMX128__ leaks after pop_options
+#endif
+
+int x;
