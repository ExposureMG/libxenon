+/* { dg-final { scan-rtl-dump {:slot01,fxu_cell} "sched2" } } */
+
+__attribute__ ((target ("cpu=xenon")))
+long xe (long x, long a, long b) { x += a; x ^= b; return x; }
+
+long ce (long x, long a, long b) { x += a; x ^= b; return x; }
