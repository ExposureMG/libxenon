+	  && xenon_feeds_vperm_control_p (dep_insn, insn))
+	return cost + XENON_BYP_LVX_VPERM_CTRL_EXTRA;
+      if (dep == TYPE_VECFLOAT || dep == TYPE_VECCOMPLEX)
+	return cost + XENON_BYP_VFP_CROSS_EXTRA;
+      break;
