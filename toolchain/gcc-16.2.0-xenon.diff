diff --git gcc-16.2.0/libgcc/config/rs6000/t-xenon64 gcc/libgcc/config/rs6000/t-xenon64
new file mode 100644
index 000000000..2fe26c37c
--- /dev/null
+++ gcc/libgcc/config/rs6000/t-xenon64
@@ -0,0 +1,43 @@
+# libgcc fragment for 64-bit PowerPC bare-metal ELF targets
+# (powerpc64-xenon-elf, powerpc64-*-elf).
+#
+# Copyright (C) 2026 Free Software Foundation, Inc.
+#
+# This file is part of GCC.
+#
+# GCC is free software; you can redistribute it and/or modify
+# it under the terms of the GNU General Public License as published by
+# the Free Software Foundation; either version 3, or (at your option)
+# any later version.
+#
+# GCC is distributed in the hope that it will be useful,
+# but WITHOUT ANY WARRANTY; without even the implied warranty of
+# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+# GNU General Public License for more details.
+#
+# You should have received a copy of the GNU General Public License
+# along with GCC; see the file COPYING3.  If not see
+# <http://www.gnu.org/licenses/>.
+
+# crti.o and crtn.o hold the prologue and epilogue of _init and _fini
+# (the .init/.fini sections), which newlib's __libc_init_array and
+# __libc_fini_array call.  The eabi-ci.S/sol-ci.S variants used by the
+# 32-bit ELF targets are empty for __powerpc64__, so this target has its
+# own, handling both the 64-bit ELFv1 ABI (descriptors in .opd) and the
+# 32-bit SysV ABI of the -m32 multilib.
+CUSTOM_CRTIN = yes
+
+crti$(objext): $(srcdir)/config/rs6000/xenon-crti.S
+	$(crt_compile) -c $<
+
+crtn$(objext): $(srcdir)/config/rs6000/xenon-crtn.S
+	$(crt_compile) -c $<
+
+# Out-of-line save and restore routines for the Xenon VMX128 callee-saved
+# vector registers v64-v127 (_savevr128_N, _restvr128_N; plan 4.3), called
+# by -mvmx128 prologues and epilogues.  They assemble with ".machine xenon",
+# so they are built whatever the default CPU is; nothing pulls them in
+# unless VMX128 code calls them.  (The 64-bit _savevr_N / _restvr_N for
+# v20-v31 come from the linker.)
+LIB2ADD_ST += $(srcdir)/config/rs6000/crtsavevr128.S \
+	      $(srcdir)/config/rs6000/crtrestvr128.S
diff --git gcc-16.2.0/libgcc/config/rs6000/t-xenon64-cpu gcc/libgcc/config/rs6000/t-xenon64-cpu
new file mode 100644
index 000000000..7642497d0
--- /dev/null
+++ gcc/libgcc/config/rs6000/t-xenon64-cpu
@@ -0,0 +1,27 @@
+# libgcc fragment for powerpc64-xenon-elf (the Xbox 360 Xenon PPE).
+#
+# Copyright (C) 2026 Free Software Foundation, Inc.
+#
+# This file is part of GCC.
+#
+# GCC is free software; you can redistribute it and/or modify
+# it under the terms of the GNU General Public License as published by
+# the Free Software Foundation; either version 3, or (at your option)
+# any later version.
+#
+# GCC is distributed in the hope that it will be useful,
+# but WITHOUT ANY WARRANTY; without even the implied warranty of
+# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+# GNU General Public License for more details.
+#
+# You should have received a copy of the GNU General Public License
+# along with GCC; see the file COPYING3.  If not see
+# <http://www.gnu.org/licenses/>.
+
+# Build libgcc, libgcov and the crt files for the Xenon PPE even when the
+# compiler was configured with a different --with-cpu default: code for
+# another CPU could contain instructions the PPE does not implement
+# (popcntb, the AltiVec integer multiplies, ...).  -mcpu=xenon already
+# implies AltiVec; -maltivec is spelled out to match the plan.
+HOST_LIBGCC2_CFLAGS += -mcpu=xenon -maltivec
+CRTSTUFF_T_CFLAGS += -mcpu=xenon -maltivec
diff --git gcc-16.2.0/libgcc/config/rs6000/xenon-crti.S gcc/libgcc/config/rs6000/xenon-crti.S
new file mode 100644
index 000000000..6a5ffdbfc
--- /dev/null
+++ gcc/libgcc/config/rs6000/xenon-crti.S
@@ -0,0 +1,118 @@
+/* crti.o for powerpc64-xenon-elf / powerpc64-*-elf (newlib, bare metal).
+
+   Copyright (C) 2026 Free Software Foundation, Inc.
+
+   This file is free software; you can redistribute it and/or modify it
+   under the terms of the GNU General Public License as published by the
+   Free Software Foundation; either version 3, or (at your option) any
+   later version.
+
+   This file is distributed in the hope that it will be useful, but
+   WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+   General Public License for more details.
+
+   Under Section 7 of GPL version 3, you are granted additional
+   permissions described in the GCC Runtime Library Exception, version
+   3.1, as published by the Free Software Foundation.
+
+   You should have received a copy of the GNU General Public License and
+   a copy of the GCC Runtime Library Exception along with this program;
+   see the files COPYING3 and COPYING.RUNTIME respectively.  If not, see
+   <http://www.gnu.org/licenses/>.  */
+
+/* Heads of _init and _fini.  Linked before every other object; crtn.o
+   supplies the matching tails.  Whatever objects put in .init/.fini in
+   between (calls of the form "bl func; nop") runs inside these frames.
+   newlib's __libc_init_array / __libc_fini_array call _init / _fini.
+
+   64-bit ELFv1: _init/_fini are function descriptors in .opd whose entry
+   points are the code at the start of .init/.fini.  The frame is the
+   minimum ELFv1 frame (48-byte header + 64-byte parameter save area);
+   the caller's LR save slot is 16 bytes above the incoming stack
+   pointer.  The TOC save slot (40(r1)) belongs to this frame, so the
+   linker can turn the nop after a call into "ld r2,40(r1)" when a
+   TOC-switching stub is needed.
+
+   64-bit ELFv2 (-mabi=elfv2, not a tested configuration): plain global
+   symbols at the start of .init/.fini; both are only called from code
+   sharing the caller's TOC in a static link, so there is no global
+   entry point.
+
+   32-bit (SysV ABI, the -m32 multilib): a 16-byte frame, LR
+   saved at 4 bytes above the incoming stack pointer.  */
+
+	.ident	"GNU C xenon-crti.S"
+
+#ifdef __powerpc64__
+# if defined (_CALL_ELF) && _CALL_ELF == 2
+	.abiversion 2
+
+	.section ".init","ax",@progbits
+	.align	2
+	.globl	_init
+	.type	_init,@function
+_init:
+	mflr	0
+	std	0,16(1)
+	stdu	1,-32(1)
+
+	.section ".fini","ax",@progbits
+	.align	2
+	.globl	_fini
+	.type	_fini,@function
+_fini:
+	mflr	0
+	std	0,16(1)
+	stdu	1,-32(1)
