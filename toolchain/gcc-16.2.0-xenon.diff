+/* { dg-options "-O2 -mdejagnu-cpu=xenon -fprefetch-loop-arrays -fdump-tree-aprefetch-details" } */
+/* { dg-final { scan-tree-dump {L1 cache size: 256 lines, 32 kB} "aprefetch" } } */
