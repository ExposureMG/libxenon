+void f (int *a, int n)
+{
+  for (int i = 0; i < n; i++)
+    a[i] = a[i] * 3 + i;
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-sched-loopalign-3.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-sched-loopalign-3.c
