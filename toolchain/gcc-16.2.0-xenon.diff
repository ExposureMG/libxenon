diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-sched-loopalign.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-sched-loopalign.c
new file mode 100644
index 000000000..49937f15b
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-sched-loopalign.c
@@ -0,0 +1,21 @@
+/* Xenon: a loop top runs 5-7 cycles per iteration faster at byte 4 or 12 of
+   its 16-byte fetch group than at 0 or 8 (FINDINGS 4, plan 5.3).  The loop
+   label gets an 8-byte aligned label and one nop in front of it.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler {\.p2align 3\n\.L[0-9]+:\n\tnop\n\.L[0-9]+:} } } */
+/* { dg-final { scan-assembler-not {\tnop\n\t} } } */
+
+int a[1000];
+
+void f (void)
+{
+  for (int i = 0; i < 1000; i++)
+    a[i] = a[i] * 3 + i;
+}
+
+void g (int *p, int n)
+{
+  for (int i = 0; i < n; i++)
+    p[i] = p[i] * 5 + i;
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-sched-mtocrf-2.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-sched-mtocrf-2.c
new file mode 100644
index 000000000..acf47b03b
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-sched-mtocrf-2.c
@@ -0,0 +1,15 @@
+/* -mtune other than Xenon keeps mtcrf in the epilogue.  */
+/* { dg-do compile { target { powerpc*-*-* && lp64 } } } */
+/* { dg-options "-O2 -mdejagnu-cpu=xenon -mdejagnu-tune=cell" } */
+/* { dg-final { scan-assembler {\tmtcrf\M} } } */
+/* { dg-final { scan-assembler-not {\tmtocrf\M} } } */
+
+extern void g (void);
+
+int
+f (int a, int b)
+{
+  __asm__ __volatile__ ("" ::: "cr2", "cr3", "cr4");
+  g ();
+  return a + b;
+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-sched-mtocrf.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-sched-mtocrf.c
new file mode 100644
index 000000000..ca8ff7fd4
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-sched-mtocrf.c
@@ -0,0 +1,17 @@
+/* Xenon: mtcrf costs 20 cycles even for one field, mtocrf 1 (FINDINGS 3.6);
+   the epilogue restores each saved CR field with its own mtocrf (plan 5.2).
+   mtocrf is never given several fields (Xenon then writes only one).  */
+/* { dg-do compile { target { powerpc*-*-* && lp64 } } } */
+/* { dg-options "-O2 -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler-times {\mmtocrf (32|16|8),} 3 } } */
+/* { dg-final { scan-assembler-not {\tmtcrf\M} } } */
+
+extern void g (void);
+
+int
+f (int a, int b)
+{
