+}
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-sched-recform.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-sched-recform.c
new file mode 100644
index 000000000..35914c5d9
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-sched-recform.c
@@ -0,0 +1,25 @@
+/* Xenon: record forms of logical/rotate/shift-imm/cntlz/exts ops and
+   andi./andis. are microcoded (14-16 cycles, plan 5.2/5.3), so combine must
+   keep the operation and a separate compare.  add-type record forms are not
+   microcoded (2 cycles) and are still formed.  */
+/* { dg-do compile { target { powerpc*-*-* && lp64 } } } */
+/* { dg-options "-O2 -mdejagnu-cpu=xenon -fdump-rtl-combine-details" } */
+/* { dg-final { scan-assembler-not {\m(and|andc|or|orc|xor|nor|nand|eqv|rlwinm|rlwnm|rlwimi|rldicl|rldicr|rldic|rldimi|rldcl|rldcr|srawi|sradi|srwi|slwi|srdi|sldi|clrlwi|clrldi|clrrwi|clrrdi|extlwi|extrwi|rotlwi|rotldi|extsb|extsh|extsw|cntlzw|cntlzd|slw|srw|sraw|sld|srd|srad)\.} } } */
+/* { dg-final { scan-assembler-not {\mandis?\.} } } */
+/* { dg-final { scan-assembler {\madd\.} } } */
+/* { dg-final { scan-assembler {\msubf\.} } } */
+/* { dg-final { scan-rtl-dump {rejecting combination} "combine" } } */
+
+int and_t (int a, int b) { int c = a & b; return c ? c : 5; }
+int orc_t (int a, int b) { int c = a | ~b; return c < 0 ? 1 : c; }
+int xor_t (int a, int b) { int c = a ^ b; return c > 0 ? c : -3; }
+unsigned srw_t (unsigned x) { unsigned y = x >> 3; return y ? y : 100; }
+long sld_t (long x) { long y = x << 7; return y ? y : 3; }
+int andi_t (int x) { return (x & 0x55) != 0 ? 2 : 3; }
+int bit_t (unsigned x) { return (x & 0x8000) ? 2 : 3; }
+long andis_t (long x, long *p) { long y = x & 0x50000; *p = y; return y ? 4 : 6; }
+long exts_t (int x) { long y = x; return y ? y : -1; }
+int clz_t (unsigned x) { int c = __builtin_clz (x | 1); return c ? c : 1; }
+extern void g (long);
+long add_t (long a, long b) { long c = a + b; if (c == 0) g (a); return c; }
+long subf_t (long a, long b) { long c = a - b; if (c > 0) g (c); return c; }
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-sched-strength-2.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-sched-strength-2.c
new file mode 100644
index 000000000..70a06fba6
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-sched-strength-2.c
@@ -0,0 +1,18 @@
+/* Xenon costs are in units of a 2-cycle add (ppcxenon_cost via
+   XENON_COSTS, as Cell's): divisions and remainders by constants use the
+   multiply-high sequence, never a 28-cycle divide, and a large 64-bit
+   multiplier uses mulld instead of a long serial shift/add chain.  */
+/* { dg-do compile { target { powerpc*-*-* && lp64 } } } */
+/* { dg-options "-O2 -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler-not {\mdiv[wd]u?\M} } } */
+/* { dg-final { scan-assembler {\mmulhw\M} } } */
+/* { dg-final { scan-assembler {\mmulhwu\M} } } */
+/* { dg-final { scan-assembler {\mmulld\M} } } */
+
+int rem19 (int x) { return x % 19; }
+int div19 (int x) { return x / 19; }
+unsigned udiv10 (unsigned x) { return x / 10; }
+int rem10 (int x) { return x % 10; }
+struct { unsigned int i : 6, j : 11, k : 15; } bf;
+void bfrem (void) { bf.i %= 19; }
+unsigned long lcg (unsigned long s) { return s * 0x41c64e6dUL + 12345; }
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-sched-strength.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-sched-strength.c
new file mode 100644
index 000000000..d1980bf2f
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-sched-strength.c
@@ -0,0 +1,20 @@
+/* Xenon: divw/divd cost 28 cycles of issue and mullw/mulld 11/13, mulli 7
+   (plan 5.3).  Division by a constant uses the multiply-high sequence and
+   multiplication by a small constant uses shifts and adds.  */
+/* { dg-do compile { target { powerpc*-*-* && lp64 } } } */
+/* { dg-options "-O2 -mdejagnu-cpu=xenon" } */
+/* { dg-final { scan-assembler-not {\mdiv[wd]u?\M} } } */
+/* { dg-final { scan-assembler-not {\mmulli\M} } } */
+/* { dg-final { scan-assembler-not {\mmull[wd]\M} } } */
+/* { dg-final { scan-assembler-not {\m(slw|srw|sraw|sld|srd|srad)\M} } } */
+/* { dg-final { scan-assembler {\mmulhw\M} } } */
+
+int div7 (int x) { return x / 7; }
+unsigned udiv10 (unsigned x) { return x / 10; }
+long ldiv3 (long x) { return x / 3; }
+int mod16 (int x) { return x % 16; }
+int div8 (int x) { return x / 8; }
+int mul10 (int x) { return x * 10; }
+long mul9 (long x) { return x * 9; }
+int mul5 (int x) { return x * 5; }
+int shl (int x) { int s = 5; return x << s; }
diff --git gcc-16.2.0/gcc/testsuite/gcc.target/powerpc/xenon-smt-1.c gcc/gcc/testsuite/gcc.target/powerpc/xenon-smt-1.c
new file mode 100644
index 000000000..3d81ad01f
--- /dev/null
+++ gcc/gcc/testsuite/gcc.target/powerpc/xenon-smt-1.c
@@ -0,0 +1,23 @@
+/* -mxenon-smt=busy (plan 5.4, FINDINGS 7): with a busy sibling thread the
+   Xenon threads alternate issue cycles, so every insn issues with a
+   xenon_smt1_issue* reservation (the sibling owns the next cycle), and the
+   integer ALU latency is 3 (2.02 -> 2.42 measured, rounded up) instead of 2:
+   the dependent chain issues at cycles 0, 3, 6, 9.  */
+/* { dg-do compile { target powerpc*-*-* } } */
+/* { dg-options "-O2 -mdejagnu-cpu=xenon -mxenon-smt=busy -fsched-verbose=2 -fdump-rtl-sched2" } */
+/* { dg-final { scan-rtl-dump {:\(xenon_smt1_issue\+xe_fxu\)} "sched2" } } */
+/* { dg-final { scan-rtl-dump-not {:\(xenon_issue} "sched2" } } */
+/* { dg-final { scan-rtl-dump {;;\s+0--> b\s+0: i\s+\d+ %3=%3\+%4 } "sched2" } } */
+/* { dg-final { scan-rtl-dump {;;\s+3--> b\s+0: i\s+\d+ %3=%3\^%5 } "sched2" } } */
+/* { dg-final { scan-rtl-dump {;;\s+6--> b\s+0: i\s+\d+ %3=%3\+%6 } "sched2" } } */
+/* { dg-final { scan-rtl-dump {;;\s+9--> b\s+0: i\s+\d+ %3=%3\|%7 } "sched2" } } */
+
+long
+chain (long x, long a, long b, long c, long d)
+{
