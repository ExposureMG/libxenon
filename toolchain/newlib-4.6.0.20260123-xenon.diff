@@ -900,6 +900,13 @@ case $basic_machine in
 		vendor=sde
 		basic_os=${basic_os:-elf}
 		;;
+	# Microsoft Xbox 360 (Xenon) PPE, bare metal.  "xenon" and "xenon-*"
